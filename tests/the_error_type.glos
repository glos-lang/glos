Foo :: enum error {
    A
    B
    C
}

Bar :: enum error {
    D
    E
    F
}

main :: () {
    // Typed errors
    {
        f: Foo
        println(f)

        println(Foo.A)
        println(Foo.B)
        println(Foo.C)

        f = null
        println(f)

        println(Bar.D)
        println(Bar.E)
        println(Bar.F)
    }

    // Untyped errors
    {
        a := error(null) // Explicit cast
        println(a)

        a = Foo.A // Auto cast
        println(a)

        a = Bar.D // Auto cast
        println(a)
    }
}
