Apply :: (x: s64, f: (_: s64)) {
    f(x)
}

Map :: (x: s64, f: (_: s64) -> s64) -> s64 {
    return f(x)
}

main :: () {
    foo := () { println(69) }
    foo()

    foo = () { println(420) }
    foo()

    Apply(2674, (x: s64) { println(x / 2) })
    println(Map(26695, (x: s64) -> s64 { return x * 3 }))
}
