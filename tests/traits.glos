Writer :: trait {
    write: (bytes: []u8)
}

greet :: (w: Writer) {
    w.write([]u8("Hello, world!\n"))
}

File :: distinct os.File

main :: () {
    greet(File(os.stdout))
}

write :: (this: File, bytes: []u8) {
    C.fwrite(rawptr(bytes.data), sizeof(u8), C.size_t(bytes.count), C.FILE(this))
}

C  :: #import "C"
os :: #import "os"
