Int :: distinct s64

@hash :: (this: Int, h: &Hasher) {
    println("Int.hash()")
    map.hash(s64(this), h)
}

Vec2 :: struct {
    x, y: s32
}

@hash :: (this: Vec2, h: &Hasher) {
    println("Vec2.hash()")
    map.hash(this.x, h)
    map.hash(this.y, h)
}

Vec3 :: struct($T: Type) {
    x, y, z: T
}

@hash :: (this: Vec3($T), h: &Hasher) {
    println("Vec3.hash()")
    map.hash(this.x, h)
    map.hash(this.y, h)
    map.hash(this.z, h)
}

main :: () {
    println(map.hash(Vec2 {69, 420}))
    println(map.hash(Vec3(s32) {69, 420, 1337}))
    println(map.hash([]Int {69, 420}))
}

#import "hash"
