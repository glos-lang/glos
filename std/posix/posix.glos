MAP_FAILED :: rawptr(-1)

PROT_READ  :: 0x1
PROT_WRITE :: 0x2

MAP_PRIVATE :: 0x02

#if PLATFORM == .MACOS {
    MAP_ANONYMOUS :: 0x1000

    SA_SIGINFO   :: 0x0040
    SA_ONSTACK   :: 0x0001
    SA_RESETHAND :: 0x0004
    SA_NODEFER   :: 0x0010

    SIGBUS :: 10

    tm :: struct {
        tm_sec:    C.int
        tm_min:    C.int
        tm_hour:   C.int
        tm_mday:   C.int
        tm_mon:    C.int
        tm_year:   C.int
        tm_wday:   C.int
        tm_yday:   C.int
        tm_isdst:  C.int
        tm_gmtoff: C.long
        tm_zone:   &u8
    }

    clockid_t :: enum C.unsigned_int {
        REALTIME             = 0
        MONOTONIC            = 6
        MONOTONIC_RAW        = 4
        MONOTONIC_RAW_APPROX = 5
        UPTIME_RAW           = 8
        UPTIME_RAW_APPROX    = 9
        PROCESS_CPUTIME_ID   = 12
        THREAD_CPUTIME_ID    = 16
    }

    stack_t :: struct {
        ss_sp:    rawptr
        ss_size:  C.size_t
        ss_flags: C.int
    }

    sigset_t :: C.unsigned_int

    siginfo_t :: struct {
        si_signo:  C.int
        si_errno:  C.int
        si_code:   C.int
        si_pid:    C.int
        si_uid:    C.unsigned_int
        si_status: C.int
        si_addr:   rawptr
        si_band:   C.long
        __pad:     [7]C.unsigned_long
    }

    sigaction_t :: struct {
        sa_sigaction: (sig: C.int, info: &siginfo_t, p: rawptr)
        sa_mask:  sigset_t
        sa_flags: C.unsigned_int
    }
} else {
    MAP_ANONYMOUS :: 0x20

    SA_SIGINFO   :: 0x00000004
    SA_ONSTACK   :: 0x08000000
    SA_RESETHAND :: 0x80000000
    SA_NODEFER   :: 0x40000000

    SIGBUS :: 7

    tm :: struct {
        tm_sec:    C.int
        tm_min:    C.int
        tm_hour:   C.int
        tm_mday:   C.int
        tm_mon:    C.int
        tm_year:   C.int
        tm_wday:   C.int
        tm_yday:   C.int
        tm_isdst:  C.int

        tm_gmtoff: C.long
        tm_zone:   &u8
    }

    clockid_t :: enum C.unsigned_int {
        REALTIME           = 0
        MONOTONIC          = 1
        PROCESS_CPUTIME_ID = 2
        THREAD_CPUTIME_ID  = 3
        MONOTONIC_RAW      = 4
        REALTIME_COARSE    = 5
        MONOTONIC_COARSE   = 6
        BOOTTIME           = 7
        REALTIME_ALARM     = 8
        BOOTTIME_ALARM     = 9
        TAI                = 11
    }

    stack_t :: struct {
        ss_sp: rawptr
        ss_flags: C.int
        ss_size: C.size_t
    }

    sigset_t :: struct {
        __val: [16]C.unsigned_long
    }

    siginfo_t :: struct {
        si_signo: C.int
        si_errno: C.int
        si_code: C.int
        __pad0: C.int
        si_addr: rawptr
    }

    sigaction_t :: struct {
        sa_sigaction: (sig: C.int, info: &siginfo_t, p: rawptr)
        sa_mask:  sigset_t
        sa_flags: C.unsigned_int
        sa_restorer: ()
    }

    extern {
        backtrace :: (buffer: &rawptr, size: C.int) -> C.int
        backtrace_symbols_fd :: (buffer: &rawptr, size: C.int, fd: C.int)

        sigaltstack :: (ss: &stack_t, oss: &stack_t) -> C.int
        sigemptyset :: (set: &sigset_t) -> C.int
        sigaction :: (signum: C.int, act: &sigaction_t, oldact: rawptr) -> C.int
    }
}

SIGQUIT ::  3
SIGILL  ::  4
SIGTRAP ::  5
SIGABRT ::  6
SIGFPE  ::  8
SIGSEGV :: 11

F_SETFD    :: 2
FD_CLOEXEC :: 1

STDIN_FILENO  :: 0
STDOUT_FILENO :: 1
STDERR_FILENO :: 2

timespec :: struct {
    tv_sec:  C.long
    tv_nsec: C.long
}

time_t :: C.long

extern {
    mkdir :: (pathname: &C.char, mode: C.unsigned_int) -> C.int
    rmdir :: (pathname: &C.char) -> C.int
    fileno :: (f: C.FILE) -> C.int
    lseek :: (fd: C.int, offset: C.long, whence: C.int) -> C.long
    open :: (path: &C.char, flags: C.int, mode: C.unsigned_int) -> C.int
    fdopen :: (fd: C.int, mode: &C.char) -> C.FILE

    mmap   :: (addr: rawptr, length: C.size_t, prot: C.int, flags: C.int, fd: C.int, offset: C.long) -> rawptr
    munmap :: (addr: rawptr, length: C.size_t) -> C.int

    read  :: (fd: C.int, buf: &C.char, count: C.size_t) -> C.ssize_t
    write :: (fd: C.int, buf: &C.char, count: C.size_t) -> C.ssize_t
    close :: (fd: C.int) -> C.int
    fcntl :: (fd: C.int, cmd: C.int, arg: C.int) -> C.int
    dup2  :: (oldfd: C.int, newfd: C.int) -> C.int

    fork    :: () -> C.int
    pipe    :: (pipefd: &[2]C.int) -> C.int
    execvp  :: (file: &C.char, argv: &&C.char) -> C.int
    waitpid :: (pid: C.int, wstatus: &C.int, options: C.int) -> C.int
    kill    :: (pid: C.int, sig: C.int) -> C.int

    getenv :: (name: &C.char) -> &C.char
    setenv :: (name: &C.char, value: &C.char, overwrite: C.int) -> C.int
    unsetenv :: (name: &C.char) -> C.int

    getcwd :: (buf: &C.char, size: C.size_t) -> &C.char
    chdir :: (path: &C.char) -> C.int

    clock_gettime :: (clockid: clockid_t, tp: &timespec) -> C.int

    gmtime_r :: (timep: &time_t, result: &tm) -> &tm
    localtime_r :: (timep: &time_t, result: &tm) -> &tm

    mktime :: (tm: &tm) -> time_t
    timegm :: (tm: &tm) -> time_t

    nanosleep :: (duration: &timespec, rem: &timespec) -> C.int
}

C :: #import "C"
