File :: distinct rawptr

#if PLATFORM == {
case .LINUX
    Open_Flag :: enum {
        RDONLY = 0
        WRONLY = 1
        RDWR   = 2
        CREAT  = 64
        EXCL   = 128
        TRUNC  = 512
        APPEND = 1024
        TEXT   = 0
        BINARY = 0
    }

case .MACOS
    Open_Flag :: enum {
        RDONLY = 0
        WRONLY = 1
        RDWR   = 2
        APPEND = 8
        CREAT  = 512
        TRUNC  = 1024
        EXCL   = 2048
        TEXT   = 0
        BINARY = 0
    }

case .WINDOWS
    Open_Flag :: enum {
        RDONLY = 0
        WRONLY = 1
        RDWR   = 2
        APPEND = 8
        CREAT  = 256
        TRUNC  = 512
        EXCL   = 1024
        TEXT   = 16384
        BINARY = 32768
    }
}

open :: (path: string, flags: Open_Flag, perm: s32 = 0o666) -> File, error {
    path := strings.to_cstring(path, temporary_allocator)?
    defer temporary_allocator.rewind(rawptr(path))

    fd := C.open(path, C.int(flags), C.int(perm))
    if fd == -1 {
        return null, C.get_errno()
    }

    mode: &C.char
    if flags & .RDWR != 0 {
        if flags & .APPEND != 0 {
            mode = "a+"
        } else {
            mode = "r+"
        }
    } else if flags & .WRONLY != 0 {
        if flags & .APPEND != 0 {
            mode = "a"
        } else {
            mode = "w"
        }
    } else {
        mode = "r"
    }

    f := File(C.fdopen(fd, mode))
    if f == null {
        return null, C.get_errno()
    }
    return f, null
}

read :: (this: File, bytes: []u8) -> s64, error {
    n := C.fread(rawptr(bytes.data), 1, C.size_t(bytes.count), C.FILE(this))
    if C.ferror(C.FILE(this)) != 0 {
        return s64(n), C.get_errno()
    }
    return s64(n), null
}

seek :: (this: File, offset: s32, whence: io.Seek) -> s64, error {
    if C.fseek(C.FILE(this), C.int(offset), C.int(whence)) != 0 {
        return 0, C.get_errno()
    }

    #if PLATFORM == .WINDOWS {
        n := C.ftelli64(C.FILE(this))
    } else {
        n := C.ftell(C.FILE(this))
    }

    if n == -1 {
        return 0, C.get_errno()
    }
    return n, null
}

write :: (this: File, bytes: []u8) -> s64, error {
    n := C.fwrite(rawptr(bytes.data), sizeof(u8), C.size_t(bytes.count), C.FILE(this))
    if C.ferror(C.FILE(this)) != 0 {
        return s64(n), C.get_errno()
    }
    return s64(n), null
}

close :: inline (this: &File) {
    C.fclose(C.FILE(*this))
    *this = null
}

rewind :: inline (this: File) {
    C.rewind(C.FILE(this))
}

#if PLATFORM == {
case .LINUX
    extern {
        stdin:  File
        stdout: File
        stderr: File
    }

case .MACOS
    extern {
        #link "__stdinp"  stdin:  File
        #link "__stdoutp" stdout: File
        #link "__stderrp" stderr: File
    }

case .WINDOWS
    stdin:  File
    stdout: File
    stderr: File
}

args: []string
exit :: C.exit

C       :: #import "C"
io      :: #import "io"
strings :: #import "strings"
