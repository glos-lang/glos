args: []string

exit :: C.exit

#if PLATFORM == {
case .LINUX
    extern {
        stdin:  File
        stdout: File
        stderr: File
    }

case .MACOS
    extern {
        #link "__stdinp"  stdin:  File
        #link "__stdoutp" stdout: File
        #link "__stderrp" stderr: File
    }

case .WINDOWS
    stdin:  File
    stdout: File
    stderr: File
}

C :: #import "C"
