create_dir :: (path: string) -> error {
    #if PLATFORM == .WINDOWS {
        wstr := utf16.from_string(path, temporary_allocator)?.data
        defer temporary_allocator.rewind(rawptr(wstr))
        return mkdir(path, wstr)

        mkdir :: (p: string, wstr: &win.WCHAR) -> win.Error {
            if win.CreateDirectoryW(wstr, null) != 0 {
                return null
            }

            err := win.get_error()
            if u32(err) == ERROR_ALREADY_EXISTS {
                return null
            }

            if u32(err) != ERROR_PATH_NOT_FOUND {
                return err
            }

            pred := []rune{'/', '\\'}
            i, _ := strings.find(p, pred, reverse = true)
            np   := strings.trim_right(p[..i], pred)
            assert(np != "")

            cp := mem.offset(wstr, np.count)
            *cp = u16(u8('\0'))
            err = mkdir(np, wstr)
            *cp = u16(u8('/'))

            if err != null && u32(err) != ERROR_ALREADY_EXISTS {
                return err
            }

            if win.CreateDirectoryW(wstr, null) != 0 {
                return null
            }

            err = win.get_error()
            if u32(err) == ERROR_ALREADY_EXISTS {
                return null
            } else {
                return err
            }

            ERROR_PATH_NOT_FOUND :: 3
            ERROR_ALREADY_EXISTS :: 183
        }
    } else {
        cstr := strings.to_cstring(path, temporary_allocator)?
        defer temporary_allocator.rewind(rawptr(cstr))
        return mkdir(path, cstr)

        mkdir :: (p: string, cstr: &C.char) -> C.Errno {
            if posix.mkdir(cstr, 0o777) == 0 {
                return null
            }

            err := C.get_errno()
            if err == .EEXIST {
                return null
            }

            if err != .ENOENT {
                return err
            }

            i, _ := strings.find(p, '/', reverse = true)
            np   := strings.trim_right(p[..i], '/')
            assert(np != "")

            cp := mem.offset(cstr, np.count)
            *cp = '\0'
            err = mkdir(np, cstr)
            *cp = '/'

            if err != null && err != .EEXIST {
                return err
            }

            if posix.mkdir(cstr, 0o777) == 0 {
                return null
            }

            err = C.get_errno()
            if err == .EEXIST {
                return null
            } else {
                return err
            }
        }
    }
}

#if PLATFORM == .WINDOWS {
    Dir_Iter :: struct {
        stack:     [..]Dir_Iter_Frame
        path:      [..]win.WCHAR
        sb:        strings.Builder
        entry:     Dir_Entry
        recursive: bool
    }

    #private
    Dir_Iter_Frame :: struct {
        dir:        win.HANDLE
        ent:        win.WIN32_FIND_DATAW
        path_count: s64
        first_used: bool
    }
} else {
    Dir_Iter :: struct {
        stack:     [..]Dir_Iter_Frame
        path:      [..]C.char
        entry:     Dir_Entry
        recursive: bool
    }

    #private
    Dir_Iter_Frame :: struct {
        dir:        posix.DIR
        ent:        &posix.dirent
        path_count: s64
    }
}

iter_dir :: (path: string, recursive := false) -> Dir_Iter, error {
    di: Dir_Iter

    #if PLATFORM == .WINDOWS {
        for _, r := range path {
            utf16.encode_into_dynamic_array(r, &di.path)
        }

        utf16.encode_into_dynamic_array('/', &di.path)
        utf16.encode_into_dynamic_array('*', &di.path)
        di.path.push(0)

        frame: Dir_Iter_Frame
        frame.dir = win.FindFirstFileW(di.path.data, &frame.ent);
        if frame.dir == win.INVALID_HANDLE_VALUE {
            err := win.get_error()
            di.free()
            return di, err
        }
        frame.path_count = di.path.count - 2
    } else {
        di.path.push(...[]C.char(path))
        di.path.push('\0')

        frame: Dir_Iter_Frame
        frame.dir = posix.opendir(di.path.data)
        if frame.dir == null {
            err := C.get_errno()
            di.free()
            return di, err
        }
        frame.path_count = di.path.count - 1
    }

    di.stack.push(frame)
    di.recursive = recursive
    return di, null
}

free :: (this: &Dir_Iter) {
    #if PLATFORM == .WINDOWS {
        for _, it := range this.stack {
            win.FindClose(it.dir)
        }

        this.sb.free()
    } else {
        for _, it := range this.stack {
            posix.closedir(it.dir)
        }
    }

    this.path.free()
    this.stack.free()
}

Dir_Entry :: struct {
    path:  string
    name:  string
    isdir: bool
    skip:  bool
}

#if PLATFORM == .WINDOWS {
    range :: (this: &Dir_Iter, state: &struct {}) -> &Dir_Entry, error, bool {
        for {
            if this.stack.count == 0 {
                this.free()
                return null, null, false
            }

            it := &this.stack[this.stack.count - 1]
            if it.first_used {
                if this.recursive && (it.ent.dwFileAttributes & win.FILE_ATTRIBUTE_DIRECTORY) != 0 && !this.entry.skip {
                    utf16.encode_into_dynamic_array('/', &this.path)
                    utf16.encode_into_dynamic_array('*', &this.path)
                    this.path.push(0)

                    frame: Dir_Iter_Frame
                    frame.dir = win.FindFirstFileW(this.path.data, &frame.ent);
                    if frame.dir == win.INVALID_HANDLE_VALUE {
                        return null, win.get_error(), true
                    }
                    frame.path_count = this.path.count - 2

                    it.ent.dwFileAttributes = 0
                    this.stack.push(frame)
                    continue
                }

                if win.FindNextFileW(it.dir, &it.ent) == 0 {
                    win.FindClose(it.dir)
                    this.stack.count -= 1
                    continue
                }

                if it.dir == win.INVALID_HANDLE_VALUE {
                    return null, win.get_error(), true
                }
            } else {
                it.first_used = true
            }

            count := s64(win.wcslen(it.ent.cFileName.data))
            this.path.count = it.path_count
            this.path.push(...[]u16(it.ent.cFileName.data, count))
            this.sb.count = 0
            utf16.to_builder(this.path, &this.sb)

            name := string(this.sb[this.sb.count - count..])
            if name == "." || name == ".." {
                it.ent.dwFileAttributes = 0
                continue
            }

            mem.zero(&this.entry)
            this.entry.path = strings.trim_left(string(this.sb[..]), "./")
            this.entry.name = name
            this.entry.isdir = (it.ent.dwFileAttributes & win.FILE_ATTRIBUTE_DIRECTORY) != 0
            return &this.entry, null, true
        }
    }
} else {
    range :: (this: &Dir_Iter, state: &struct {}) -> &Dir_Entry, error, bool {
        for {
            if this.stack.count == 0 {
                this.free()
                return null, null, false
            }

            it := &this.stack[this.stack.count - 1]
            if this.recursive && it.ent != null && it.ent.type == posix.DT_DIR && !this.entry.skip {
                frame: Dir_Iter_Frame
                frame.dir = posix.opendir(this.path.data)
                if frame.dir == null {
                    return null, C.get_errno(), true
                }
                frame.path_count = this.path.count - 1

                it.ent = null
                this.stack.push(frame)
                continue
            }

            C.set_errno(null)
            it.ent = posix.readdir(it.dir)
            if it.ent == null {
                err := C.get_errno()
                if err != null {
                    return null, err, true
                }

                posix.closedir(it.dir)
                this.stack.count -= 1
                continue
            }

            name := strings.from_cstring(&C.char(it.ent.name.data))
            if name == "." || name == ".." {
                it.ent = null
                continue
            }

            this.path.count = it.path_count
            this.path.push('/')
            this.path.push(...[]C.char(name))
            this.path.push('\0')

            mem.zero(&this.entry)
            this.entry.path = strings.trim_left(string(this.path[..this.path.count - 1]), "./")
            this.entry.name = name
            this.entry.isdir = (it.ent.type == posix.DT_DIR)
            return &this.entry, null, true
        }
    }
}
