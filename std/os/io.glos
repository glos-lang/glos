File :: distinct rawptr

read :: (this: File, bytes: []char) -> s64, error {
    n := C.fread(rawptr(bytes.data), 1, u64(bytes.count), this)
    if C.ferror(this) != 0 {
        return s64(n), C.get_errno()
    }
    return s64(n), null
}

write :: (this: File, bytes: []char) -> s64, error {
    n := C.fwrite(rawptr(bytes.data), sizeof(char), u64(bytes.count), this)
    if C.ferror(this) != 0 {
        return s64(n), C.get_errno()
    }
    return s64(n), null
}

close :: (this: &File) {
    C.fclose(*this)
    *this = null
}

#if PLATFORM == {
case .LINUX
    extern {
        stdin:  File
        stdout: File
        stderr: File
    }

case .MACOS
    extern {
        #link "__stdinp"  stdin:  File
        #link "__stdoutp" stdout: File
        #link "__stderrp" stderr: File
    }

case .WINDOWS
    stdin:  File
    stdout: File
    stderr: File
}

// TODO: Only binary is supported
open :: (path: string, read: bool) -> File, error {
    path := strings.to_cstring(path, temporary_allocator)
    defer temporary_allocator.rewind(rawptr(path))

    f: File
    if read {
        f = C.fopen(path, "r")
    } else {
        f = C.fopen(path, "w")
    }
    return f, C.get_errno()
}

// TODO: Only binary is supported
read_entire_file :: (path: string, allocator := default_allocator) -> []char, error {
    f, err := open(path, true)
    if err != null {
        return {}, err
    }
    defer C.fclose(f)

    if C.fseek(f, 0, C.SEEK_END) == -1 {
        return {}, C.get_errno()
    }

    offset := C.ftell(f)
    if offset == -1 {
        return {}, C.get_errno()
    }

    if C.fseek(f, 0, C.SEEK_SET) == -1 {
        return {}, C.get_errno()
    }

    data := &char(allocator.alloc(offset + 1, zeroed = false))
    if data == null {
        return {}, C.get_errno()
    }

    bytes  := []char(data, offset + 1)
    n, err := f.read(bytes)
    if err != null {
        return {}, err // TODO: A single read() might not read everything.
    }

    bytes[n] = 0
    bytes.count = n
    allocator.rewind(rawptr(bytes.data) + rawptr(n + 1))
    return bytes, null
}
