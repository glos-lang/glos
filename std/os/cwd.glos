getcwd :: (allocator := default_allocator) -> string, error {
    checkpoint := temporary_allocator.alloc(0)?
    defer temporary_allocator.rewind(checkpoint)

    #if PLATFORM == .WINDOWS {
        count := win.GetCurrentDirectoryW(0, null)
        if count == 0 {
            win.get_error()?
        }

        tmp := mem.new_array(u16, s64(count), zeroed = false, allocator = temporary_allocator)?
        if win.GetCurrentDirectoryW(count, tmp.data) == 0 {
            win.get_error()?
        }

        tmp.count -= 1
        return utf16.to_string(tmp, allocator = allocator)
    } else {
        capacity := 128
        temporary_allocator.alloc(capacity)
        for posix.getcwd(&C.char(checkpoint), C.size_t(capacity)) == null {
            err := C.get_errno()
            if err != .ERANGE then err?

            temporary_allocator.alloc(capacity)?
            capacity *= 2
        }

        src := strings.from_cstring(&C.char(checkpoint))
        dst := string(mem.new_array(u8, src.count, zeroed = false, allocator = allocator)?)
        mem.copy(dst.data, src.data, src.count)
        return dst, null
    }
}

setcwd :: (path: string) -> error {
    #if PLATFORM == .WINDOWS {
        path := utf16.from_string(path, temporary_allocator)?.data
        defer temporary_allocator.rewind(rawptr(path))

        if win.SetCurrentDirectoryW(path) == 0 {
            return win.get_error()
        }
    } else {
        path := strings.to_cstring(path, temporary_allocator)?
        defer temporary_allocator.rewind(rawptr(path))

        if posix.chdir(path) != 0 {
            return C.get_errno()
        }
    }

    return null
}
