Cmd :: distinct [..]string

Cmd_Error :: enum error {
    No_Command "No command"
}

Cmd_Capture :: enum {
    NOP
    TEXT
    BINARY
}

start :: (this: &Cmd, capture_stdin := Cmd_Capture.NOP, capture_stdout := Cmd_Capture.NOP, capture_stderr := Cmd_Capture.NOP, reset := true) -> Process, error {
    if this.count == 0 {
        Cmd_Error.No_Command?
    }

    #if PLATFORM == .WINDOWS {
        si: win.STARTUPINFOW
        si.cb = sizeof(si)

        sa: win.SECURITY_ATTRIBUTES
        sa.nLength = sizeof(sa)
        sa.bInheritHandle = win.BOOL(true)
        sa.lpSecurityDescriptor = null

        stdout_pipe_read, stdout_pipe_write: win.HANDLE
        if capture_stdout != .NOP {
            if win.CreatePipe(&stdout_pipe_read, &stdout_pipe_write, &sa, 0) == 0 {
                win.get_error()?
            }
            win.SetHandleInformation(stdout_pipe_read, win.HANDLE_FLAG_INHERIT, 0)
        } else {
            stdout_pipe_write = win.GetStdHandle(win.STD_OUTPUT_HANDLE)
        }

        stderr_pipe_read, stderr_pipe_write: win.HANDLE
        if capture_stderr != .NOP {
            if win.CreatePipe(&stderr_pipe_read, &stderr_pipe_write, &sa, 0) == 0 {
                win.get_error()?
            }
            win.SetHandleInformation(stderr_pipe_read, win.HANDLE_FLAG_INHERIT, 0)
        } else {
            stderr_pipe_write = win.GetStdHandle(win.STD_ERROR_HANDLE)
        }

        stdin_pipe_read, stdin_pipe_write: win.HANDLE
        if capture_stdin != .NOP {
            if win.CreatePipe(&stdin_pipe_read, &stdin_pipe_write, &sa, 0) == 0 {
                win.get_error()?
            }
            win.SetHandleInformation(stdin_pipe_write, win.HANDLE_FLAG_INHERIT, 0)
        } else {
            stdin_pipe_read = win.GetStdHandle(win.STD_INPUT_HANDLE)
        }

        si.hStdOutput = stdout_pipe_write
        si.hStdError = stderr_pipe_write
        si.hStdInput = stdin_pipe_read
        si.dwFlags |= win.STARTF_USESTDHANDLES

        cmdline: [..]win.WCHAR
        defer cmdline.free()

        for i, s := range *this {
            if i > 0 {
                utf16.encode_into_dynamic_array(' ', &cmdline)
            }

            needs_quotes := (s == "")
            for _, r := range s {
                if r == ' ' || r == '\t' || r == '\n' || r == '\v' || r == '"' {
                    needs_quotes = true
                    break
                }
            }

            if needs_quotes {
                utf16.encode_into_dynamic_array('"', &cmdline)

                backslashes := 0
                for _, r := range s {
                    if r == '\\' {
                        backslashes += 1
                    } else {
                        if r == '"' {
                            for range 1 + backslashes {
                                utf16.encode_into_dynamic_array('\\', &cmdline)
                            }
                        }
                        backslashes = 0
                    }
                    utf16.encode_into_dynamic_array(r, &cmdline)
                }

                for range backslashes {
                    utf16.encode_into_dynamic_array('\\', &cmdline)
                }

                utf16.encode_into_dynamic_array('"', &cmdline)
            } else {
                for _, r := range s {
                    utf16.encode_into_dynamic_array(r, &cmdline)
                }
            }
        }

        cmdline.push(0)
        this.count = 0

        pi: win.PROCESS_INFORMATION
        if win.CreateProcessW(null, cmdline.data, null, null, win.BOOL(true), 0, null, null, &si, &pi) == 0 {
            win.get_error()?
        }
        win.CloseHandle(pi.hThread)

        p: Process
        p.id = pi.hProcess

        if capture_stdin != .NOP {
            win.CloseHandle(stdin_pipe_read)
            if capture_stdin == .TEXT {
                p.stdin = Pipe(win._fdopen(win._open_osfhandle(C.intptr_t(stdin_pipe_write), C.int(Open_Flag.WRONLY | Open_Flag.TEXT)), "w"))
            } else {
                p.stdin = Pipe(win._fdopen(win._open_osfhandle(C.intptr_t(stdin_pipe_write), C.int(Open_Flag.WRONLY | Open_Flag.BINARY)), "wb"))
            }
        }

        if capture_stdout != .NOP {
            win.CloseHandle(stdout_pipe_write)
            if capture_stdout == .TEXT {
                p.stdout = Pipe(win._fdopen(win._open_osfhandle(C.intptr_t(stdout_pipe_read), C.int(Open_Flag.RDONLY | Open_Flag.TEXT)), "r"))
            } else {
                p.stdout = Pipe(win._fdopen(win._open_osfhandle(C.intptr_t(stdout_pipe_read), C.int(Open_Flag.RDONLY | Open_Flag.BINARY)), "rb"))
            }
        }

        if capture_stderr != .NOP {
            win.CloseHandle(stderr_pipe_write)
            if capture_stderr == .TEXT {
                p.stderr = Pipe(win._fdopen(win._open_osfhandle(C.intptr_t(stderr_pipe_read), C.int(Open_Flag.RDONLY | Open_Flag.TEXT)), "r"))
            } else {
                p.stderr = Pipe(win._fdopen(win._open_osfhandle(C.intptr_t(stderr_pipe_read), C.int(Open_Flag.RDONLY | Open_Flag.BINARY)), "rb"))
            }
        }

        return p, null
    } else {
        in:   [2]C.int
        out:  [2]C.int
        err:  [2]C.int
        fail: [2]C.int

        if capture_stdin != .NOP && posix.pipe(&in) < 0 {
            C.get_errno()?
        }

        if capture_stdout != .NOP && posix.pipe(&out) < 0 {
            C.get_errno()?
        }

        if capture_stderr != .NOP && posix.pipe(&err) < 0 {
            C.get_errno()?
        }

        if posix.pipe(&fail) < 0 || posix.fcntl(fail[1], posix.F_SETFD, posix.FD_CLOEXEC) < 0 {
            C.get_errno()?
        }

        p: Process
        p.id = posix.fork()
        if p.id < 0 {
            C.get_errno()?
        }

        if p.id == 0 {
            if capture_stdin != .NOP {
                posix.close(in[1])
                posix.dup2(in[0], posix.STDIN_FILENO)
                posix.close(in[0])
            }

            if capture_stdout != .NOP {
                posix.close(out[0])
                posix.dup2(out[1], posix.STDOUT_FILENO)
                posix.close(out[1])
            }

            if capture_stderr != .NOP {
                posix.close(err[0])
                posix.dup2(err[1], posix.STDERR_FILENO)
                posix.close(err[1])
            }

            args := mem.new_array(&C.char, this.count + 1, zeroed = false)!
            for i, it := range *this {
                args[i] = strings.to_cstring(it)!
            }
            args[this.count] = null

            posix.close(fail[0])
            posix.execvp(args[0], args.data)
            posix.write(fail[1], "E", 1)
            posix.close(fail[1])
            exit(127)
        }

        if reset {
            this.count = 0
        }

        posix.close(fail[1])
        buffer: [1]C.char
        count := posix.read(fail[0], buffer.data, C.size_t(buffer.count))
        posix.close(fail[0])

        if count > 0 {
            posix.waitpid(p.id, null, 0)
            C.Errno.ENOENT?
        }

        if capture_stdin != .NOP {
            posix.close(in[0])
            p.stdin = Pipe(posix.fdopen(in[1], "w"))
            if p.stdin == null {
                C.get_errno()?
            }
        }

        if capture_stdout != .NOP {
            posix.close(out[1])
            p.stdout = Pipe(posix.fdopen(out[0], "r"))
            if p.stdout == null {
                C.get_errno()?
            }
        }

        if capture_stderr != .NOP {
            posix.close(err[1])
            p.stderr = Pipe(posix.fdopen(err[0], "r"))
            if p.stderr == null {
                C.get_errno()?
            }
        }

        return p, null
    }
}

run :: inline (this: &Cmd, reset := true) -> s32, error {
    return this.start(reset = reset)?.wait()
}

#if PLATFORM == .WINDOWS {
    Process :: struct {
        id:     win.HANDLE
        stdin:  Pipe
        stdout: Pipe
        stderr: Pipe
    }
} else {
    Process :: struct {
        id:     C.int
        stdin:  Pipe
        stdout: Pipe
        stderr: Pipe
    }
}

wait :: (this: Process) -> s32, error {
    // Clear out the pipes, otherwise it deadlocks on windows
    if this.stdout != null then io.copy(io.Discard_Writer {}, this.stdout)
    if this.stderr != null then io.copy(io.Discard_Writer {}, this.stderr)

    #if PLATFORM == .WINDOWS {
        if win.WaitForSingleObject(this.id, win.INFINITE) == win.WAIT_FAILED {
            win.get_error()?
        }

        code: win.DWORD
        if win.GetExitCodeProcess(this.id, &code) == 0 {
            win.get_error()?
        }

        win.CloseHandle(this.id)
        return s32(code), null
    } else {
        if this.id == 0 {
            C.Errno.EINVAL?
        }

        status: s32
        if posix.waitpid(this.id, &status, 0) < 0 {
            C.get_errno()?
        }

        #if PLATFORM == .MACOS {
            if (status & 0o177) != 0o177 && (status & 0o177) != 0 {
                return 128 + (status & 0o177), null
            }

            return (status >> 8) & 0x000000FF, null
        } else {
            if (((status & 0x7F) + 1) >> 1) > 0 {
                return 128 + (status & 0x7F), null
            }

            return (status & 0xFF00) >> 8, null
        }
    }
}

kill :: (this: Process, force := false) -> error {
    #if PLATFORM == .WINDOWS {
        if win.TerminateProcess(this.id, 1) == 0 {
            return win.get_error()
        }
    } else {
        if force {
            if posix.kill(this.id, 9) != 0 {
                return C.get_errno()
            }
        } else {
            if posix.kill(this.id, 15) != 0 {
                return C.get_errno()
            }
        }
    }

    return null
}

mem :: #import "memory"
