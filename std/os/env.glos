getenv :: (key: string, allocator := default_allocator) -> string {
    key := strings.to_cstring(key, temporary_allocator)!
    defer temporary_allocator.rewind(rawptr(key))

    #if PLATFORM == .WINDOWS {
        count := win.GetEnvironmentVariableA(win.LPCSTR(key), null, 0)
        if count == 0 {
            return ""
        }

        dst := string(mem.new_array(u8, s64(count), zeroed = false, allocator = allocator)!)
        win.GetEnvironmentVariableA(win.LPCSTR(key), dst.data, win.DWORD(dst.count))
        dst.count -= 1
        return dst
    } else {
        value := posix.getenv(key)
        if value == null {
            return ""
        }

        src := strings.from_cstring(value)
        dst := string(mem.new_array(u8, src.count, zeroed = false, allocator = allocator)!)
        mem.copy(dst.data, src.data, src.count)
        return dst
    }
}

setenv :: (key: string, value: string, allocator := default_allocator) -> error {
    key   := strings.to_cstring(key, temporary_allocator)?
    value := strings.to_cstring(value, temporary_allocator)?
    defer temporary_allocator.rewind(rawptr(key))

    #if PLATFORM == .WINDOWS {
        if win.SetEnvironmentVariableA(win.LPCSTR(key), win.LPSTR(value)) == 0 {
            return C.get_errno()
        }
    } else {
        if posix.setenv(key, value, C.int(true)) != 0 {
            return C.get_errno()
        }
    }

    return null
}

unsetenv :: (key: string) -> error {
    key := strings.to_cstring(key, temporary_allocator)?
    defer temporary_allocator.rewind(rawptr(key))

    #if PLATFORM == .WINDOWS {
        if win.SetEnvironmentVariableA(win.LPCSTR(key), null) == 0 {
            return C.get_errno()
        }
    } else {
        if posix.unsetenv(key) != 0 {
            return C.get_errno()
        }
    }

    return null
}
