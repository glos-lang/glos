getenv :: (key: string, allocator := default_allocator) -> string {
    #if PLATFORM == .WINDOWS {
        key := utf16.from_string(key, allocator = temporary_allocator)!.data
        defer temporary_allocator.rewind(rawptr(key))

        count := win.GetEnvironmentVariableW(key, null, 0)
        if count == 0 {
            return ""
        }

        tmp := mem.new_array(u16, s64(count), zeroed = false, allocator = temporary_allocator)!
        win.GetEnvironmentVariableW(key, tmp.data, count)

        tmp.count -= 1
        return utf16.to_string(tmp, allocator = allocator)!
    } else {
        key := strings.to_cstring(key, temporary_allocator)!
        defer temporary_allocator.rewind(rawptr(key))

        value := posix.getenv(key)
        if value == null {
            return ""
        }

        src := strings.from_cstring(value)
        dst := string(mem.new_array(u8, src.count, zeroed = false, allocator = allocator)!)
        mem.copy(dst.data, src.data, src.count)
        return dst
    }
}

setenv :: (key: string, value: string, allocator := default_allocator) -> error {
    #if PLATFORM == .WINDOWS {
        key   := utf16.from_string(key, temporary_allocator)?.data
        value := utf16.from_string(value, temporary_allocator)?.data
        defer temporary_allocator.rewind(rawptr(key))

        if win.SetEnvironmentVariableW(key, value) == 0 {
            return win.get_error()
        }
    } else {
        key   := strings.to_cstring(key, temporary_allocator)?
        value := strings.to_cstring(value, temporary_allocator)?
        defer temporary_allocator.rewind(rawptr(key))

        if posix.setenv(key, value, C.int(true)) != 0 {
            return C.get_errno()
        }
    }

    return null
}

unsetenv :: (key: string) -> error {
    #if PLATFORM == .WINDOWS {
        key := utf16.from_string(key, temporary_allocator)?.data
        defer temporary_allocator.rewind(rawptr(key))

        if win.SetEnvironmentVariableW(key, null) == 0 {
            return win.get_error()
        }
    } else {
        key := strings.to_cstring(key, temporary_allocator)?
        defer temporary_allocator.rewind(rawptr(key))

        if posix.unsetenv(key) != 0 {
            return C.get_errno()
        }
    }

    return null
}
