File :: distinct rawptr

open_file :: (path: string, flags := Open_Flag.RDONLY | Open_Flag.TEXT, perm := s32(0o666)) -> File, error {
    path := strings.to_cstring(path, temporary_allocator)?
    defer temporary_allocator.rewind(rawptr(path))

    fd := open(path, C.int(flags), C.int(perm))
    if fd == -1 {
        return null, C.get_errno()
    }

    mode: &C.char
    if flags & .RDWR != 0 {
        if flags & .APPEND != 0 {
            mode = "a+"
        } else {
            mode = "r+"
        }
    } else if flags & .WRONLY != 0 {
        if flags & .APPEND != 0 {
            mode = "a"
        } else {
            mode = "w"
        }
    } else {
        mode = "r"
    }

    #if PLATFORM == .WINDOWS {
        open   :: win._open
        fdopen :: win._fdopen
    } else {
        open   :: posix.open
        fdopen :: posix.fdopen
    }

    f := File(fdopen(fd, mode))
    if f == null {
        return null, C.get_errno()
    }
    return f, null
}

create_file :: inline (path: string, flags := Open_Flag.TEXT, perm := s32(0o666)) -> File, error {
    return open_file(path, flags | .CREAT | .TRUNC | .WRONLY, perm)
}

#if PLATFORM == {
case .LINUX
    Open_Flag :: enum {
        RDONLY = 0
        WRONLY = 1
        RDWR   = 2
        CREAT  = 64
        EXCL   = 128
        TRUNC  = 512
        APPEND = 1024
        TEXT   = 0
        BINARY = 0
    }

case .MACOS
    Open_Flag :: enum {
        RDONLY = 0
        WRONLY = 1
        RDWR   = 2
        APPEND = 8
        CREAT  = 512
        TRUNC  = 1024
        EXCL   = 2048
        TEXT   = 0
        BINARY = 0
    }

case .WINDOWS
    Open_Flag :: enum {
        RDONLY = 0
        WRONLY = 1
        RDWR   = 2
        APPEND = 8
        CREAT  = 256
        TRUNC  = 512
        EXCL   = 1024
        TEXT   = 16384
        BINARY = 32768
    }
}

read :: (this: File, bytes: []u8) -> s64, error {
    if this == null {
        C.Errno.EINVAL?
    }

    n := C.fread(rawptr(bytes.data), 1, C.size_t(bytes.count), C.FILE(this))
    if C.ferror(C.FILE(this)) != 0 {
        return s64(n), C.get_errno()
    }
    return s64(n), null
}

seek :: (this: File, offset: s64, whence: io.Seek) -> s64, error {
    if this == null {
        C.Errno.EINVAL?
    }

    n := lseek(fileno(C.FILE(this)), offset, C.int(whence))
    if n == -1 {
        return 0, C.get_errno()
    }
    return n, null

    #if PLATFORM == .WINDOWS {
        lseek  :: win._lseeki64
        fileno :: win._fileno
    } else {
        lseek  :: posix.lseek
        fileno :: posix.fileno
    }
}

write :: (this: File, bytes: []u8) -> s64, error {
    if this == null {
        C.Errno.EINVAL?
    }

    n := C.fwrite(rawptr(bytes.data), sizeof(u8), C.size_t(bytes.count), C.FILE(this))
    if C.ferror(C.FILE(this)) != 0 {
        return s64(n), C.get_errno()
    }
    return s64(n), null
}

flush :: (this: File) -> error {
    if this == null {
        C.Errno.EINVAL?
    }

    if C.fflush(C.FILE(this)) != 0 {
        return C.get_errno()
    }
    return null
}

close :: (this: &File) {
    if *this != null {
        C.fclose(C.FILE(*this))
        *this = null
    }
}

read_file :: (path: string, allocator := default_allocator) -> []u8, error {
    f := open_file(path)?
    defer f.close()

    offset := f.seek(0, .END)?
    f.seek(0, .START)?

    data := allocator.alloc(offset + 1, zeroed = false)?
    bytes := []u8(&u8(data), offset + 1)

    n, err := f.read(bytes)
    if err != null {
        return bytes, err // Do not use the '?' operator here, as user might need the bytes
    }

    bytes[n] = 0
    bytes.count = n
    allocator.rewind(rawptr(bytes.data) + rawptr(n + 1))
    return bytes, null
}

write_file :: (path: string, bytes: []u8, flags := Open_Flag.TEXT, perm := s32(0o666)) -> error {
    f := create_file(path, flags, perm)?
    defer f.close()
    f.write(bytes)?
    return null
}

io      :: #import "io"
strings :: #import "strings"
