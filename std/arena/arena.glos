Arena :: struct {
    data:     rawptr
    head:     s64
    capacity: s64
}

alloc :: (this: &Arena, size: s64, old := null, align := true, zeroed := true, location := #caller_location) -> rawptr, error {
    if this.data == null {
        if this.capacity == 0 {
            this.capacity = 256 * 1024 * 1024
        }

        #if PLATFORM == .WINDOWS {
            this.data = C.VirtualAlloc(null, C.SIZE_T(this.capacity), C.MEM_RESERVE | C.MEM_COMMIT, C.PAGE_READWRITE)
            if this.data == null {
                return null, C.get_errno()
            }
        } else {
            this.data = C.mmap(null, C.size_t(this.capacity), C.PROT_READ | C.PROT_WRITE, C.MAP_PRIVATE | C.MAP_ANONYMOUS, -1, 0)
            if this.data == C.MAP_FAILED {
                return null, C.get_errno()
            }
        }
    }

    ptr := this.data + rawptr(this.head)
    if size == 0 {
        return ptr, null
    }

    if align {
        size = (size + 7) & -8
    }

    if this.head + size > this.capacity {
        panic("Arena overflow", location = location)
    }
    this.head += size

    if zeroed {
        C.memset(ptr, 0, u64(size))
    }
    return ptr, null
}

rewind :: (this: &Arena, ptr: rawptr, align := true, location := #caller_location) {
    if ptr < this.data || ptr > this.data + rawptr(this.head) {
        panic("Arena does not contain the memory address \{ptr}", location = location)
    }

    this.head = s64(ptr - this.data)
    if align {
        this.head = (this.head + 7) & -8
    }
}

free :: (this: &Arena) {
    if this.data == null {
        return
    }

    #if PLATFORM == .WINDOWS {
        C.VirtualFree(this.data, 0, C.MEM_RELEASE)
    } else {
        C.munmap(this.data, C.size_t(this.capacity))
    }

    C.memset(rawptr(this), 0, sizeof(*this))
}

C :: #import "C"
