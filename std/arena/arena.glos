Arena :: struct {
    data:     rawptr
    last:     rawptr
    head:     s64
    capacity: s64
}

alloc :: (this: &Arena, size: s64, old := null, align := true, zeroed := true, location := #caller_location) -> rawptr, error {
    if this.data == null {
        if this.capacity == 0 {
            this.capacity = 256 * 1024 * 1024
        }

        #if PLATFORM == .WINDOWS {
            this.data = win.VirtualAlloc(null, win.SIZE_T(this.capacity), win.MEM_RESERVE | win.MEM_COMMIT, win.PAGE_READWRITE)
            if this.data == null {
                return null, win.get_error()
            }
        } else {
            this.data = posix.mmap(null, C.size_t(this.capacity), posix.PROT_READ | posix.PROT_WRITE, posix.MAP_PRIVATE | posix.MAP_ANONYMOUS, -1, 0)
            if this.data == posix.MAP_FAILED {
                return null, C.get_errno()
            }
        }
    }

    if old != null && old == this.last {
        this.head = s64(this.last - this.data)
    }

    this.last = this.data + rawptr(this.head)
    if size == 0 {
        return this.last, null
    }

    if align {
        size = (size + 7) & -8
    }

    if this.head + size > this.capacity {
        panic("Arena overflow", location = location)
    }
    this.head += size

    if old != null && zeroed {
        C.memset(this.last, 0, C.size_t(size))
    }
    return this.last, null
}

rewind :: (this: &Arena, ptr: rawptr, align := true, location := #caller_location) {
    if ptr < this.data || ptr > this.data + rawptr(this.head) {
        panic("Arena does not contain the memory address \{ptr}", location = location)
    }

    this.head = s64(ptr - this.data)
    if align {
        this.head = (this.head + 7) & -8
    }
}

free :: (this: &Arena) {
    if this.data == null {
        return
    }

    #if PLATFORM == .WINDOWS {
        win.VirtualFree(this.data, 0, win.MEM_RELEASE)
    } else {
        posix.munmap(this.data, C.size_t(this.capacity))
    }

    C.memset(rawptr(this), 0, sizeof(*this))
}

C :: #import "C"

#if PLATFORM == .WINDOWS {
    win :: #import "windows"
} else {
    posix :: #import "posix"
}
