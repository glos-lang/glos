type :: (w: io.Writer, t: Type) -> s64, error {
    if t == null {
        return w.write([]u8("null"))
    }

    if t.name.count != 0 {
        return w.write([]u8(t.name))
    }

    n := 0
    v := t.variant
    if v == {
    case Type_Info_Boolean
        return w.write([]u8("bool"))

    case Type_Info_Rune
        return w.write([]u8("rune"))

    case Type_Info_Integer
        if v.signed {
            n += w.write([]u8("s"))?
        } else {
            n += w.write([]u8("u"))?
        }
        n += wprint(w, t.size * 8)?

    case Type_Info_Float
        n += w.write([]u8("f"))?
        n += wprint(w, t.size * 8)?

    case Type_Info_Pointer
        if v.underlying != null {
            n += w.write([]u8("&"))?
            n += type(w, v.underlying)?
        } else {
            return w.write([]u8("rawptr"))
        }

    case Type_Info_Function
        n += w.write([]u8("("))?
        for i, it := range v.args {
            if i > 0 {
                n += w.write([]u8(", "))?
            }

            if i == v.args.count - 1 && v.variadics == .TYPED {
                n += w.write([]u8("..."))?
                n += type(w, it.variant.(Type_Info_Slice).underlying)?
            } else {
                n += type(w, it)?
            }
        }

        if v.variadics == .UNTYPED {
            n += w.write([]u8(", ..."))?
        }
        n += w.write([]u8(")"))?

        if v.returns.count > 0 {
            n += w.write([]u8(" -> "))?
            if v.returns.count > 1 {
                n += w.write([]u8("("))?
            }

            for i, it := range v.returns {
                if i > 0 {
                    n += w.write([]u8(", "))?
                }
                n += type(w, it)?
            }

            if v.returns.count > 1 {
                n += w.write([]u8(")"))?
            }
        }

    case Type_Info_Enumeration
        n += w.write([]u8("enum "))?
        n += type(w, v.underlying)?

    case Type_Info_Trait
        n += w.write([]u8("trait {"))?
        if v.names.count != 0 {
            n += w.write([]u8(" "))?
            for i := 0; i < v.names.count; i += 1 {
                if i != 0 {
                    n += w.write([]u8("; "))?
                }

                n += wprint(w, "\{v.names[i]}: \{v.types[i]}")?
            }
            n += w.write([]u8(" "))?
        }
        n += w.write([]u8("}"))?

    case Type_Info_Union
        n += w.write([]u8("union {"))?
        if v.variants.count != 0 {
            n += w.write([]u8(" "))?
            for i := 0; i < v.variants.count; i += 1 {
                if i != 0 {
                    n += w.write([]u8("; "))?
                }

                n += type(w, v.variants[i])?
            }
            n += w.write([]u8(" "))?
        }
        n += w.write([]u8("}"))?

    case Type_Info_Structure
        n += w.write([]u8("struct {"))?
        if v.names.count != 0 {
            n += w.write([]u8(" "))?
            for i := 0; i < v.names.count; i += 1 {
                if i != 0 {
                    n += w.write([]u8("; "))?
                }

                n += wprint(w, "\{v.names[i]}: \{v.types[i]}")?
            }
            n += w.write([]u8(" "))?
        }
        n += w.write([]u8("}"))?

    case Type_Info_Array
        n += wprint(w, "[\{v.count}]\{v.underlying}")?

    case Type_Info_Dynamic_Array
        n += wprint(w, "[..]\{v.underlying}")?

    case Type_Info_Map
        n += wprint(w, "map[\{v.key}]\{v.value}")?

    case Type_Info_Slice
        n += wprint(w, "[]\{v.underlying}")?

    case Type_Info_Error
        return w.write([]u8("error"))

    case Type_Info_String
        return w.write([]u8("string"))

    case null
        return w.write([]u8("null"))
    }

    return n, null
}

quote :: (w: io.Writer, r: rune, quote: u8) -> s64, error {
    if r == {
    case '\e'; return w.write([]u8("\\e"))
    case '\n'; return w.write([]u8("\\n"))
    case '\r'; return w.write([]u8("\\r"))
    case '\t'; return w.write([]u8("\\t"))
    case '\f'; return w.write([]u8("\\f"))
    case '\v'; return w.write([]u8("\\v"))
    case '\0'; return w.write([]u8("\\0"))
    case '\\'; return w.write([]u8("\\\\"))

    case '\''
        if quote == '\'' {
            return w.write([]u8("\\'"))
        } else {
            return w.write([]u8("'"))
        }

    case '\"'
        if quote == '\"' {
            return w.write([]u8("\\\""))
        } else {
            return w.write([]u8("\""))
        }

    case;
        buffer: [4]u8
        n, _ := unicode.encode(r, buffer)
        return w.write(buffer[..n])
    }
}

value :: (w: io.Writer, f: Format, nested: bool) -> s64, error {
    if f.type != null && f.type.format != null {
        return f.type.format(f.data, w, nested)
    }

    if f.type == Type {
        return type(w, *(&Type)(f.data))
    }

    n := 0
    if f.type == Interpolation && !nested {
        interpolation := *(&Interpolation)(f.data)
        if interpolation == {
        case []Format
            for _, f := range interpolation {
                n += value(w, f, false)?
            }

        case string
            n += value(w, interpolation, false)?

        case
            unreachable()
        }
        return n, null
    }

    if f.type == Source_Code_Location {
        l := *(&Source_Code_Location)(f.data)
        return wprint(w, "\{l.path}:\{l.row}:\{l.col}:")
    }

    v := f.type.variant
    if v == {
    case Type_Info_Boolean
        if *(&bool)(f.data) {
            return w.write([]u8("true"))
        } else {
            return w.write([]u8("false"))
        }

    case Type_Info_Rune
        buffer: [4]u8
        n, _ := unicode.encode(*(&rune)(f.data), buffer)
        return w.write(buffer[..n])


    case Type_Info_Integer
        buffer: [32]u8
        count: s32
        if v.signed {
            if f.type.size == {
            case 1; count = C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "%d", *(&s8)(f.data))
            case 2; count = C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "%d", *(&s16)(f.data))
            case 4; count = C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "%d", *(&s32)(f.data))
            case 8; count = C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "%zd", *(&s64)(f.data))
            case;   unreachable()
            }
        } else {
            if f.type.size == {
            case 1; count = C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "%u", *(&u8)(f.data))
            case 2; count = C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "%u", *(&u16)(f.data))
            case 4; count = C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "%u", *(&u32)(f.data))
            case 8; count = C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "%zu", *(&u64)(f.data))
            case;   unreachable()
            }
        }
        return w.write(buffer[..count])

    case Type_Info_Float
        buffer: [32]u8
        count: s32
        if f.type.size == {
        case 4; count = C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "%.7g", *(&f32)(f.data))
        case 8; count = C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "%.14g", *(&f64)(f.data))
        case;   unreachable()
        }
        return w.write(buffer[..count])

    case Type_Info_Pointer, Type_Info_Function
        ptr := *(&rawptr)(f.data)
        if ptr == null {
            return w.write([]u8("null"))
        } else {
            buffer: [32]u8
            count := C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "0x%zx", ptr)
            return w.write(buffer[..count])
        }

    case Type_Info_Enumeration
        value: s64
        if v.underlying.size == {
        case 1; value = s64(*(&s8)(f.data))
        case 2; value = s64(*(&s16)(f.data))
        case 4; value = s64(*(&s32)(f.data))
        case 8; value = s64(*(&s64)(f.data))
        }

        for i := 0; i < v.values.count; i += 1 {
            if v.values[i] == value {
                return w.write([]u8(v.names[i]))
            }
        }

        if v.underlying == error {
            err := u64(value)
            if err == 0 {
                return w.write([]u8("null"))
            } else {
                return wprint(w, "(Invalid error value: \{err})")
            }
        } else {
            return wprint(w, "(Invalid enum value: \{value})")
        }

    case Type_Info_Trait
        t: Format
        t.type = *(&Type)(f.data)
        t.data = *(&rawptr)(f.data + rawptr(8))
        if t.type == null {
            return w.write([]u8("null"))
        } else {
            return value(w, t, nested)
        }

    case Type_Info_Union
        tag := *(&s64)(f.data)
        if tag == 0 {
            return w.write([]u8("null"))
        } else if tag - 1 >= v.variants.count {
            return wprint(w, "(Invalid union tag: \{tag})")
        } else {
            t: Format
            t.type = v.variants[tag - 1]
            t.data = f.data + rawptr(8)
            return value(w, t, nested)
        }

    case Type_Info_Structure
        n += w.write([]u8("{"))?
        for i := 0; i < v.types.count; i += 1 {
            field: Format
            field.type = v.types[i]
            field.data = f.data + rawptr(v.offsets[i])
            if i != 0 {
                n += w.write([]u8(", "))?
            }
            n += value(w, field, true)?
        }
        n += w.write([]u8("}"))?

    case Type_Info_Array
        n += w.write([]u8("{"))?
        for i := 0; i < v.count; i += 1 {
            if i != 0 {
                n += w.write([]u8(", "))?
            }

            item: Format
            item.type = v.underlying
            item.data = f.data + rawptr(i * v.underlying.size)
            n += value(w, item, true)?
        }
        n += w.write([]u8("}"))?

    case Type_Info_Dynamic_Array
        data  := *(&rawptr)(f.data)
        count := *(&s64)(f.data + rawptr(8))

        n += w.write([]u8("{"))?
        for i := 0; i < count; i += 1 {
            if i != 0 {
                n += w.write([]u8(", "))?
            }

            item: Format
            item.type = v.underlying
            item.data = data + rawptr(i * v.underlying.size)
            n += value(w, item, true)?
        }
        n += w.write([]u8("}"))?

    case Type_Info_Map
        data     := *(&rawptr)(f.data)
        count    := *(&s64)(f.data + rawptr(8))
        capacity := *(&s64)(f.data + rawptr(16))

        n += w.write([]u8("{"))?
        if count != 0 {
            first := true
            for i := range capacity {
                key_ptr, value_ptr, ok := map_entry_get_raw(data, v.key, v.value, i)
                if !ok {
                    continue
                }

                if first {
                    first = false
                } else {
                    n += w.write([]u8(", "))?
                }

                f: Format
                f.type = v.key
                f.data = key_ptr
                n += value(w, f, true)?

                n += w.write([]u8(" = "))?
                f.type = v.value
                f.data = value_ptr
                n += value(w, f, true)?

                map_entry_get_raw :: inline (data: rawptr, key: Type, value: Type, index: s64) -> rawptr, rawptr, bool {
                    Key_Offset   :: 8
                    Value_Offset := (Key_Offset + key.size + 7) & -8
                    Entry_Size   := (Value_Offset + value.size + 7) & -8
                    entry        := data + rawptr(Entry_Size * index)
                    return entry + rawptr(Key_Offset), entry + rawptr(Value_Offset), *(&s64)(entry) == 1
                }
            }
        }
        n += w.write([]u8("}"))?

    case Type_Info_Slice
        count := *(&s64)(f.data + rawptr(8))
        data  := *(&rawptr)(f.data)

        n += w.write([]u8("{"))?
        for i := 0; i < count; i += 1 {
            if i != 0 {
                n += w.write([]u8(", "))?
            }

            item: Format
            item.type = v.underlying
            item.data = data + rawptr(i * v.underlying.size)
            n += value(w, item, true)?
        }
        n += w.write([]u8("}"))?

    case Type_Info_Error
        err := *(&u64)(f.data)
        if err == 0 {
            return w.write([]u8("null"))
        }

        index := u32(err >> 32)
        if index != 0 {
            index -= 1
            if s64(index) < error_enums.count {
                v := error_enums[index].variant.(Type_Info_Enumeration)
                for i := 0; i < v.values.count; i += 1 {
                    if v.values[i] == s64(err) {
                        return w.write([]u8(v.names[i]))
                    }
                }
            }
        }

        return wprint(w, "(Invalid error value: \{err})")

    case Type_Info_String
        s := *(&string)(f.data)
        if nested {
            n += w.write([]u8("\""))?
            for _, c := range s {
                n += quote(w, c, '"')?
            }
            n += w.write([]u8("\""))?
        } else {
            return w.write([]u8(s))
        }

    case null
        return w.write([]u8("null"))
    }

    return n, null
}

values :: (w: io.Writer, fs: []Format) -> s64, error {
    n := 0
    interpolating := 0
    for i, f := range fs {
        if interpolating != 0 {
            interpolating -= 1
        } else if i != 0 {
            n += w.write([]u8(" "))?
        }

        if f.type == Interpolation_Marker {
            interpolating = s64(f.data)
            continue
        }

        if f == null {
            n += w.write([]u8("null"))?
        } else {
            n += value(w, f, false)?
        }
    }
    return n, null
}

C       :: #import "C"
io      :: #import "io"
unicode :: #import "unicode"
