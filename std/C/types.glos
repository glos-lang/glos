char  :: s8
uchar :: u8

short  :: s16
ushort :: u16

int  :: s32
uint :: u32

#if PLATFORM == .WINDOWS {
    long    :: s32
    ulong   :: u32
    wchar_t :: u16
} else {
    long    :: s64
    ulong   :: u64
    wchar_t :: s32
}

longlong  :: s64
ulonglong :: u64

signed   :: s32
unsigned :: u32

char16_t :: u16
char32_t :: u32

ssize_t   :: s64
size_t    :: u64

intptr_t  :: s64
uintptr_t :: u64
ptrdiff_t :: s64

float  :: f32
double :: f64

int8_t   :: s8
int16_t  :: s16
int32_t  :: s32
int64_t  :: s64

uint8_t  :: u8
uint16_t :: u16
uint32_t :: u32
uint64_t :: u64

#if PLATFORM == .LINUX {
    __va_list_tag :: struct {
        gp_offset:         uint
        fp_offset:         uint
        overflow_arg_area: rawptr
        reg_save_area:     rawptr
    }

    va_list :: [1]__va_list_tag
} else {
    va_list :: distinct rawptr
}
