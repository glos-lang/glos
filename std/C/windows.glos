#if PLATFORM == .WINDOWS {
    // Types
    BYTE      :: u8
    WORD      :: u16
    DWORD     :: u32
    QWORD     :: u64

    SHORT     :: s16
    USHORT    :: u16
    INT       :: s32
    UINT      :: u32
    LONG      :: s32
    ULONG     :: u32
    LONGLONG  :: s64
    ULONGLONG :: u64

    FLOAT     :: f32
    DOUBLE    :: f64

    INT_PTR    :: s64
    UINT_PTR   :: u64
    LONG_PTR   :: s64
    ULONG_PTR  :: u64
    DWORD_PTR  :: u64

    SIZE_T     :: u64
    SSIZE_T    :: s64

    BOOL    :: s32
    BOOLEAN :: u8
    HRESULT :: s32
    NTSTATUS:: s32

    HANDLE    :: rawptr
    HWND      :: rawptr
    HINSTANCE :: rawptr
    HMODULE   :: rawptr
    HDC       :: rawptr

    PVOID     :: rawptr
    LPVOID    :: rawptr
    LPCVOID   :: rawptr

    CHAR    :: u8
    PSTR    :: &u8
    LPSTR   :: &u8
    PCSTR   :: &u8
    LPCSTR  :: &u8
    LPBYTE  :: &u8
    LPDWORD :: &u32
    PHANDLE :: &rawptr

    WCHAR   :: u16
    PWSTR   :: &u16
    LPWSTR  :: &u16
    PCWSTR  :: &u16
    LPCWSTR :: &u16

    TCHAR   :: u16
    LPTSTR  :: &u16
    LPCTSTR :: &u16

    STARTUPINFOA :: struct {
        cb: DWORD
        lpReserved: LPSTR
        lpDesktop: LPSTR
        lpTitle: LPSTR
        dwX: DWORD
        dwY: DWORD
        dwXSize: DWORD
        dwYSize: DWORD
        dwXCountChars: DWORD
        dwYCountChars: DWORD
        dwFillAttribute: DWORD
        dwFlags: DWORD
        wShowWindow: WORD
        cbReserved2: WORD
        lpReserved2: LPBYTE
        hStdInput: HANDLE
        hStdOutput: HANDLE
        hStdError: HANDLE
    }

    LPSTARTUPINFOA :: &STARTUPINFOA

    SECURITY_ATTRIBUTES :: struct {
        nLength: DWORD
        lpSecurityDescriptor: LPVOID
        bInheritHandle: BOOL
    }

    PSECURITY_ATTRIBUTES :: &SECURITY_ATTRIBUTES
    LPSECURITY_ATTRIBUTES :: &SECURITY_ATTRIBUTES

    PROCESS_INFORMATION :: struct {
        hProcess: HANDLE
        hThread: HANDLE
        dwProcessId: DWORD
        dwThreadId: DWORD
    }

    PPROCESS_INFORMATION :: &PROCESS_INFORMATION
    LPPROCESS_INFORMATION :: &PROCESS_INFORMATION

    // API
    MEM_COMMIT  :: 0x00001000
    MEM_RELEASE :: 0x00008000
    MEM_RESERVE :: 0x00002000

    PAGE_READWRITE :: 0x04

    STD_INPUT_HANDLE  :: DWORD(s32(-10))
    STD_OUTPUT_HANDLE :: DWORD(s32(-11))
    STD_ERROR_HANDLE  :: DWORD(s32(-12))

    HANDLE_FLAG_INHERIT :: 0x00000001

    STARTF_USESTDHANDLES :: 0x00000100

    INFINITE :: 0xffffffff

    WAIT_FAILED :: 0xFFFFFFFF

    extern {
        VirtualAlloc :: (lpAddress: LPVOID, dwSize: SIZE_T, flAllocationType: DWORD, flProtect: DWORD) -> LPVOID
        VirtualFree  :: (lpAddress: LPVOID, dwSize: SIZE_T, dwFreeType: DWORD) -> BOOL

        CreateProcessA :: (
            lpApplicationName: LPCSTR,
            lpCommandLine: LPSTR,
            lpProcessAttributes: LPSECURITY_ATTRIBUTES,
            lpThreadAttributes: LPSECURITY_ATTRIBUTES,
            bInheritHandles: BOOL,
            dwCreationFlags: DWORD,
            lpEnvironment: LPVOID,
            lpCurrentDirectory: LPCSTR,
            lpStartupInfo: LPSTARTUPINFOA,
            lpProcessInformation: LPPROCESS_INFORMATION,
        ) -> BOOL

        CreatePipe :: (
            hReadPipe: PHANDLE,
            hWritePipe: PHANDLE,
            lpPipeAttributes: LPSECURITY_ATTRIBUTES,
            nSize: DWORD,
        ) -> BOOL

        CloseHandle :: (hObject: HANDLE) -> BOOL
        TerminateProcess :: (hProcess: HANDLE, uExitCode: UINT) -> BOOL

        GetStdHandle :: (nStdHandle: DWORD) -> HANDLE
        SetHandleInformation :: (
            hObject: HANDLE,
            dwMask: DWORD,
            dwFlags: DWORD
        ) -> BOOL

        WaitForSingleObject :: (hHandle: HANDLE, dwMilliseconds: DWORD) -> DWORD
        GetExitCodeProcess :: (hProcess: HANDLE, lpExitCode: LPDWORD) -> BOOL

        GetEnvironmentVariableA :: (lpName: LPCSTR, lpBuffer: LPSTR, nSize: DWORD) -> DWORD
        SetEnvironmentVariableA :: (lpName: LPCSTR, lpValue: LPCSTR) -> BOOL
    }
}
