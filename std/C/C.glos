FILE :: distinct rawptr

extern {
    puts :: (s: &char) -> int
    printf :: (fmt: &char, ...) -> int
    fprintf :: (f: FILE, fmt: &char, ...) -> int
    snprintf :: (out: &char, size: size_t, fmt: &char, ...) -> int
    fwrite :: (ptr: rawptr, size: size_t, count: size_t, f: FILE) -> size_t
    fflush :: (f: FILE)
    exit :: noreturn (code: int)
    abort :: noreturn ()
    memcmp :: (a: rawptr, b: rawptr, n: size_t) -> int
    free :: (ptr: rawptr)
    malloc :: (size: size_t) -> rawptr
    calloc :: (count: size_t, size: size_t) -> rawptr
    realloc :: (ptr: rawptr, size: size_t) -> rawptr
    memcpy :: (dst: rawptr, src: rawptr, count: size_t) -> rawptr
    memmove :: (dst: rawptr, src: rawptr, count: size_t) -> rawptr
    memset :: (dst: rawptr, ch: int, count: size_t) -> rawptr
    memchr :: (s: rawptr, ch: int, count: size_t) -> rawptr
    strlen :: (s: &char) -> size_t
    atexit :: (function: ()) -> int
    getenv :: (name: &char) -> &char
    fopen :: (path: &char, mode: &char) -> FILE
    fclose :: (f: FILE) -> int
    fseek :: (f: FILE, offset: int, whence: int) -> int
    ftell :: (f: FILE) -> long
    rewind :: (f: FILE)
    ferror :: (f: FILE) -> int
    fread :: (ptr: rawptr, size: size_t, count: size_t, f: FILE) -> size_t
    strtoll :: (s: &char, end: &&char, base: int) -> long_long

    #if PLATFORM == .WINDOWS {
        #link "_ftelli64" ftelli64 :: (f: FILE) -> s64
        #link "_open"     open :: (path: &char, flags: int, mode: int) -> int
        #link "_fdopen"   fdopen :: (fd: int, mode: &char) -> FILE
    } else {
        open :: (path: &char, flags: int, mode: int) -> int
        fdopen :: (fd: int, mode: &char) -> FILE
    }
}

