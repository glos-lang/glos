get_errno :: inline () -> Errno {
    errno := *get_errno_pointer()
    if errno == 0 {
        return null
    }
    return Errno.EPERM + Errno(errno - 1)
}

set_errno :: inline (errno: Errno) {
    *get_errno_pointer() = s32(errno)
}

