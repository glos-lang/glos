new :: ($T: Type, n := 1, allocator := default_allocator, zeroed := true) -> &T {
    return &T(allocator.alloc(n * sizeof(T), zeroed = zeroed))
}

free :: (p: &$T, allocator := default_allocator) {
    allocator.alloc(0, old = rawptr(p))
}

resize :: (p: &$T, size: s64, allocator := default_allocator) -> &T {
    return &T(allocator.alloc(size * sizeof(T), old = rawptr(p)))
}

zero :: (v: &$T, count := 1) -> &T {
    return &T(C.memset(rawptr(v), 0, C.size_t(count) * sizeof(T)))
}

copy :: (dst: &$T, src: &T, count := 1, $overlaps := true) -> &T {
    #if overlaps {
        return &T(C.memmove(rawptr(dst), rawptr(src), C.size_t(count) * sizeof(T)))
    } else {
        return &T(C.memcpy(rawptr(dst), rawptr(src), C.size_t(count) * sizeof(T)))
    }
}

clone :: (v: $T, allocator := default_allocator) -> &T {
    return &T(C.memcpy(allocator.alloc(sizeof(T), zeroed = false), rawptr(&v), sizeof(v)))
}

C :: #import "C"
