    IsFontValid :: (font: Font) -> bool // Check if a font is valid (font data loaded, WARNING: GPU texture not checked)
    LoadFontData :: (fileData: &C.unsigned_char, dataSize: C.int, fontSize: C.int, codepoints: &C.int, codepointCount: C.int, type: C.int, glyphCount: &C.int) -> &GlyphInfo // Load font data for further use
    GenImageFontAtlas :: (glyphs: &GlyphInfo, glyphRecs: &&Rectangle, glyphCount: C.int, fontSize: C.int, padding: C.int, packMethod: C.int) -> Image // Generate image font atlas using chars info
