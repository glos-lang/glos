    DrawTriangle3D :: (v1: Vector3, v2: Vector3, v3: Vector3, color: Color) // Draw a color-filled triangle (vertex in counter-clockwise order!)
    DrawTriangleStrip3D :: (points: &Vector3, pointCount: C.int, color: Color) // Draw a triangle strip defined by points
