    F10 = 299 // Key: F10
    F11 = 300 // Key: F11
    F12 = 301 // Key: F12
    LEFT_SHIFT = 340 // Key: Shift left
    LEFT_CONTROL = 341 // Key: Control left
    LEFT_ALT = 342 // Key: Alt left
    LEFT_SUPER = 343 // Key: Super left
