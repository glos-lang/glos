    DrawTextEx :: (font: Font, text: &C.char, position: Vector2, fontSize: C.float, spacing: C.float, tint: Color) // Draw text using font and additional parameters
    DrawTextPro :: (font: Font, text: &C.char, position: Vector2, origin: Vector2, rotation: C.float, fontSize: C.float, spacing: C.float, tint: Color) // Draw text using Font and pro parameters (rotation)
    DrawTextCodepoint :: (font: Font, codepoint: C.int, position: Vector2, fontSize: C.float, tint: Color) // Draw one character (codepoint)
    DrawTextCodepoints :: (font: Font, codepoints: &C.int, codepointCount: C.int, position: Vector2, fontSize: C.float, spacing: C.float, tint: Color) // Draw multiple character (codepoint)
    SetTextLineSpacing :: (spacing: C.int) // Set vertical line spacing when drawing with line-breaks
    MeasureText :: (text: &C.char, fontSize: C.int) -> C.int // Measure string width for default font
    MeasureTextEx :: (font: Font, text: &C.char, fontSize: C.float, spacing: C.float) -> Vector2 // Measure string size for Font
    MeasureTextCodepoints :: (font: Font, codepoints: &C.int, length: C.int, fontSize: C.float, spacing: C.float) -> Vector2 // Measure string size for an existing array of codepoints for Font
    GetGlyphIndex :: (font: Font, codepoint: C.int) -> C.int // Get glyph index position in font for a codepoint (unicode character), fallback to '?' if not found
    GetGlyphInfo :: (font: Font, codepoint: C.int) -> GlyphInfo // Get glyph font info data for a codepoint (unicode character), fallback to '?' if not found
    GetGlyphAtlasRec :: (font: Font, codepoint: C.int) -> Rectangle // Get glyph rectangle in font atlas for a codepoint (unicode character), fallback to '?' if not found
    LoadUTF8 :: (codepoints: &C.int, length: C.int) -> &C.char // Load UTF-8 text encoded from codepoints array
    UnloadUTF8 :: (text: &C.char) // Unload UTF-8 text encoded from codepoints array
    LoadCodepoints :: (text: &C.char, count: &C.int) -> &C.int // Load all codepoints from a UTF-8 text string, codepoints count returned by parameter
    UnloadCodepoints :: (codepoints: &C.int) // Unload codepoints data from memory
    GetCodepointCount :: (text: &C.char) -> C.int // Get total number of codepoints in a UTF-8 encoded string
    GetCodepoint :: (text: &C.char, codepointSize: &C.int) -> C.int // Get next codepoint in a UTF-8 encoded string, 0x3f('?') is returned on failure
    GetCodepointNext :: (text: &C.char, codepointSize: &C.int) -> C.int // Get next codepoint in a UTF-8 encoded string, 0x3f('?') is returned on failure
    GetCodepointPrevious :: (text: &C.char, codepointSize: &C.int) -> C.int // Get previous codepoint in a UTF-8 encoded string, 0x3f('?') is returned on failure
    CodepointToUTF8 :: (codepoint: C.int, utf8Size: &C.int) -> &C.char // Encode one codepoint into UTF-8 byte array (array length returned as parameter)
    LoadTextLines :: (text: &C.char, count: &C.int) -> &&C.char // Load text as separate lines ('\n')
    UnloadTextLines :: (text: &&C.char, lineCount: C.int) // Unload text lines
    TextCopy :: (dst: &C.char, src: &C.char) -> C.int // Copy one string to another, returns bytes copied
    TextIsEqual :: (text1: &C.char, text2: &C.char) -> bool // Check if two text string are equal
    TextLength :: (text: &C.char) -> C.unsigned_int // Get text length, checks for '\0' ending
    TextFormat :: (text: &C.char, ...) -> &C.char // Text formatting with variables (sprintf() style)
    TextSubtext :: (text: &C.char, position: C.int, length: C.int) -> &C.char // Get a piece of a text string
    TextRemoveSpaces :: (text: &C.char) -> &C.char // Remove text spaces, concat words
    GetTextBetween :: (text: &C.char, begin: &C.char, end: &C.char) -> &C.char // Get text between two strings
    TextReplace :: (text: &C.char, search: &C.char, replacement: &C.char) -> &C.char // Replace text string with new string
    TextReplaceAlloc :: (text: &C.char, search: &C.char, replacement: &C.char) -> &C.char // Replace text string with new string, memory must be MemFree()
    TextReplaceBetween :: (text: &C.char, begin: &C.char, end: &C.char, replacement: &C.char) -> &C.char // Replace text between two specific strings
    TextReplaceBetweenAlloc :: (text: &C.char, begin: &C.char, end: &C.char, replacement: &C.char) -> &C.char // Replace text between two specific strings, memory must be MemFree()
    TextInsert :: (text: &C.char, insert: &C.char, position: C.int) -> &C.char // Insert text in a defined byte position
    TextInsertAlloc :: (text: &C.char, insert: &C.char, position: C.int) -> &C.char // Insert text in a defined byte position, memory must be MemFree()
    TextJoin :: (textList: &&C.char, count: C.int, delimiter: &C.char) -> &C.char // Join text strings with delimiter
    TextSplit :: (text: &C.char, delimiter: C.char, count: &C.int) -> &&C.char // Split text into multiple strings, using MAX_TEXTSPLIT_COUNT static strings
    TextAppend :: (text: &C.char, append: &C.char, position: &C.int) // Append text at specific position and move cursor
    TextFindIndex :: (text: &C.char, search: &C.char) -> C.int // Find first text occurrence within a string, -1 if not found
    TextToUpper :: (text: &C.char) -> &C.char // Get upper case version of provided string
    TextToLower :: (text: &C.char) -> &C.char // Get lower case version of provided string
    TextToPascal :: (text: &C.char) -> &C.char // Get Pascal case notation version of provided string
    TextToSnake :: (text: &C.char) -> &C.char // Get Snake case notation version of provided string
    TextToCamel :: (text: &C.char) -> &C.char // Get Camel case notation version of provided string
    TextToInteger :: (text: &C.char) -> C.int // Get integer value from text
    TextToFloat :: (text: &C.char) -> C.float // Get float value from text
