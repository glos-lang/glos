    DrawTextureV :: (texture: Texture2D, position: Vector2, tint: Color) // Draw a Texture2D with position defined as Vector2
    DrawTextureEx :: (texture: Texture2D, position: Vector2, rotation: C.float, scale: C.float, tint: Color) // Draw a Texture2D with extended parameters
    DrawTextureRec :: (texture: Texture2D, source: Rectangle, position: Vector2, tint: Color) // Draw a part of a texture defined by a rectangle
    DrawTexturePro :: (texture: Texture2D, source: Rectangle, dest: Rectangle, origin: Vector2, rotation: C.float, tint: Color) // Draw a part of a texture defined by a rectangle with 'pro' parameters
    DrawTextureNPatch :: (texture: Texture2D, nPatchInfo: NPatchInfo, dest: Rectangle, origin: Vector2, rotation: C.float, tint: Color) // Draws a texture (or part of it) that stretches or shrinks nicely
    ColorIsEqual :: (col1: Color, col2: Color) -> bool // Check if two colors are equal
    Fade :: (color: Color, alpha: C.float) -> Color // Get color with alpha applied, alpha goes from 0.0f to 1.0f
    ColorToInt :: (color: Color) -> C.int // Get hexadecimal value for a Color (0xRRGGBBAA)
    ColorNormalize :: (color: Color) -> Vector4 // Get Color normalized as float [0..1]
    ColorFromNormalized :: (normalized: Vector4) -> Color // Get Color from normalized values [0..1]
    ColorToHSV :: (color: Color) -> Vector3 // Get HSV values for a Color, hue [0..360], saturation/value [0..1]
    ColorFromHSV :: (hue: C.float, saturation: C.float, value: C.float) -> Color // Get a Color from HSV values, hue [0..360], saturation/value [0..1]
    ColorTint :: (color: Color, tint: Color) -> Color // Get color multiplied with another color
    ColorBrightness :: (color: Color, factor: C.float) -> Color // Get color with brightness correction, brightness factor goes from -1.0f to 1.0f
    ColorContrast :: (color: Color, contrast: C.float) -> Color // Get color with contrast correction, contrast values between -1.0f and 1.0f
    ColorAlpha :: (color: Color, alpha: C.float) -> Color // Get color with alpha applied, alpha goes from 0.0f to 1.0f
    ColorAlphaBlend :: (dst: Color, src: Color, tint: Color) -> Color // Get src alpha-blended into dst color with tint
    ColorLerp :: (color1: Color, color2: Color, factor: C.float) -> Color // Get color lerp interpolation between two colors, factor [0.0f..1.0f]
    GetColor :: (hexValue: C.unsigned_int) -> Color // Get Color structure from hexadecimal value
    GetPixelColor :: (srcPtr: rawptr, format: C.int) -> Color // Get Color from a source pixel pointer of certain format
    SetPixelColor :: (dstPtr: rawptr, color: Color, format: C.int) // Set color formatted into destination pixel pointer
    GetPixelDataSize :: (width: C.int, height: C.int, format: C.int) -> C.int // Get pixel data size in bytes for certain format
    GetFontDefault :: () -> Font // Get the default Font
    LoadFont :: (fileName: &C.char) -> Font // Load font from file into GPU memory (VRAM)
    LoadFontEx :: (fileName: &C.char, fontSize: C.int, codepoints: &C.int, codepointCount: C.int) -> Font // Load font from file with extended parameters, use NULL for codepoints and 0 for codepointCount to load the default character set, font size is provided in pixels height
    LoadFontFromImage :: (image: Image, key: Color, firstChar: C.int) -> Font // Load font from Image (XNA style)
