    LoadMaterialDefault :: () -> Material // Load default material (Supports: DIFFUSE, SPECULAR, NORMAL maps)
    IsMaterialValid :: (material: Material) -> bool // Check if a material is valid (shader assigned, map textures loaded in GPU)
    UnloadMaterial :: (material: Material) // Unload material from GPU memory (VRAM)
