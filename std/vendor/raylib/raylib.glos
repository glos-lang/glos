    GenMeshHemiSphere :: (radius: C.float, rings: C.int, slices: C.int) -> Mesh // Generate half-sphere mesh (no bottom cap)
    GenMeshCylinder :: (radius: C.float, height: C.float, slices: C.int) -> Mesh // Generate cylinder mesh
    GenMeshCone :: (radius: C.float, height: C.float, slices: C.int) -> Mesh // Generate cone/pyramid mesh
