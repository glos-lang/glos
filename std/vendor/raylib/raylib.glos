    DrawCylinderWires :: (position: Vector3, radiusTop: C.float, radiusBottom: C.float, height: C.float, slices: C.int, color: Color) // Draw a cylinder/cone wires
    DrawCylinderWiresEx :: (startPos: Vector3, endPos: Vector3, startRadius: C.float, endRadius: C.float, sides: C.int, color: Color) // Draw a cylinder wires with base at startPos and top at endPos
    DrawCapsule :: (startPos: Vector3, endPos: Vector3, radius: C.float, slices: C.int, rings: C.int, color: Color) // Draw a capsule with the center of its sphere caps at startPos and endPos
    DrawCapsuleWires :: (startPos: Vector3, endPos: Vector3, radius: C.float, slices: C.int, rings: C.int, color: Color) // Draw capsule wireframe with the center of its sphere caps at startPos and endPos
