//////////////////////////////////////////////////////////////////////////////
//
// TEXTURE BAKING API
//
// If you use this API, you only have to call two functions ever.
//

Baked_Char :: struct {
    x0, y0, x1, y1: C.unsigned_short // coordinates of bbox in bitmap
    xoff, yoff, xadvance: C.float
}

Aligned_Quad :: struct {
    x0, y0, s0, t0: C.float // top-left
    x1, y1, s1, t1: C.float // bottom-right
}

extern {
    // if return is positive, the first unused row of the bitmap
    // if return is negative, returns the negative of the number of characters that fit
    // if return is 0, no characters fit and no rows were used
    // This uses a very crappy packing.
    #link "stbtt_BakeFontBitmap"
    BakeFontBitmap :: (data: &C.unsigned_char, offset: C.int,              // font location (use offset=0 for plain .ttf)
                           pixel_height: C.float,                          // height of font in pixels
                           pixels: &C.unsigned_char, pw: C.int, ph: C.int, // bitmap to be filled in
                           first_char: C.int, num_chars: C.int,            // characters to bake
                           chardata: &Baked_Char,                          // you allocate this, it's num_chars long
    ) -> C.int

    // Call GetBakedQuad with char_index = 'character - first_char', and it
    // creates the quad you need to draw and advances the current position.
    //
    // The coordinate system used assumes y increases downwards.
    //
    // Characters will extend both above and below the current position;
    // see discussion of "BASELINE" above.
    //
    // It's inefficient; you might want to c&p it and optimize it.
    #link "stbtt_GetBakedQuad"
    GetBakedQuad :: (
        chardata: &Baked_Char, pw: C.int, ph: C.int, // same data as above
        char_index: C.int,                           // character to display
        xpos: &C.float, ypos: &C.float,              // pointers to current position in screen pixel space
        q: &Aligned_Quad,                            // output: quad to draw
        opengl_fillrule: C.int,                      // true if opengl fill rule; false if DX9 or earlier
    )

    // Query the font vertical metrics without having to create a font first.
    #link "stbtt_GetScaledFontVMetrics"
    GetScaledFontVMetrics :: (fontdata: &C.unsigned_char, index: C.int, size: C.float, ascent: &C.float, descent: &C.float, lineGap: &C.float)

}

//////////////////////////////////////////////////////////////////////////////
//
// NEW TEXTURE BAKING API
//
// This provides options for packing multiple fonts into one atlas, not
// perfectly but better than nothing.

Packed_Char :: struct {
    x0, y0, x1, y1:       C.unsigned_short
    xoff, yoff, xadvance: C.float
    xoff2, yoff2:         C.float
}

Pack_Range :: struct {
    font_size:                        C.float
    first_unicode_codepoint_in_range: C.int
    array_of_unicode_codepoints:      &rune
    num_chars:                        C.int
    chardata_for_range:               &Packed_Char
    h_oversample, v_oversample:       C.unsigned_char // used internally to store oversample info
}

Pack_Context :: struct {
    user_allocator_context, pack_info:       rawptr
    width, height, stride_in_bytes, padding: C.int
    skip_missing:                            C.int
    h_oversample, v_oversample:              C.unsigned_int
    pixels:                                  &C.unsigned_char
    nodes:                                   rawptr
}

POINT_SIZE :: inline (x: $T) -> T { return -x } // @NOTE: this was a macro

extern {
    // Initializes a packing context stored in the passed-in stbtt_pack_context.
    // Future calls using this context will pack characters into the bitmap passed
    // in here: a 1-channel bitmap that is width * height. stride_in_bytes is
    // the distance from one row to the next (or 0 to mean they are packed tightly
    // together). "padding" is the amount of padding to leave between each
    // character (normally you want '1' for bitmaps you'll use as textures with
    // bilinear filtering).
    //
    // Returns 0 on failure, 1 on success.
    #link "stbtt_PackBegin"
    PackBegin :: (spc: &Pack_Context, pixels: &C.unsigned_char, width: C.int, height: C.int, stride_in_bytes: C.int, padding: C.int, alloc_context: rawptr) -> C.int

    // Cleans up the packing context and frees all memory.
    #link "stbtt_PackEnd"
    PackEnd :: (spc: &Pack_Context)

    // Creates character bitmaps from the font_index'th font found in fontdata (use
    // font_index=0 if you don't know what that is). It creates num_chars_in_range
    // bitmaps for characters with unicode values starting at first_unicode_char_in_range
    // and increasing. Data for how to render them is stored in chardata_for_range;
    // pass these to stbtt_GetPackedQuad to get back renderable quads.
    //
    // font_size is the full height of the character from ascender to descender,
    // as computed by stbtt_ScaleForPixelHeight. To use a point size as computed
    // by stbtt_ScaleForMappingEmToPixels, wrap the point size in POINT_SIZE()
    // and pass that result as 'font_size':
    //       ...,            20 , ... // font max minus min y is 20 pixels tall
    //       ..., POINT_SIZE(20), ... // 'M' is 20 pixels tall
    //
    // Returns 0 on failure, 1 on success.
    #link "stbtt_PackFontRange"
    PackFontRange :: (spc: &Pack_Context, fontdata: &C.unsigned_char, font_index: C.int, font_size: C.float, first_unicode_char_in_range: C.int, num_chars_in_range: C.int, chardata_for_range: &Packed_Char) -> C.int

    // Creates character bitmaps from multiple ranges of characters stored in
    // ranges. This will usually create a better-packed bitmap than multiple
    // calls to stbtt_PackFontRange. Note that you can call this multiple
    // times within a single PackBegin/PackEnd.
    //
    // Returns 0 on failure, 1 on success.
    #link "stbtt_PackFontRanges"
    PackFontRanges :: (spc: &Pack_Context, fontdata: &C.unsigned_char, font_index: C.int, ranges: &Pack_Range, num_ranges: C.int) -> C.int

    // Oversampling a font increases the quality by allowing higher-quality subpixel
    // positioning, and is especially valuable at smaller text sizes.
    //
    // This function sets the amount of oversampling for all following calls to
    // stbtt_PackFontRange(s) or stbtt_PackFontRangesGatherRects for a given
    // pack context. The default (no oversampling) is achieved by h_oversample=1
    // and v_oversample=1. The total number of pixels required is
    // h_oversample*v_oversample larger than the default; for example, 2x2
    // oversampling requires 4x the storage of 1x1. For best results, render
    // oversampled textures with bilinear filtering. Look at the readme in
    // stb/tests/oversample for information about oversampled fonts
    //
    // To use with PackFontRangesGather etc., you must set it before calls
    // call to PackFontRangesGatherRects.
    #link "stbtt_PackSetOversampling"
    PackSetOversampling :: (spc: &Pack_Context, h_oversample: C.unsigned_int, v_oversample: C.unsigned_int)

    // If skip != false, this tells stb_truetype to skip any codepoints for which
    // there is no corresponding glyph. If skip=false, which is the default, then
    // codepoints without a glyph recived the font's "missing character" glyph,
    // typically an empty box by convention.
    #link "stbtt_PackSetSkipMissingCodepoints"
    PackSetSkipMissingCodepoints :: (spc: &Pack_Context, skip: C.int)

    #link "stbtt_GetPackedQuad"
    GetPackedQuad :: (
        chardata: &Packed_Char, pw: C.int, ph: C.int, // same data as above
        char_index: C.int,                            // character to display
        xpos: &C.float, ypos: &C.float,               // pointers to current position in screen pixel space
        q: &Aligned_Quad,                             // output: quad to draw
        align_to_integer: C.int,
    )

    // Calling these functions in sequence is roughly equivalent to calling
    // stbtt_PackFontRanges(). If you more control over the packing of multiple
    // fonts, or if you want to pack custom data into a font texture, take a look
    // at the source to of stbtt_PackFontRanges() and create a custom version
    // using these functions, e.g. call GatherRects multiple times,
    // building up a single array of rects, then call PackRects once,
    // then call RenderIntoRects repeatedly. This may result in a
    // better packing than calling PackFontRanges multiple times
    // (or it may not).
    //
    // Returns the number of rects which were not skipped.
    // PackSetSkipMissingCodepoints controls this behavior.
    #link "stbtt_PackFontRangesGatherRects"
    PackFontRangesGatherRects :: (spc: &Pack_Context, info: &Font_Info, ranges: &Pack_Range, num_ranges: C.int, rects: &stbrp.Rect) -> C.int

    #link "stbtt_PackFontRangesPackRects"
    PackFontRangesPackRects :: (spc: &Pack_Context, rects: &stbrp.Rect, num_rects: C.int)

    // Returns 0 on failure, 1 on success.
    #link "stbtt_PackFontRangesRenderIntoRects"
    PackFontRangesRenderIntoRects :: (spc: &Pack_Context, info: &Font_Info, ranges: &Pack_Range, num_ranges: C.int, rects: &stbrp.Rect) -> C.int
}

//////////////////////////////////////////////////////////////////////////////
//
// FONT LOADING
//
//

Font_Info :: struct {
    userdata:  rawptr
    data:      &C.unsigned_char
    fontstart: C.int

    numGlyphs: C.int

    loca, head, glyf, hhea, hmtx, kern, gpos, svg: C.int
    index_map: C.int
    indexToLocFormat: C.int

    cff:         Buf
    charstrings: Buf
    gsubrs:      Buf
    subrs:       Buf
    fontdicts:   Buf
    fdselect:    Buf
}

extern {
    // Given an offset into the file that defines a font, this function builds
    // the necessary cached info for the rest of the system. You must allocate
    // the stbtt_fontinfo yourself, and stbtt_InitFont will fill it out. You don't
    // need to do anything special to free it, because the contents are pure
    // value data with no additional data structures. Returns 0 on failure.
    #link "stbtt_InitFont"
    InitFont :: (info: &Font_Info, data: &C.unsigned_char, offset: C.int) -> C.int

    // This function will determine the number of fonts in a font file.  TrueType
    // collection (.ttc) files may contain multiple fonts, while TrueType font
    // (.ttf) files only contain one font. The number of fonts can be used for
    // indexing with the previous function where the index is between zero and one
    // less than the total fonts. If an error occurs, -1 is returned.
    #link "stbtt_GetNumberOfFonts"
    GetNumberOfFonts :: (data: &C.unsigned_char) -> C.int

    // Each .ttf/.ttc file may have more than one font. Each font has a sequential
    // index number starting from 0. Call this function to get the font offset for
    // a given index; it returns -1 if the index is out of range. A regular .ttf
    // file will only define one font and it always be at offset 0, so it will
    // return '0' for index 0, and -1 for all other indices.
    #link "stbtt_GetFontOffsetForIndex"
    GetFontOffsetForIndex :: (data: &C.unsigned_char, index: C.int) -> C.int
}

//////////////////////////////////////////////////////////////////////////////
//
// CHARACTER TO GLYPH-INDEX CONVERSION

extern {
    // If you're going to perform multiple operations on the same character
    // and you want a speed-up, call this function with the character you're
    // going to process, then use glyph-based functions instead of the
    // codepoint-based functions.
    // Returns 0 if the character codepoint is not defined in the font.
    #link "stbtt_FindGlyphIndex"
    FindGlyphIndex :: (info: &Font_Info, unicode_codepoint: rune) -> C.int
}

//////////////////////////////////////////////////////////////////////////////
//
// CHARACTER PROPERTIES
//

extern {
    // computes a scale factor to produce a font whose "height" is 'pixels' tall.
    // Height is measured as the distance from the highest ascender to the lowest
    // descender; in other words, it's equivalent to calling stbtt_GetFontVMetrics
    // and computing:
    //       scale = pixels / (ascent - descent)
    // so if you prefer to measure height by the ascent only, use a similar calculation.
    #link "stbtt_ScaleForPixelHeight"
    ScaleForPixelHeight :: (info: &Font_Info, pixels: C.float) -> C.float

    // computes a scale factor to produce a font whose EM size is mapped to
    // 'pixels' tall. This is probably what traditional APIs compute, but
    // I'm not positive.
    #link "stbtt_ScaleForMappingEmToPixels"
    ScaleForMappingEmToPixels :: (info: &Font_Info, pixels: C.float) -> C.float

    // ascent is the coordinate above the baseline the font extends; descent
    // is the coordinate below the baseline the font extends (i.e. it is typically negative)
    // lineGap is the spacing between one row's descent and the next row's ascent...
    // so you should advance the vertical position by "*ascent - *descent + *lineGap"
    //   these are expressed in unscaled coordinates, so you must multiply by
    //   the scale factor for a given size
    #link "stbtt_GetFontVMetrics"
    GetFontVMetrics :: (info: &Font_Info, ascent: &C.int, descent: &C.int, lineGap: &C.int)

    // analogous to GetFontVMetrics, but returns the "typographic" values from the OS/2
    // table (specific to MS/Windows TTF files).
    //
    // Returns 1 on success (table present), 0 on failure.
    #link "stbtt_GetFontVMetricsOS2"
    GetFontVMetricsOS2 :: (info: &Font_Info, typoAscent: &C.int, typoDescent: &C.int, typoLineGap: &C.int) -> C.int

    // the bounding box around all possible characters
    #link "stbtt_GetFontBoundingBox"
    GetFontBoundingBox :: (info: &Font_Info, x0: &C.int, y0: &C.int, x1: &C.int, y1: &C.int)

    // leftSideBearing is the offset from the current horizontal position to the left edge of the character
    // advanceWidth is the offset from the current horizontal position to the next horizontal position
    //   these are expressed in unscaled coordinates
    #link "stbtt_GetCodepointHMetrics"
    GetCodepointHMetrics :: (info: &Font_Info, codepoint: rune, advanceWidth: &C.int, leftSideBearing: &C.int)

    // an additional amount to add to the 'advance' value between ch1 and ch2
    #link "stbtt_GetCodepointKernAdvance"
    GetCodepointKernAdvance :: (info: &Font_Info, ch1: rune, ch2: rune) -> C.int

    // Gets the bounding box of the visible part of the glyph, in unscaled coordinates
    #link "stbtt_GetCodepointBox"
    GetCodepointBox :: (info: &Font_Info, codepoint: rune, x0: &C.int, y0: &C.int, x1: &C.int, y1: &C.int) -> C.int

    // as above, but takes one or more glyph indices for greater efficiency
    #link "stbtt_GetGlyphHMetrics"
    GetGlyphHMetrics :: (info: &Font_Info, glyph_index: C.int, advanceWidth: &C.int, leftSideBearing: &C.int)

    #link "stbtt_GetGlyphKernAdvance"
    GetGlyphKernAdvance :: (info: &Font_Info, glyph1: C.int, glyph2: C.int) -> C.int

    #link "stbtt_GetGlyphBox"
    GetGlyphBox :: (info: &Font_Info, glyph_index: C.int, x0: &C.int, y0: &C.int, x1: &C.int, y1: &C.int) -> C.int
}

Kerning_Entry :: struct {
    glyph1:  rune // use FindGlyphIndex
    glyph2:  rune
    advance: C.int
}

extern {
    // Retrieves a complete list of all of the kerning pairs provided by the font
    // stbtt_GetKerningTable never writes more than table_length entries and returns how many entries it did write.
    // The table will be sorted by (a.glyph1 == b.glyph1)?(a.glyph2 < b.glyph2):(a.glyph1 < b.glyph1)
    #link "stbtt_GetKerningTableLength"
    GetKerningTableLength :: (info: &Font_Info) -> C.int

    #link "stbtt_GetKerningTable"
    GetKerningTable :: (info: &Font_Info, table: &Kerning_Entry, table_length: C.int) -> C.int
}


//////////////////////////////////////////////////////////////////////////////
//
// GLYPH SHAPES (you probably don't need these, but they have to go before
// the bitmaps for C declaration-order reasons)
//

Vmove :: enum C.int {
    none
    vmove = 1
    vline
    vcurve
    vcubic
}

Vertex :: struct {
    x, y, cx, cy, cx1, cy1: C.short
    type, padding:          C.unsigned_char
}

extern {
    // returns true if nothing is drawn for this glyph
    #link "stbtt_IsGlyphEmpty"
    IsGlyphEmpty :: (info: &Font_Info, glyph_index: C.int) -> C.int

    // returns # of vertices and fills *vertices with the pointer to them
    //   these are expressed in "unscaled" coordinates
    //
    // The shape is a series of contours. Each one starts with
    // a STBTT_moveto, then consists of a series of mixed
    // STBTT_lineto and STBTT_curveto segments. A lineto
    // draws a line from previous endpoint to its x,y; a curveto
    // draws a quadratic bezier from previous endpoint to
    // its x,y, using cx,cy as the bezier control point.
    #link "stbtt_GetCodepointShape"
    GetCodepointShape :: (info: &Font_Info, unicode_codepoint: rune, vertices: &&Vertex) -> C.int

    #link "stbtt_GetGlyphShape"
    GetGlyphShape :: (info: &Font_Info, glyph_index:      C.int, vertices: &&Vertex) -> C.int

    // frees the data allocated above
    #link "stbtt_FreeShape"
    FreeShape :: (info: &Font_Info, vertices: &Vertex)

    // fills svg with the character's SVG data.
    // returns data size or 0 if SVG not found.
    #link "stbtt_FindSVGDoc"
    FindSVGDoc :: (info: &Font_Info, gl: C.int) -> &C.unsigned_char

    #link "stbtt_GetCodepointSVG"
    GetCodepointSVG  :: (info: &Font_Info, unicode_codepoint: rune, svg: &&C.char) -> C.int

    #link "stbtt_GetGlyphSVG"
    GetGlyphSVG :: (info: &Font_Info, gl: C.int, svg: &&C.char) -> C.int
}


//////////////////////////////////////////////////////////////////////////////
//
// BITMAP RENDERING
//

Bitmap :: struct {
    w, h, stride: C.int
    pixels: &C.unsigned_char
}

extern {
    // frees the bitmap allocated below
    #link "stbtt_FreeBitmap"
    FreeBitmap :: (bitmap: &C.unsigned_char, userdata: rawptr)

    // allocates a large-enough single-channel 8bpp bitmap and renders the
    // specified character/glyph at the specified scale into it, with
    // antialiasing. 0 is no coverage (transparent), 255 is fully covered (opaque).
    // *width & *height are filled out with the width & height of the bitmap,
    // which is stored left-to-right, top-to-bottom.
    //
    // xoff/yoff are the offset it pixel space from the glyph origin to the top-left of the bitmap
    #link "stbtt_GetCodepointBitmap"
    GetCodepointBitmap :: (info: &Font_Info, scale_x: C.float, scale_y: C.float, codepoint: rune, width: &C.int, height: &C.int, xoff: &C.int, yoff: &C.int) -> &C.unsigned_char

    // the same as stbtt_GetCodepoitnBitmap, but you can specify a subpixel
    // shift for the character
    #link "stbtt_GetCodepointBitmapSubpixel"
    GetCodepointBitmapSubpixel :: (info: &Font_Info, scale_x: C.float, scale_y: C.float, shift_x: C.float, shift_y: C.float, codepoint: rune, width: &C.int, height: &C.int, xoff: &C.int, yoff: &C.int) -> &C.unsigned_char

    // the same as stbtt_GetCodepointBitmap, but you pass in storage for the bitmap
    // in the form of 'output', with row spacing of 'out_stride' bytes. the bitmap
    // is clipped to out_w/out_h bytes. Call stbtt_GetCodepointBitmapBox to get the
    // width and height and positioning info for it first.
    #link "stbtt_MakeCodepointBitmap"
    MakeCodepointBitmap :: (info: &Font_Info, output: &C.unsigned_char, out_w: C.int, out_h: C.int, out_stride: C.int, scale_x: C.float, scale_y: C.float, codepoint: rune)

    // same as stbtt_MakeCodepointBitmap, but you can specify a subpixel
    // shift for the character
    #link "stbtt_MakeCodepointBitmapSubpixel"
    MakeCodepointBitmapSubpixel :: (info: &Font_Info, output: &C.unsigned_char, out_w: C.int, out_h: C.int, out_stride: C.int, scale_x: C.float, scale_y: C.float, shift_x: C.float, shift_y: C.float, codepoint: rune)

    // same as stbtt_MakeCodepointBitmapSubpixel, but prefiltering
    // is performed (see stbtt_PackSetOversampling)
    #link "stbtt_MakeCodepointBitmapSubpixelPrefilter"
    MakeCodepointBitmapSubpixelPrefilter :: (info: &Font_Info, output: &C.unsigned_char, out_w: C.int, out_h: C.int, out_stride: C.int, scale_x: C.float, scale_y: C.float, shift_x: C.float, shift_y: C.float, oversample_x: C.int, oversample_y: C.int, sub_x: &C.float, sub_y: &C.float, codepoint: rune)

    // get the bbox of the bitmap centered around the glyph origin; so the
    // bitmap width is ix1-ix0, height is iy1-iy0, and location to place
    // the bitmap top left is (leftSideBearing*scale,iy0).
    // (Note that the bitmap uses y-increases-down, but the shape uses
    // y-increases-up, so CodepointBitmapBox and CodepointBox are inverted.)
    #link "stbtt_GetCodepointBitmapBox"
    GetCodepointBitmapBox :: (font: &Font_Info, codepoint: rune, scale_x: C.float, scale_y: C.float, ix0: &C.int, iy0: &C.int, ix1: &C.int, iy1: &C.int)

    // same as stbtt_GetCodepointBitmapBox, but you can specify a subpixel
    // shift for the character
    #link "stbtt_GetCodepointBitmapBoxSubpixel"
    GetCodepointBitmapBoxSubpixel :: (font: &Font_Info, codepoint: rune, scale_x: C.float, scale_y: C.float, shift_x: C.float, shift_y: C.float, ix0: &C.int, iy0: &C.int, ix1: &C.int, iy1: &C.int)

    // the following functions are equivalent to the above functions, but operate
    // on glyph indices instead of Unicode codepoints (for efficiency)
    #link "stbtt_GetGlyphBitmap"
    GetGlyphBitmap :: (info: &Font_Info, scale_x: C.float, scale_y: C.float, glyph: C.int, width: &C.int, height: &C.int, xoff: &C.int, yoff: &C.int) -> &C.unsigned_char

    #link "stbtt_GetGlyphBitmapSubpixel"
    GetGlyphBitmapSubpixel :: (info: &Font_Info, scale_x: C.float, scale_y: C.float, shift_x: C.float, shift_y: C.float, glyph: C.int, width: &C.int, height: &C.int, xoff: &C.int, yoff: &C.int) -> &C.unsigned_char

    #link "stbtt_MakeGlyphBitmap"
    MakeGlyphBitmap :: (info: &Font_Info, output: &C.unsigned_char, out_w: C.int, out_h: C.int, out_stride: C.int, scale_x: C.float, scale_y: C.float, glyph: C.int)

    #link "stbtt_MakeGlyphBitmapSubpixel"
    MakeGlyphBitmapSubpixel :: (info: &Font_Info, output: &C.unsigned_char, out_w: C.int, out_h: C.int, out_stride: C.int, scale_x: C.float, scale_y: C.float, shift_x: C.float, shift_y: C.float, glyph: C.int)

    #link "stbtt_MakeGlyphBitmapSubpixelPrefilter"
    MakeGlyphBitmapSubpixelPrefilter :: (info: &Font_Info, output: &C.unsigned_char, out_w: C.int, out_h: C.int, out_stride: C.int, scale_x: C.float, scale_y: C.float, shift_x: C.float, shift_y: C.float, oversample_x: C.int, oversample_y: C.int, sub_x: &C.float, sub_y: &C.float, glyph: C.int)

    #link "stbtt_GetGlyphBitmapBox"
    GetGlyphBitmapBox :: (font: &Font_Info, glyph: C.int, scale_x: C.float, scale_y: C.float, ix0: &C.int, iy0: &C.int, ix1: &C.int, iy1: &C.int)

    #link "stbtt_GetGlyphBitmapBoxSubpixel"
    GetGlyphBitmapBoxSubpixel :: (font: &Font_Info, glyph: C.int, scale_x: C.float, scale_y: C.float, shift_x: C.float, shift_y: C.float, ix0: &C.int, iy0: &C.int, ix1: &C.int, iy1: &C.int)

    // rasterize a shape with quadratic beziers into a bitmap
    #link "stbtt_Rasterize"
    Rasterize :: (
        result: &Bitmap,                    // 1-channel bitmap to draw into
        flatness_in_pixels: C.float,        // allowable error of curve in pixels
        vertices: &Vertex,                  // array of vertices defining shape
        num_verts: C.int,                   // number of vertices in above array
        scale_x: C.float, scale_y: C.float, // scale applied to input vertices
        shift_x: C.float, shift_y: C.float, // translation applied to input vertices
        x_off: C.int, y_off: C.int,         // another translation applied to input
        invert: C.int,                      // if non-zero, vertically flip shape
        userdata: rawptr,                   // context for to STBTT_MALLOC
    )

}

//////////////////////////////////////////////////////////////////////////////
//
// Signed Distance Function (or Field) rendering
//

extern {
    // frees the SDF bitmap allocated below
    #link "stbtt_FreeSDF"
    FreeSDF :: (bitmap: &C.unsigned_char, userdata: rawptr)

    // These functions compute a discretized SDF field for a single character, suitable for storing
    // in a single-channel texture, sampling with bilinear filtering, and testing against
    // larger than some threshold to produce scalable fonts.
    //        info              --  the font
    //        scale             --  controls the size of the resulting SDF bitmap, same as it would be creating a regular bitmap
    //        glyph/codepoint   --  the character to generate the SDF for
    //        padding           --  extra "pixels" around the character which are filled with the distance to the character (not 0),
    //                                 which allows effects like bit outlines
    //        onedge_value      --  value 0-255 to test the SDF against to reconstruct the character (i.e. the isocontour of the character)
    //        pixel_dist_scale  --  what value the SDF should increase by when moving one SDF "pixel" away from the edge (on the 0..255 scale)
    //                                 if positive, > onedge_value is inside; if negative, < onedge_value is inside
    //        width,height      --  output height & width of the SDF bitmap (including padding)
    //        xoff,yoff         --  output origin of the character
    //        return value      --  a 2D array of bytes 0..255, width*height in size
    //
    // pixel_dist_scale & onedge_value are a scale & bias that allows you to make
    // optimal use of the limited 0..255 for your application, trading off precision
    // and special effects. SDF values outside the range 0..255 are clamped to 0..255.
    //
    // Example:
    //      scale = stbtt_ScaleForPixelHeight(22)
    //      padding = 5
    //      onedge_value = 180
    //      pixel_dist_scale = 180/5.0 = 36.0
    //
    //      This will create an SDF bitmap in which the character is about 22 pixels
    //      high but the whole bitmap is about 22+5+5=32 pixels high. To produce a filled
    //      shape, sample the SDF at each pixel and fill the pixel if the SDF value
    //      is greater than or equal to 180/255. (You'll actually want to antialias,
    //      which is beyond the scope of this example.) Additionally, you can compute
    //      offset outlines (e.g. to stroke the character border inside & outside,
    //      or only outside). For example, to fill outside the character up to 3 SDF
    //      pixels, you would compare against (180-36.0*3)/255 = 72/255. The above
    //      choice of variables maps a range from 5 pixels outside the shape to
    //      2 pixels inside the shape to 0..255; this is intended primarily for apply
    //      outside effects only (the interior range is needed to allow proper
    //      antialiasing of the font at *smaller* sizes)
    //
    // The function computes the SDF analytically at each SDF pixel, not by e.g.
    // building a higher-res bitmap and approximating it. In theory the quality
    // should be as high as possible for an SDF of this size & representation, but
    // unclear if this is true in practice (perhaps building a higher-res bitmap
    // and computing from that can allow drop-out prevention).
    //
    // The algorithm has not been optimized at all, so expect it to be slow
    // if computing lots of characters or very large sizes.

    #link "stbtt_GetGlyphSDF"
    GetGlyphSDF :: (info: &Font_Info, scale: C.float, glyph: C.int, padding: C.int, onedge_value: u8, pixel_dist_scale: C.float, width: &C.int, height: &C.int, xoff: &C.int, yoff: &C.int) -> &C.unsigned_char

    #link "stbtt_GetCodepointSDF"
    GetCodepointSDF :: (info: &Font_Info, scale: C.float, codepoint: C.int, padding: C.int, onedge_value: u8, pixel_dist_scale: C.float, width: &C.int, height: &C.int, xoff: &C.int, yoff: &C.int) -> &C.unsigned_char
}

//////////////////////////////////////////////////////////////////////////////
//
// Finding the right font...
//
// You should really just solve this offline, keep your own tables
// of what font is what, and don't try to get it out of the .ttf file.
// That's because getting it out of the .ttf file is really hard, because
// the names in the file can appear in many possible encodings, in many
// possible languages, and e.g. if you need a case-insensitive comparison,
// the details of that depend on the encoding & language in a complex way
// (actually underspecified in truetype, but also gigantic).
//
// But you can use the provided functions in two possible ways:
//     stbtt_FindMatchingFont() will use *case-sensitive* comparisons on
//             unicode-encoded names to try to find the font you want;
//             you can run this before calling stbtt_InitFont()
//
//     stbtt_GetFontNameString() lets you get any of the various strings
//             from the file yourself and do your own comparisons on them.
//             You have to have called stbtt_InitFont() first.

MACSTYLE_DONTCARE     :: 0
MACSTYLE_BOLD         :: 1
MACSTYLE_ITALIC       :: 2
MACSTYLE_UNDERSCORE   :: 4
MACSTYLE_NONE         :: 8   // <= not same as 0, this makes us check the bitfield is 0

extern {
    // returns the offset (not index) of the font that matches, or -1 if none
    //   if you use STBTT_MACSTYLE_DONTCARE, use a font name like "Arial Bold".
    //   if you use any other flag, use a font name like "Arial"; this checks
    //     the 'macStyle' header field; i don't know if fonts set this consistently
    #link "stbtt_FindMatchingFont"
    FindMatchingFont :: (fontdata: &C.unsigned_char, name: &C.char, flags: C.int) -> C.int

    // returns 1/0 whether the first string interpreted as utf8 is identical to
    // the second string interpreted as big-endian utf16... useful for strings from next func
    #link "stbtt_CompareUTF8toUTF16_bigendian"
    CompareUTF8toUTF16_bigendian :: (s1: &C.char, len1: C.int, s2: &C.char, len2: C.int) -> C.int

    // returns the string (which may be big-endian double byte, e.g. for unicode)
    // and puts the length in bytes in *length.
    //
    // some of the values for the IDs are below; for more see the truetype spec:
    //     http://developer.apple.com/textfonts/TTRefMan/RM06/Chap6name.html
    //     http://www.microsoft.com/typography/otspec/name.htm
    #link "stbtt_GetFontNameString"
    GetFontNameString :: (font: &Font_Info, length: &C.int, platformID: C.int, encodingID: C.int, languageID: C.int, nameID: C.int) -> &C.char
}

// platformID
PLATFORM_ID_UNICODE   :: 0
PLATFORM_ID_MAC       :: 1
PLATFORM_ID_ISO       :: 2
PLATFORM_ID_MICROSOFT :: 3

// encodingID for PLATFORM_ID_UNICODE
UNICODE_EID_UNICODE_1_0      :: 0
UNICODE_EID_UNICODE_1_1      :: 1
UNICODE_EID_ISO_10646        :: 2
UNICODE_EID_UNICODE_2_0_BMP  :: 3
UNICODE_EID_UNICODE_2_0_FULL :: 4

// encodingID for PLATFORM_ID_MICROSOFT
MS_EID_SYMBOL       :: 0
MS_EID_UNICODE_BMP  :: 1
MS_EID_SHIFTJIS     :: 2
MS_EID_UNICODE_FULL :: 10

// encodingID for PLATFORM_ID_MAC; same as Script Manager codes
MAC_EID_ROMAN,        MAC_EID_ARABIC  :: 0, 4
MAC_EID_JAPANESE,     MAC_EID_HEBREW  :: 1, 5
MAC_EID_CHINESE_TRAD, MAC_EID_GREEK   :: 2, 6
MAC_EID_KOREAN,       MAC_EID_RUSSIAN :: 3, 7

// languageID for PLATFORM_ID_MICROSOFT; same as LCID...
// problematic because there are e.g. 16 english LCIDs and 16 arabic LCIDs
MS_LANG_ENGLISH,  MS_LANG_ITALIAN  :: 0x0409, 0x0410
MS_LANG_CHINESE,  MS_LANG_JAPANESE :: 0x0804, 0x0411
MS_LANG_DUTCH,    MS_LANG_KOREAN   :: 0x0413, 0x0412
MS_LANG_FRENCH,   MS_LANG_RUSSIAN  :: 0x040c, 0x0419
MS_LANG_GERMAN,   MS_LANG_SPANISH  :: 0x0407, 0x0409
MS_LANG_HEBREW,   MS_LANG_SWEDISH  :: 0x040d, 0x041D

// languageID for PLATFORM_ID_MAC
MAC_LANG_ENGLISH, MAC_LANG_JAPANESE           :: 0,  11
MAC_LANG_ARABIC,  MAC_LANG_KOREAN             :: 12, 23
MAC_LANG_DUTCH,   MAC_LANG_RUSSIAN            :: 4,  32
MAC_LANG_FRENCH,  MAC_LANG_SPANISH            :: 1,  6
MAC_LANG_GERMAN,  MAC_LANG_SWEDISH            :: 2,  5
MAC_LANG_HEBREW,  MAC_LANG_CHINESE_SIMPLIFIED :: 10, 33
MAC_LANG_ITALIAN, MAC_LANG_CHINESE_TRAD       :: 3,  19

#private...
Buf :: struct {
    data:   &C.unsigned_char
    cursor: C.int
    size:   C.int
}

#if PLATFORM == {
case .LINUX
    #library "./stb_truetype.o"

case .MACOS
    #library "./stb_truetype.o"

case .WINDOWS
    #library "./stb_truetype.obj"
}

C     :: #import "C"
stbrp :: #import "vendor/stb_rect_pack"
