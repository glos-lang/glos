/**
 * Specifies the primitive topology of a graphics pipeline.
 *
 * If you are using POINTLIST you must include a point size output in the
 * vertex shader.
 *
 * - For HLSL compiling to SPIRV you must decorate a float output with
 *   [[vk::builtin("PointSize")]].
 * - For GLSL you must set the gl_PointSize builtin.
 * - For MSL you must include a float output with the [[point_size]]
 *   decorator.
 *
 * Note that sized point topology is totally unsupported on D3D12. Any size
 * other than 1 will be ignored. In general, you should avoid using point
 * topology for both compatibility and performance reasons. You WILL regret
 * using it.
 *
 * \since This enum is available since SDL 3.2.0.
 *
 * \sa SDL_CreateGPUGraphicsPipeline
 */
GPUPrimitiveType :: enum uint {
    /**< A series of separate triangles. */
    TRIANGLELIST = 0

    /**< A series of connected triangles. */
    TRIANGLESTRIP = 1

    /**< A series of separate lines. */
    LINELIST = 2

    /**< A series of connected lines. */
    LINESTRIP = 3

    /**< A series of separate points. */
    POINTLIST = 4
}

/**
 * Specifies how the contents of a texture attached to a render pass are
 * treated at the beginning of the render pass.
 *
 * \since This enum is available since SDL 3.2.0.
 *
 * \sa SDL_BeginGPURenderPass
 */
GPULoadOp :: enum uint {
    /**< The previous contents of the texture will be preserved. */
    LOAD = 0

    /**< The contents of the texture will be cleared to a color. */
    CLEAR = 1

    /**< The previous contents of the texture need not be preserved. The contents will be undefined. */
    DONT_CARE = 2
}

/**
 * Specifies how the contents of a texture attached to a render pass are
 * treated at the end of the render pass.
 *
 * \since This enum is available since SDL 3.2.0.
 *
 * \sa SDL_BeginGPURenderPass
 */
GPUStoreOp :: enum uint {
    /**< The contents generated during the render pass will be written to memory. */
    STORE = 0

    /**< The contents generated during the render pass are not needed and may be discarded. The contents will be undefined. */
    DONT_CARE = 1

    /**< The multisample contents generated during the render pass will be resolved to a non-multisample texture. The contents in the multisample texture may then be discarded and will be undefined. */
    RESOLVE = 2

    /**< The multisample contents generated during the render pass will be resolved to a non-multisample texture. The contents in the multisample texture will be written to memory. */
    RESOLVE_AND_STORE = 3
}

/**
 * Specifies the size of elements in an index buffer.
 *
 * \since This enum is available since SDL 3.2.0.
 *
 * \sa SDL_CreateGPUGraphicsPipeline
 */
GPUIndexElementSize :: enum uint {
    /**< The index elements are 16-bit. */
    _16BIT = 0

    /**< The index elements are 32-bit. */
    _32BIT = 1
}

/**
 * Specifies the pixel format of a texture.
 *
 * Texture format support varies depending on driver, hardware, and usage
 * flags. In general, you should use SDL_GPUTextureSupportsFormat to query if
 * a format is supported before using it. However, there are a few guaranteed
 * formats.
 *
 * FIXME: Check universal support for 32-bit component formats FIXME: Check
 * universal support for SIMULTANEOUS_READ_WRITE
 *
 * For SAMPLER usage, the following formats are universally supported:
 *
 * - R8G8B8A8_UNORM
 * - B8G8R8A8_UNORM
 * - R8_UNORM
 * - R8_SNORM
 * - R8G8_UNORM
 * - R8G8_SNORM
 * - R8G8B8A8_SNORM
 * - R16_FLOAT
 * - R16G16_FLOAT
 * - R16G16B16A16_FLOAT
 * - R32_FLOAT
 * - R32G32_FLOAT
 * - R32G32B32A32_FLOAT
 * - R11G11B10_UFLOAT
 * - R8G8B8A8_UNORM_SRGB
 * - B8G8R8A8_UNORM_SRGB
 * - D16_UNORM
 *
 * For COLOR_TARGET usage, the following formats are universally supported:
 *
 * - R8G8B8A8_UNORM
 * - B8G8R8A8_UNORM
 * - R8_UNORM
 * - R16_FLOAT
 * - R16G16_FLOAT
 * - R16G16B16A16_FLOAT
 * - R32_FLOAT
 * - R32G32_FLOAT
 * - R32G32B32A32_FLOAT
 * - R8_UINT
 * - R8G8_UINT
 * - R8G8B8A8_UINT
 * - R16_UINT
 * - R16G16_UINT
 * - R16G16B16A16_UINT
 * - R8_INT
 * - R8G8_INT
 * - R8G8B8A8_INT
 * - R16_INT
 * - R16G16_INT
 * - R16G16B16A16_INT
 * - R8G8B8A8_UNORM_SRGB
 * - B8G8R8A8_UNORM_SRGB
 *
 * For STORAGE usages, the following formats are universally supported:
 *
 * - R8G8B8A8_UNORM
 * - R8G8B8A8_SNORM
 * - R16G16B16A16_FLOAT
 * - R32_FLOAT
 * - R32G32_FLOAT
 * - R32G32B32A32_FLOAT
 * - R8G8B8A8_UINT
 * - R16G16B16A16_UINT
 * - R8G8B8A8_INT
 * - R16G16B16A16_INT
 *
 * For DEPTH_STENCIL_TARGET usage, the following formats are universally
 * supported:
 *
 * - D16_UNORM
 * - Either (but not necessarily both!) D24_UNORM or D32_FLOAT
 * - Either (but not necessarily both!) D24_UNORM_S8_UINT or D32_FLOAT_S8_UINT
 *
 * Unless D16_UNORM is sufficient for your purposes, always check which of
 * D24/D32 is supported before creating a depth-stencil texture!
 *
 * \since This enum is available since SDL 3.2.0.
 *
 * \sa SDL_CreateGPUTexture
 * \sa SDL_GPUTextureSupportsFormat
 */
GPUTextureFormat :: enum uint {
    INVALID = 0

    /* Unsigned Normalized Float Color Formats */
    A8_UNORM = 1

    /* Unsigned Normalized Float Color Formats */
    R8_UNORM = 2

    /* Unsigned Normalized Float Color Formats */
    R8G8_UNORM = 3

    /* Unsigned Normalized Float Color Formats */
    R8G8B8A8_UNORM = 4

    /* Unsigned Normalized Float Color Formats */
    R16_UNORM = 5

    /* Unsigned Normalized Float Color Formats */
    R16G16_UNORM = 6

    /* Unsigned Normalized Float Color Formats */
    R16G16B16A16_UNORM = 7

    /* Unsigned Normalized Float Color Formats */
    R10G10B10A2_UNORM = 8

    /* Unsigned Normalized Float Color Formats */
    B5G6R5_UNORM = 9

    /* Unsigned Normalized Float Color Formats */
    B5G5R5A1_UNORM = 10

    /* Unsigned Normalized Float Color Formats */
    B4G4R4A4_UNORM = 11

    /* Unsigned Normalized Float Color Formats */
    B8G8R8A8_UNORM = 12

    /* Compressed Unsigned Normalized Float Color Formats */
    BC1_RGBA_UNORM = 13

    /* Compressed Unsigned Normalized Float Color Formats */
    BC2_RGBA_UNORM = 14

    /* Compressed Unsigned Normalized Float Color Formats */
    BC3_RGBA_UNORM = 15

    /* Compressed Unsigned Normalized Float Color Formats */
    BC4_R_UNORM = 16

    /* Compressed Unsigned Normalized Float Color Formats */
    BC5_RG_UNORM = 17

    /* Compressed Unsigned Normalized Float Color Formats */
    BC7_RGBA_UNORM = 18

    /* Compressed Signed Float Color Formats */
    BC6H_RGB_FLOAT = 19

    /* Compressed Unsigned Float Color Formats */
    BC6H_RGB_UFLOAT = 20

    /* Signed Normalized Float Color Formats  */
    R8_SNORM = 21

    /* Signed Normalized Float Color Formats  */
    R8G8_SNORM = 22

    /* Signed Normalized Float Color Formats  */
    R8G8B8A8_SNORM = 23

    /* Signed Normalized Float Color Formats  */
    R16_SNORM = 24

    /* Signed Normalized Float Color Formats  */
    R16G16_SNORM = 25

    /* Signed Normalized Float Color Formats  */
    R16G16B16A16_SNORM = 26

    /* Signed Float Color Formats */
    R16_FLOAT = 27

    /* Signed Float Color Formats */
    R16G16_FLOAT = 28

    /* Signed Float Color Formats */
    R16G16B16A16_FLOAT = 29

    /* Signed Float Color Formats */
    R32_FLOAT = 30

    /* Signed Float Color Formats */
    R32G32_FLOAT = 31

    /* Signed Float Color Formats */
    R32G32B32A32_FLOAT = 32

    /* Unsigned Float Color Formats */
    R11G11B10_UFLOAT = 33

    /* Unsigned Integer Color Formats */
    R8_UINT = 34

    /* Unsigned Integer Color Formats */
    R8G8_UINT = 35

    /* Unsigned Integer Color Formats */
    R8G8B8A8_UINT = 36

    /* Unsigned Integer Color Formats */
    R16_UINT = 37

    /* Unsigned Integer Color Formats */
    R16G16_UINT = 38

    /* Unsigned Integer Color Formats */
    R16G16B16A16_UINT = 39

    /* Unsigned Integer Color Formats */
    R32_UINT = 40

    /* Unsigned Integer Color Formats */
    R32G32_UINT = 41

    /* Unsigned Integer Color Formats */
    R32G32B32A32_UINT = 42

    /* Signed Integer Color Formats */
    R8_INT = 43

    /* Signed Integer Color Formats */
    R8G8_INT = 44

    /* Signed Integer Color Formats */
    R8G8B8A8_INT = 45

    /* Signed Integer Color Formats */
    R16_INT = 46

    /* Signed Integer Color Formats */
    R16G16_INT = 47

    /* Signed Integer Color Formats */
    R16G16B16A16_INT = 48

    /* Signed Integer Color Formats */
    R32_INT = 49

    /* Signed Integer Color Formats */
    R32G32_INT = 50

    /* Signed Integer Color Formats */
    R32G32B32A32_INT = 51

    /* SRGB Unsigned Normalized Color Formats */
    R8G8B8A8_UNORM_SRGB = 52

    /* SRGB Unsigned Normalized Color Formats */
    B8G8R8A8_UNORM_SRGB = 53

    /* Compressed SRGB Unsigned Normalized Color Formats */
    BC1_RGBA_UNORM_SRGB = 54

    /* Compressed SRGB Unsigned Normalized Color Formats */
    BC2_RGBA_UNORM_SRGB = 55

    /* Compressed SRGB Unsigned Normalized Color Formats */
    BC3_RGBA_UNORM_SRGB = 56

