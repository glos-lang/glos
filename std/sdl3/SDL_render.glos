/**
 * The name of the software renderer.
 *
 * \since This macro is available since SDL 3.2.0.
 */
SOFTWARE_RENDERER :: "software"

/**
 * The name of the GPU renderer.
 *
 * \since This macro is available since SDL 3.4.0.
 */
GPU_RENDERER :: "gpu"

