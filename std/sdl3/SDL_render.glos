     *
     * \since This function is available since SDL 3.2.0.
     *
     * \sa SDL_GetRenderViewport
     * \sa SDL_RenderViewportSet
     */
    #link "SDL_SetRenderViewport"
    SetRenderViewport :: (renderer: &Renderer, rect: &Rect) -> bool

    /**
     * Get the drawing area for the current target.
     *
     * Each render target has its own viewport. This function gets the viewport
     * for the current render target.
     *
     * \param renderer the rendering context.
     * \param rect an Rect structure filled in with the current drawing area.
     * \returns true on success or false on failure; call SDL_GetError() for more
     *          information.
     *
     * \threadsafety This function should only be called on the main thread.
     *
     * \since This function is available since SDL 3.2.0.
     *
     * \sa SDL_RenderViewportSet
     * \sa SDL_SetRenderViewport
     */
    #link "SDL_GetRenderViewport"
    GetRenderViewport :: (renderer: &Renderer, rect: &Rect) -> bool

    /**
     * Return whether an explicit rectangle was set as the viewport.
