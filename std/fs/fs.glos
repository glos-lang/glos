read_entire_file :: (path: string, flags: os.Open_Flag = 0, allocator := default_allocator) -> []u8, error {
    f, err := os.open(path, .RDONLY | flags, 0)
    if err != null {
        return {}, err
    }
    defer f.close()

    offset, err := f.seek(0, .END)
    if err != null {
        return {}, err
    }
    f.rewind()

    data, err := allocator.alloc(offset + 1, zeroed = false)
    if err != null {
        return {}, err
    }
    bytes := []u8(&u8(data), offset + 1)

    n, err := f.read(bytes)
    if err != null {
        return bytes, err // TODO: A single read() might not read everything.
    }

    bytes[n] = 0
    bytes.count = n
    allocator.rewind(rawptr(bytes.data) + rawptr(n + 1))
    return bytes, null
}

os :: #import "os"
