read_entire_file :: (path: string, flags: os.Open_Flag = 0, allocator := default_allocator) -> []u8, error {
    f := os.open(path, .RDONLY | flags, 0)?
    defer f.close()

    offset := f.seek(0, .END)?
    f.rewind()

    data := allocator.alloc(offset + 1, zeroed = false)?
    bytes := []u8(&u8(data), offset + 1)

    n, err := f.read(bytes)
    if err != null {
        return bytes, err // TODO: A single read() might not read everything.
    }

    bytes[n] = 0
    bytes.count = n
    allocator.rewind(rawptr(bytes.data) + rawptr(n + 1))
    return bytes, null
}

os :: #import "os"
