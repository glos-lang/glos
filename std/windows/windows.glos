TRUE  :: 1
FALSE :: 0

MEM_COMMIT  :: 0x00001000
MEM_RELEASE :: 0x00008000
MEM_RESERVE :: 0x00002000

PAGE_READWRITE :: 0x04

INVALID_HANDLE_VALUE :: HANDLE(-1)

STD_INPUT_HANDLE  :: DWORD(s32(-10))
STD_OUTPUT_HANDLE :: DWORD(s32(-11))
STD_ERROR_HANDLE  :: DWORD(s32(-12))

HANDLE_FLAG_INHERIT :: 0x00000001

STARTF_USESTDHANDLES :: 0x00000100

FILE_READ_ATTRIBUTES     :: 0x0080
FILE_ATTRIBUTE_READONLY  :: 0x00000001
FILE_ATTRIBUTE_DIRECTORY :: 0x00000010

FILE_SHARE_READ   :: 0x00000001
FILE_SHARE_WRITE  :: 0x00000002
FILE_SHARE_DELETE :: 0x00000004

OPEN_EXISTING :: 3

FILE_TYPE_UNKNOWN :: 0x0000
FILE_TYPE_DISK    :: 0x0001
FILE_TYPE_CHAR    :: 0x0002
FILE_TYPE_PIPE    :: 0x0003
FILE_TYPE_REMOTE  :: 0x8000

FILE_FLAG_BACKUP_SEMANTICS :: 0x02000000

INFINITE :: 0xffffffff

WAIT_FAILED :: 0xFFFFFFFF

CREATE_WAITABLE_TIMER_HIGH_RESOLUTION :: 0x00000002
TIMER_ALL_ACCESS :: 0x001F0003
PTIMERAPCROUTINE :: (lpArgToCompletionRoutine: LPVOID, dwTimerLowValue: DWORD, dwTimerHighValue: DWORD)

SYMOPT_LOAD_LINES     :: 0x00000010
SYMOPT_UNDNAME        :: 0x00000002
SYMOPT_DEFERRED_LOADS :: 0x00000004

_WRITE_ABORT_MSG  :: 0x1
_CALL_REPORTFAULT :: 0x2

EXCEPTION_EXECUTE_HANDLER :: 0x1

SIGABRT :: 22

IMAGE_FILE_MACHINE_AMD64 :: 0x8664

extern {
    wcslen :: (str: &WCHAR) -> C.size_t
    _fileno :: (f: C.FILE) -> C.int
    _lseeki64 :: (fd: C.int, offset: s64, whence: C.int) -> s64
    _open :: (path: &C.char, flags: C.int, mode: C.unsigned_int) -> C.int
    _fdopen :: (fd: C.int, mode: &C.char) -> C.FILE
    _get_osfhandle :: (fd: C.int) -> HANDLE
    _open_osfhandle :: (osfhandle: C.intptr_t, flags: C.int) -> C.int
    __acrt_iob_func :: (fd: C.unsigned) -> C.FILE

    VirtualAlloc :: (lpAddress: LPVOID, dwSize: SIZE_T, flAllocationType: DWORD, flProtect: DWORD) -> LPVOID
    VirtualFree  :: (lpAddress: LPVOID, dwSize: SIZE_T, dwFreeType: DWORD) -> BOOL

    CreateProcessW :: (
        lpApplicationName: LPCWSTR,
        lpCommandLine: LPWSTR,
        lpProcessAttributes: LPSECURITY_ATTRIBUTES,
        lpThreadAttributes: LPSECURITY_ATTRIBUTES,
        bInheritHandles: BOOL,
        dwCreationFlags: DWORD,
        lpEnvironment: LPVOID,
        lpCurrentDirectory: LPCWSTR,
        lpStartupInfo: LPSTARTUPINFOW,
        lpProcessInformation: LPPROCESS_INFORMATION,
    ) -> BOOL

    CreatePipe :: (
        hReadPipe: PHANDLE,
        hWritePipe: PHANDLE,
        lpPipeAttributes: LPSECURITY_ATTRIBUTES,
        nSize: DWORD,
    ) -> BOOL

    CloseHandle :: (hObject: HANDLE) -> BOOL
    TerminateProcess :: (hProcess: HANDLE, uExitCode: UINT) -> BOOL

    GetStdHandle :: (nStdHandle: DWORD) -> HANDLE
    SetHandleInformation :: (
        hObject: HANDLE,
        dwMask: DWORD,
        dwFlags: DWORD
    ) -> BOOL

    WaitForSingleObject :: (hHandle: HANDLE, dwMilliseconds: DWORD) -> DWORD
    GetExitCodeProcess :: (hProcess: HANDLE, lpExitCode: LPDWORD) -> BOOL

    GetEnvironmentVariableW :: (lpName: LPCWSTR, lpBuffer: LPWSTR, nSize: DWORD) -> DWORD
    SetEnvironmentVariableW :: (lpName: LPCWSTR, lpValue: LPCWSTR) -> BOOL

    GetCurrentDirectoryW :: (nBufferLength: DWORD, lpBuffer: LPWSTR) -> DWORD
    SetCurrentDirectoryW :: (lpPathName: LPCWSTR) -> BOOL

    GetLastError :: () -> DWORD
    FormatMessageW :: (
        dwFlags: DWORD,
        lpSource: LPCVOID,
        dwMessageId: DWORD,
        dwLanguageId: DWORD,
        lpBuffer: LPWSTR,
        nSize: DWORD,
        arguments: rawptr
    ) -> DWORD

    FindFirstFileW :: (lpFileName: LPCWSTR, lpFindFileData: LPWIN32_FIND_DATAW) -> HANDLE
    FindNextFileW :: (hFindFile: HANDLE, lpFindFileData: LPWIN32_FIND_DATAW) -> BOOL
    FindClose :: (hFindFile: HANDLE) -> BOOL

    CreateFileW :: (
        lpFileName: LPCWSTR,
        dwDesiredAccess: DWORD,
        dwShareMode: DWORD,
        lpSecurityAttributes: LPSECURITY_ATTRIBUTES,
        dwCreationDisposition: DWORD,
        dwFlagsAndAttributes: DWORD,
        hTemplateFile: HANDLE
    ) -> HANDLE

    GetFileType :: (hFile: HANDLE) -> DWORD

    GetFileInformationByHandleEx :: (
        hFile: HANDLE,
        FileInformationClass: FILE_INFO_BY_HANDLE_CLASS,
        lpFileInformation: LPVOID,
        dwBufferSize: DWORD
    ) -> BOOL

    GetFileInformationByHandle :: (hFile: HANDLE, lpFileInformation: LPBY_HANDLE_FILE_INFORMATION) -> BOOL

    RemoveDirectoryW :: (lpPathName: LPCWSTR) -> BOOL
    CreateDirectoryW :: (lpPathName: LPCWSTR, lpSecurityAttributes: LPSECURITY_ATTRIBUTES) -> BOOL

    GetSystemTimePreciseAsFileTime :: (lpSystemTimeAsFileTime: LPFILETIME)

    QueryPerformanceCounter :: (lpPerformanceCount: &LARGE_INTEGER) -> BOOL
    QueryPerformanceFrequency :: (lpFrequency: &LARGE_INTEGER) -> BOOL

    FileTimeToLocalFileTime :: (lpFileTime: &FILETIME, lpLocalFileTime: LPFILETIME) -> BOOL
    FileTimeToSystemTime :: (lpFileTime: &FILETIME, lpSystemTime: LPSYSTEMTIME) -> BOOL

    SystemTimeToFileTime :: (lpSystemTime: &SYSTEMTIME, lpFileTime: LPFILETIME) -> BOOL
    LocalFileTimeToFileTime :: (lpLocalFileTime: &FILETIME, lpFileTime: LPFILETIME) -> BOOL

    CreateWaitableTimerExW :: (
        lpTimerAttributes: LPSECURITY_ATTRIBUTES,
        lpTimerName: LPCWSTR,
        dwFlags: DWORD,
        dwDesiredAccess: DWORD
    ) -> HANDLE

    SetWaitableTimer :: (
        hTimer: HANDLE,
        lpDueTime: &LARGE_INTEGER,
        lPeriod: LONG,
        pfnCompletionRoutine: PTIMERAPCROUTINE,
        lpArgToCompletionRoutine: LPVOID,
        fResume: BOOL
    ) -> BOOL

    GetCurrentThread  :: () -> HANDLE
    GetCurrentProcess :: () -> HANDLE

    SymSetOptions            :: (SymOptions: DWORD) -> DWORD
    SymInitialize            :: (hProcess: HANDLE, UserSearchPath: PCSTR, fInvadeProcess: BOOL) -> BOOL
    SymFromAddr              :: (hProcess: HANDLE, Address: DWORD64, Displacement: PDWORD64, Symbol: PSYMBOL_INFO) -> BOOL
    SymFunctionTableAccess64 :: (hProcess: HANDLE, AddrBase: DWORD64) -> PVOID
    SymGetModuleBase64       :: (hProcess: HANDLE, qwAddr: DWORD64) -> DWORD64
    SymGetLineFromAddr64     :: (hProcess: HANDLE, qwAddr: DWORD64, pdwDisplacement: PDWORD, Line64: PIMAGEHLP_LINE64) -> BOOL

    SetThreadStackGuarantee :: (StackSizeInBytes: PULONG) -> BOOL
    SetUnhandledExceptionFilter :: (lpTopLevelExceptionFilter: LPTOP_LEVEL_EXCEPTION_FILTER) -> LPTOP_LEVEL_EXCEPTION_FILTER

    signal :: (_Signal: C.int, _Function: _crt_signal_t) -> _crt_signal_t
    _set_abort_behavior :: (_Flags: C.unsigned_int, _Mask: C.unsigned_int) -> C.unsigned_int

    RtlCaptureContext :: (ContextRecord: PCONTEXT)

    StackWalk64 :: (
        MachineType: DWORD,
        hProcess: HANDLE,
        hThread: HANDLE,
        StackFrame: LPSTACKFRAME64,
        ContextRecord: PVOID,
        ReadMemoryRoutine: PREAD_PROCESS_MEMORY_ROUTINE64,
        FunctionTableAccessRoutine: PFUNCTION_TABLE_ACCESS_ROUTINE64,
        GetModuleBaseRoutine: PGET_MODULE_BASE_ROUTINE64,
        TranslateAddress: PTRANSLATE_ADDRESS_ROUTINE64,
    ) -> BOOL
}

