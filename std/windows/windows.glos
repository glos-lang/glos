MEM_COMMIT  :: 0x00001000
MEM_RELEASE :: 0x00008000
MEM_RESERVE :: 0x00002000

PAGE_READWRITE :: 0x04

INVALID_HANDLE_VALUE :: HANDLE(-1)

STD_INPUT_HANDLE  :: DWORD(s32(-10))
STD_OUTPUT_HANDLE :: DWORD(s32(-11))
STD_ERROR_HANDLE  :: DWORD(s32(-12))

HANDLE_FLAG_INHERIT :: 0x00000001

STARTF_USESTDHANDLES :: 0x00000100

FILE_READ_ATTRIBUTES     :: 0x0080
FILE_ATTRIBUTE_READONLY  :: 0x00000001
FILE_ATTRIBUTE_DIRECTORY :: 0x00000010

FILE_SHARE_READ   :: 0x00000001
FILE_SHARE_WRITE  :: 0x00000002
FILE_SHARE_DELETE :: 0x00000004

OPEN_EXISTING :: 3

FILE_TYPE_UNKNOWN :: 0x0000
FILE_TYPE_DISK    :: 0x0001
FILE_TYPE_CHAR    :: 0x0002
FILE_TYPE_PIPE    :: 0x0003
FILE_TYPE_REMOTE  :: 0x8000

FILE_FLAG_BACKUP_SEMANTICS :: 0x02000000

INFINITE :: 0xffffffff

WAIT_FAILED :: 0xFFFFFFFF

extern {
    wcslen :: (str: &WCHAR) -> C.size_t
    _fileno :: (f: C.FILE) -> C.int
    _lseeki64 :: (fd: C.int, offset: s64, whence: C.int) -> s64
    _open :: (path: &C.char, flags: C.int, mode: C.unsigned_int) -> C.int
    _fdopen :: (fd: C.int, mode: &C.char) -> C.FILE
    _get_osfhandle :: (fd: C.int) -> HANDLE
    _open_osfhandle :: (osfhandle: C.intptr_t, flags: C.int) -> C.int
    __acrt_iob_func :: (fd: C.unsigned) -> C.FILE

    VirtualAlloc :: (lpAddress: LPVOID, dwSize: SIZE_T, flAllocationType: DWORD, flProtect: DWORD) -> LPVOID
    VirtualFree  :: (lpAddress: LPVOID, dwSize: SIZE_T, dwFreeType: DWORD) -> BOOL

    CreateProcessW :: (
        lpApplicationName: LPCWSTR,
        lpCommandLine: LPWSTR,
        lpProcessAttributes: LPSECURITY_ATTRIBUTES,
        lpThreadAttributes: LPSECURITY_ATTRIBUTES,
        bInheritHandles: BOOL,
        dwCreationFlags: DWORD,
        lpEnvironment: LPVOID,
        lpCurrentDirectory: LPCWSTR,
        lpStartupInfo: LPSTARTUPINFOW,
        lpProcessInformation: LPPROCESS_INFORMATION,
    ) -> BOOL

    CreatePipe :: (
        hReadPipe: PHANDLE,
        hWritePipe: PHANDLE,
        lpPipeAttributes: LPSECURITY_ATTRIBUTES,
        nSize: DWORD,
    ) -> BOOL

    CloseHandle :: (hObject: HANDLE) -> BOOL
    TerminateProcess :: (hProcess: HANDLE, uExitCode: UINT) -> BOOL

    GetStdHandle :: (nStdHandle: DWORD) -> HANDLE
    SetHandleInformation :: (
        hObject: HANDLE,
        dwMask: DWORD,
        dwFlags: DWORD
    ) -> BOOL

    WaitForSingleObject :: (hHandle: HANDLE, dwMilliseconds: DWORD) -> DWORD
    GetExitCodeProcess :: (hProcess: HANDLE, lpExitCode: LPDWORD) -> BOOL

    GetEnvironmentVariableW :: (lpName: LPCWSTR, lpBuffer: LPWSTR, nSize: DWORD) -> DWORD
    SetEnvironmentVariableW :: (lpName: LPCWSTR, lpValue: LPCWSTR) -> BOOL

    GetCurrentDirectoryW :: (nBufferLength: DWORD, lpBuffer: LPWSTR) -> DWORD
    SetCurrentDirectoryW :: (lpPathName: LPCWSTR) -> BOOL

    GetLastError :: () -> DWORD
    FormatMessageW :: (
        dwFlags: DWORD,
        lpSource: LPCVOID,
        dwMessageId: DWORD,
        dwLanguageId: DWORD,
        lpBuffer: LPWSTR,
        nSize: DWORD,
        arguments: rawptr
    ) -> DWORD

    FindFirstFileW :: (lpFileName: LPCWSTR, lpFindFileData: LPWIN32_FIND_DATAW) -> HANDLE
    FindNextFileW :: (hFindFile: HANDLE, lpFindFileData: LPWIN32_FIND_DATAW) -> BOOL
    FindClose :: (hFindFile: HANDLE) -> BOOL

    CreateFileW :: (
        lpFileName: LPCWSTR,
        dwDesiredAccess: DWORD,
        dwShareMode: DWORD,
        lpSecurityAttributes: LPSECURITY_ATTRIBUTES,
        dwCreationDisposition: DWORD,
        dwFlagsAndAttributes: DWORD,
        hTemplateFile: HANDLE
    ) -> HANDLE

    GetFileType :: (hFile: HANDLE) -> DWORD

    GetFileInformationByHandleEx :: (
        hFile: HANDLE,
        FileInformationClass: FILE_INFO_BY_HANDLE_CLASS,
        lpFileInformation: LPVOID,
        dwBufferSize: DWORD
    ) -> BOOL

    GetFileInformationByHandle :: (hFile: HANDLE, lpFileInformation: LPBY_HANDLE_FILE_INFORMATION) -> BOOL

    RemoveDirectoryW :: (lpPathName: LPCWSTR) -> BOOL
}

C :: #import "C"
