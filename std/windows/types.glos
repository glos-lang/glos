STARTUPINFOW :: struct {
    cb: DWORD
    lpReserved: LPWSTR
    lpDesktop: LPWSTR
    lpTitle: LPWSTR
    dwX: DWORD
    dwY: DWORD
    dwXSize: DWORD
    dwYSize: DWORD
    dwXCountChars: DWORD
    dwYCountChars: DWORD
    dwFillAttribute: DWORD
    dwFlags: DWORD
    wShowWindow: WORD
    cbReserved2: WORD
    lpReserved2: LPBYTE
    hStdInput: HANDLE
    hStdOutput: HANDLE
    hStdError: HANDLE
}

LPSTARTUPINFOW :: &STARTUPINFOW;

SECURITY_ATTRIBUTES :: struct {
    nLength: DWORD
    lpSecurityDescriptor: LPVOID
    bInheritHandle: BOOL
}

PSECURITY_ATTRIBUTES :: &SECURITY_ATTRIBUTES
LPSECURITY_ATTRIBUTES :: &SECURITY_ATTRIBUTES

PROCESS_INFORMATION :: struct {
    hProcess: HANDLE
    hThread: HANDLE
    dwProcessId: DWORD
    dwThreadId: DWORD
}

PPROCESS_INFORMATION :: &PROCESS_INFORMATION
LPPROCESS_INFORMATION :: &PROCESS_INFORMATION
