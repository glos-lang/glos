to_cstring :: (s: string, allocator := default_allocator) -> &C.char, error {
    p := &C.char(allocator.alloc(s.count + 1, zeroed = false)?)
    if s.count != 0 {
        mem.copy(p, &C.char(s.data), s.count, overlaps = false)
    }

    *(p + &C.char(s.count)) = 0
    return p, null
}

from_cstring :: (s: &C.char) -> string {
    return string([]C.char(s, C.strlen(s)))
}

to_s64 :: (s: string, base := 10) -> s64, error {
    cstr := to_cstring(s, temporary_allocator)?
    defer temporary_allocator.rewind(rawptr(cstr))

    C.set_errno(null)
    end: &C.char
    result := C.strtoll(cstr, &end, s32(base))

    err := C.get_errno()
    if err != null {
        return 0, err
    }

    if end == &C.char(s.data) || *end != '\0' {
        return 0, C.Errno.EINVAL
    }
    return result, null
}

C   :: #import "C"
mem :: #import "memory"
