find :: (s: string, p: Predicate, reverse := false) -> s64, bool {
    if p == {
    case rune
        if reverse {
            for i, c := range Reverse(s) {
                if c == p {
                    return i, true
                }
            }
        } else {
            for i, c := range s {
                if c == p {
                    return i, true
                }
            }
        }

    case string
        if p == "" {
            return 0, true
        }

        if p.count > s.count {
            return 0, false
        }

        if reverse {
            for i := range s.count..>=p.count {
                if begins_with(s[i..], p) {
                    return i, true
                }
            }
        } else {
            for i := range s.count - p.count + 1 {
                if begins_with(s[i..], p) {
                    return i, true
                }
            }
        }

    case (c: rune) -> bool
        if p == null {
            return 0, false
        }

        if reverse {
            for i, c := range Reverse(s) {
                if p(c) {
                    return i, true
                }
            }
        } else {
            for i, c := range s {
                if p(c) {
                    return i, true
                }
            }
        }

    case null; unreachable()
    }

    return 0, false
}

contains :: inline (s: string, p: Predicate, reverse := false) -> bool {
    _, found := find(s, p, reverse)
    return found
}

split :: (s: string, p: Predicate = unicode.is_space, reverse := false) -> string, string, bool {
    n, found := find(s, p, reverse)
    if !found {
        return s, "", false
    }

    lhs := s[..n]
    if p == string {
        return lhs, s[n + p.count..], true
    } else {
        return lhs, s[n + 1..], true
    }
}

trim :: (s: string, p: Predicate = unicode.is_space) -> string {
    return trim_right(trim_left(s, p), p)
}

trim_left :: (s: string, p: Predicate = unicode.is_space) -> string {
    if p == {
    case rune
        for i, c := range s {
            if c != p {
                return s[i..]
            }
        }

    case string
        if p == "" {
            return s
        }

        for i := 0; i < s.count; i += p.count {
            s := s[i..]
            if !begins_with(s, p) {
                return s
            }
        }

    case (c: rune) -> bool
        if p == null {
            return s
        }

        for i, c := range s {
            if !p(c) {
                return s[i..]
            }
        }

    case null; unreachable()
    }

    return ""
}

trim_right :: (s: string, p: Predicate = unicode.is_space) -> string {
    if p == {
    case rune
        for i, c := range Reverse(s) {
            if c != p {
                return s[..i + 1]
            }
        }

    case string
        if p != "" {
            for ends_with(s, p) {
                s.count -= p.count
            }
        }
        return s

    case (c: rune) -> bool
        if p == null {
            return s
        }

        for i, c := range Reverse(s) {
            if !p(c) {
                return s[..i + 1]
            }
        }

    case null; unreachable()
    }

    return ""
}

begins_with :: (s: string, p: string) -> bool {
    if p == "" {
        return true
    }
    return s.count >= p.count && C.memcmp(rawptr(s.data), rawptr(p.data), u64(p.count)) == 0
}

ends_with :: (s: string, p: string) -> bool {
    if p == "" {
        return true
    }
    return s.count >= p.count && C.memcmp(rawptr(&s[s.count - p.count]), rawptr(p.data), u64(p.count)) == 0
}

clone :: inline (s: string, allocator := default_allocator) -> string, error {
    return string(mem.clone_array([]u8(s), allocator = allocator)?), null
}
