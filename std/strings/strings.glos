to_cstring :: (s: string, allocator := default_allocator) -> &u8 {
    p := &u8(allocator.alloc(s.count + 1, zeroed = false))
    if s.count != 0 {
        mem.copy(p, s.data, s.count, overlaps = false)
    }

    *(p + &u8(s.count)) = 0
    return p
}

from_cstring :: (s: &u8) -> string {
    return string([]u8(s, C.strlen(s)))
}

to_s64 :: (s: string, base := 10) -> s64, error {
    cstr := to_cstring(s, temporary_allocator)
    defer temporary_allocator.rewind(rawptr(cstr))

    C.set_errno(null)
    end: &u8
    result := C.strtoll(cstr, &end, s32(base))

    err := C.get_errno()
    if err != null {
        return 0, err
    }

    if end == s.data || *end != '\0' {
        return 0, C.Errno.EINVAL
    }
    return result, null
}

C   :: #import "C"
mem :: #import "memory"
