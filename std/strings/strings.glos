to_cstring :: (s: string, allocator := default_allocator) -> &char {
    p := &char(allocator.alloc(s.count + 1, zeroed = false))
    if s.count != 0 {
        mem.copy(p, s.data, s.count, overlaps = false)
    }

    *(p + &char(s.count)) = 0
    return p
}

from_cstring :: (s: &char) -> string {
    return string([]char(s, C.strlen(s)))
}

// TODO: Range check
to_integer :: (s: string, base := 10) -> s64, bool {
    cstr := to_cstring(s, temporary_allocator)
    defer temporary_allocator.rewind(rawptr(cstr))

    end: &char
    result := C.strtoll(cstr, &end, s32(base))
    return result, *end == '\0'
}

C   :: #import "C"
mem :: #import "memory"
