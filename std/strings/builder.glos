Builder :: distinct [..]u8

write :: inline (this: &Builder, bytes: []u8) -> s64, error {
    this.push(...bytes)
    return bytes.count, null
}

to_string :: (this: &Builder, from := 0, rewind := true, allocator := default_allocator, location := #caller_location) -> string, error {
    if from > this.count {
        panic("Bounds Check Failed: Index \{from} is invalid since length is \{this.count}", location = location)
    }

    s := string(mem.clone_array(this[from..])?)
    if rewind {
        this.count = from
    }
    return s, null
}

to_cstring :: inline (this: &Builder, from := 0, rewind := true, allocator := default_allocator, location := #caller_location) -> &C.char, error {
    this.write([]u8("\0"))?
    return &C.char(this.to_string(from = from, rewind = rewind, allocator = default_allocator, location = location)?.data), null
}

@format :: (this: &Builder, w: io.Writer, nested := false) -> s64, error {
    return w.write(this[..])
}

io :: #import "io"
