Split :: struct {
    s: string
    p: Predicate
}

range :: (this: Split, state: &struct { s: string; index: s64 }) -> s64, string, bool {
    if this.s  == "" then return 0, "", false
    if state.s == "" {
        if state.index == 0 {
            state.s = this.s
        } else {
            return state.index, "", false
        }
    }

    lhs: string
    lhs, state.s, _ = state.s.split(this.p)
    state.index += 1
    return state.index - 1, lhs, true
}

Reverse :: distinct string

range :: (this: Reverse, state: &s64) -> s64, rune, bool {
    end := this.count - *state
    if end <= 0 {
        return 0, 0, false
    }

    for count := 1; count <= 4 && count <= end; count += 1 {
        start := end - count
        lead  := this[start]
        if unicode.count(lead) == count {
            r, n, _ := unicode.decode([]u8(this)[start..])
            if n == count {
                *state = this.count - start
                return start, r, true
            }
            break
        }
    }

    start := end - 1
    *state = this.count - start
    return start, -1, true
}

Predicate :: union {
    rune
    string
    (c: rune) -> bool
}

unicode :: #import "unicode"
