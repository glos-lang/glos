count :: (b: u8) -> s64 {
    if b & 0x80 == 0x00 then return 1 // 0xxxxxxx
    if b & 0xE0 == 0xC0 then return 2 // 110xxxxx
    if b & 0xF0 == 0xE0 then return 3 // 1110xxxx
    if b & 0xF8 == 0xF0 then return 4 // 11110xxx
    return 0
}

decode :: (s: []u8) -> rune, s64, bool {
    byte  := s[0]
    count := count(byte)
    if count == 0 || count > s.count {
        return -1, 0, false
    }

    if count == 1 {
        return rune(byte), 1, true
    }

    cp:     rune
    min_cp: s64
    if count == {
    case 2
        cp = rune(byte) & 0x1F
        min_cp = 0x80

    case 3
        cp = rune(byte) & 0x0F
        min_cp = 0x800

    case
        cp = rune(byte) & 0x07
        min_cp = 0x10000
    }

    for i := range 1..count {
        b := u8(s[i])
        if (b & 0xC0) != 0x80 {
            return -1, 0, false
        }
        cp = (cp << 6) | rune(b & 0x3F)
    }

    if s64(cp) < min_cp || (cp >= 0xD800 && cp <= 0xDFFF) || cp > 0x10FFFF {
        return -1, 0, false
    }

    return cp, count, true
}

encode :: (r: rune, buffer: []u8) -> s64, bool {
    cp := u32(r)
    ok := true

    // Treat anything invalid/out-of-range/surrogate as U+FFFD.
    if r < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
        cp = u32(REPLACEMENT_CHAR)
        ok = false
    }

    n:  s64
    if cp <= 0x7F {
        buffer[0] = u8(cp)
        n = 1
    } else if cp <= 0x7FF {
        buffer[0] = u8(0xC0 | (cp >> 6))
        buffer[1] = u8(0x80 | (cp & 0x3F))
        n = 2
    } else if cp <= 0xFFFF {
        buffer[0] = u8(0xE0 | (cp >> 12))
        buffer[1] = u8(0x80 | ((cp >> 6) & 0x3F))
        buffer[2] = u8(0x80 | (cp & 0x3F))
        n = 3
    } else {
        buffer[0] = u8(0xF0 | (cp >> 18))
        buffer[1] = u8(0x80 | ((cp >> 12) & 0x3F))
        buffer[2] = u8(0x80 | ((cp >> 6) & 0x3F))
        buffer[3] = u8(0x80 | (cp & 0x3F))
        n = 4
    }

    return n, ok
}
