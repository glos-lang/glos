MAX_RUNE         :: '\U00010FFF' // Maximum valid unicode code point
MAX_ASCII        :: '\u007F'     // Maximum ASCII value
MAX_LATIN1       :: '\u00FF'     // Maximum Latin-1 value
REPLACEMENT_CHAR :: '\uFFFD'     // Represented an invalid code point

to_lower :: (r: rune) -> rune {
	c := s32(r)
	p := binary_search(c, to_lower_ranges, to_lower_ranges.count / 3, 3)
	if p >= 0 && to_lower_ranges[p] <= c && c <= to_lower_ranges[p + 1] {
		return rune(c + to_lower_ranges[p + 2] - 500)
	}

	p = binary_search(c, to_lower_singlets, to_lower_singlets.count / 2, 2)
	if p >= 0 && c == to_lower_singlets[p] {
		return rune(c + to_lower_singlets[p + 1] - 500)
	}
	return rune(c)
}

to_upper :: (r: rune) -> rune {
	c := s32(r)
	p := binary_search(c, to_upper_ranges, to_upper_ranges.count / 3, 3)
	if p >= 0 && to_upper_ranges[p] <= c && c <= to_upper_ranges[p + 1] {
		return rune(c + to_upper_ranges[p + 2] - 500)
	}

	p = binary_search(c, to_upper_singlets, to_upper_singlets.count / 2, 2)
	if p >= 0 && c == to_upper_singlets[p] {
		return rune(c + to_upper_singlets[p + 1] - 500)
	}
	return rune(c)
}

to_title :: (r: rune) -> rune {
	c := s32(r)
	p := binary_search(c, to_upper_singlets, to_title_singlets.count / 2, 2)
	if p >= 0 && c == to_upper_singlets[p] {
		return rune(c + to_title_singlets[p + 1] - 500)
	}
	return rune(c)
}

is_alpha :: (r: rune) -> bool {
	if u32(r) <= u32(MAX_LATIN1) {
		return char_properties[u8(r)] & pLmask != 0
	}

	if is_upper(r) || is_lower(r) {
		return true
	}

	c := s32(r)
	p := binary_search(c, alpha_ranges, alpha_ranges.count / 2, 2)
	if p >= 0 && alpha_ranges[p] <= c && c <= alpha_ranges[p + 1] {
		return true
	}

	p = binary_search(c, alpha_singlets, alpha_singlets.count, 1)
	if p >= 0 && c == alpha_singlets[p] {
		return true
	}
	return false
}

is_alnum :: (r: rune) -> bool {
    return is_alpha(r) || is_digit(r)
}

is_lower :: (r: rune) -> bool {
	if r <= MAX_ASCII {
		return u32(r) - u32('a') < 26
	}

	c := s32(r)
	p := binary_search(c, to_upper_ranges, to_upper_ranges.count / 3, 3)
	if p >= 0 && to_upper_ranges[p] <= c && c <= to_upper_ranges[p + 1] {
		return true
	}

	p = binary_search(c, to_upper_singlets, to_upper_singlets.count / 2, 2)
	if p >= 0 && c == to_upper_singlets[p] {
		return true
	}
	return false
}

is_upper :: (r: rune) -> bool {
	if r <= MAX_ASCII {
		return u32(r) - u32('A') < 26
	}

	c := s32(r)
	p := binary_search(c, to_lower_ranges, to_lower_ranges.count / 3, 3)
	if p >= 0 && to_lower_ranges[p] <= c && c <= to_lower_ranges[p + 1] {
		return true
	}

	p = binary_search(c, to_lower_singlets, to_lower_singlets.count / 2, 2)
	if p >= 0 && c == to_lower_singlets[p] {
		return true
	}
	return false
}

is_title :: (r: rune) -> bool {
	return is_upper(r) && is_lower(r)
}

is_digit :: (r: rune) -> bool {
	if r <= MAX_LATIN1 {
		return '0' <= r && r <= '9'
	}
	return false
}

is_space :: (r: rune) -> bool {
	if u32(r) <= u32(MAX_LATIN1) {
		if r == {
        case '\t', '\n', '\v', '\f', '\r', ' ', 0x85, 0xa0; return true
        case; return false
		}
	}

	c := s32(r)
	p := binary_search(c, space_ranges, space_ranges.count / 2, 2)
	if p >= 0 && space_ranges[p] <= c && c <= space_ranges[p + 1] {
		return true
	}
	return false
}

is_combining :: (r: rune) -> bool {
	c := s32(r)
	return c >= 0x0300 && (c <= 0x036f ||
	      (c >= 0x1ab0 && c <= 0x1aff) ||
	      (c >= 0x1dc0 && c <= 0x1dff) ||
	      (c >= 0x20d0 && c <= 0x20ff) ||
	      (c >= 0xfe20 && c <= 0xfe2f))
}

is_graphic :: (r: rune) -> bool {
	if u32(r) <= u32(MAX_LATIN1) {
		return char_properties[u8(r)] & pg != 0
	}
	return false
}

is_print :: (r: rune) -> bool {
	if u32(r) <= u32(MAX_LATIN1) {
		return char_properties[u8(r)] & pp != 0
	}
	return false
}

is_control :: (r: rune) -> bool {
	if u32(r) <= u32(MAX_LATIN1) {
		return char_properties[u8(r)] & pC != 0
	}
	return false
}

is_number :: (r: rune) -> bool {
	if u32(r) <= u32(MAX_LATIN1) {
		return char_properties[u8(r)] & pN != 0
	}
	return false
}

is_punct :: (r: rune) -> bool {
	if u32(r) <= u32(MAX_LATIN1) {
		return char_properties[u8(r)] & pP != 0
	}
	return false
}

is_symbol :: (r: rune) -> bool {
	if u32(r) <= u32(MAX_LATIN1) {
		return char_properties[u8(r)] & pS != 0
	}
	return false
}

//
// The procedures below are accurate as of Unicode 15.1.0.
//

// Emoji_Modifier
is_emoji_modifier :: (r: rune) -> bool {
	return 0x1F3FB <= r && r <= 0x1F3FF
}

// Regional_Indicator
is_regional_indicator :: (r: rune) -> bool {
	return 0x1F1E6 <= r && r <= 0x1F1FF
}

// General_Category=Enclosing_Mark
is_enclosing_mark :: (r: rune) -> bool {
    if r == {
    case 0x0488, 0x0489, 0x1ABE; return true
    }

    if r >= 0x20DD && r <= 0x20E0 then return true
    if r >= 0x20E2 && r <= 0x20E4 then return true
    if r >= 0xA670 && r <= 0xA672 then return true
	return false
}

// Prepended_Concatenation_Mark
is_prepended_concatenation_mark :: (r: rune) -> bool {
    if r == {
	case 0x006DD, 0x0070F, 0x008E2, 0x110BD, 0x110CD; return true
    }

    if r >= 0x00600 && r <= 0x00605 then return true
    if r >= 0x00890 && r <= 0x00891 then return true
    return false
}

// General_Category=Spacing_Mark
is_spacing_mark :: (r: rune) -> bool {
	c := s32(r)
	p := binary_search(c, spacing_mark_ranges, spacing_mark_ranges.count / 2, 2)
	if p >= 0 && spacing_mark_ranges[p] <= c && c <= spacing_mark_ranges[p + 1] {
		return true
	}
	return false
}

// General_Category=Nonspacing_Mark
is_nonspacing_mark :: (r: rune) -> bool {
	c := s32(r)
	p := binary_search(c, nonspacing_mark_ranges, nonspacing_mark_ranges.count / 2, 2)
	if p >= 0 && nonspacing_mark_ranges[p] <= c && c <= nonspacing_mark_ranges[p + 1] {
		return true
	}
	return false
}

// Extended_Pictographic
is_emoji_extended_pictographic :: (r: rune) -> bool {
	c := s32(r)
	p := binary_search(c, emoji_extended_pictographic_ranges, emoji_extended_pictographic_ranges.count / 2, 2)
	if p >= 0 && emoji_extended_pictographic_ranges[p] <= c && c <= emoji_extended_pictographic_ranges[p + 1] {
		return true
	}
	return false
}

// Grapheme_Extend
is_grapheme_extend :: (r: rune) -> bool {
	c := s32(r)
	p := binary_search(c, grapheme_extend_ranges, grapheme_extend_ranges.count / 2, 2)
	if p >= 0 && grapheme_extend_ranges[p] <= c && c <= grapheme_extend_ranges[p + 1] {
		return true
	}
	return false
}


// Hangul_Syllable_Type=Leading_Jamo
is_hangul_syllable_leading :: (r: rune) -> bool {
	return 0x1100 <= r && r <= 0x115F || 0xA960 <= r && r <= 0xA97C
}

// Hangul_Syllable_Type=Vowel_Jamo
is_hangul_syllable_vowel :: (r: rune) -> bool {
	return 0x1160 <= r && r <= 0x11A7 || 0xD7B0 <= r && r <= 0xD7C6
}

// Hangul_Syllable_Type=Trailing_Jamo
is_hangul_syllable_trailing :: (r: rune) -> bool {
	return 0x11A8 <= r && r <= 0x11FF || 0xD7CB <= r && r <= 0xD7FB
}

// Hangul_Syllable_Type=LV_Syllable
is_hangul_syllable_lv :: (r: rune) -> bool {
	c := s32(r)
	p := binary_search(c, hangul_syllable_lv_singlets, hangul_syllable_lv_singlets.count, 1)
	if p >= 0 && c == hangul_syllable_lv_singlets[p] {
		return true
	}
	return false
}

// Hangul_Syllable_Type=LVT_Syllable
is_hangul_syllable_lvt :: (r: rune) -> bool {
	c := s32(r)
	p := binary_search(c, hangul_syllable_lvt_ranges, hangul_syllable_lvt_ranges.count / 2, 2)
	if p >= 0 && hangul_syllable_lvt_ranges[p] <= c && c <= hangul_syllable_lvt_ranges[p + 1] {
		return true
	}
	return false
}

// Indic_Syllabic_Category=Consonant_Preceding_Repha
is_indic_consonant_preceding_repha :: (r: rune) -> bool {
	if r == {
	case 0x00D4E, 0x11941, 0x11D46, 0x11F02; return true
	}
    return false
}

// Indic_Syllabic_Category=Consonant_Prefixed
is_indic_consonant_prefixed :: (r: rune) -> bool {
    if r == 0x1193F || r == 0x11A3A then return true
	if r >= 0x111C2 && r <= 0x111C3 then return true
	if r >= 0x11A84 && r <= 0x11A89 then return true
    return false
}

// Indic_Conjunct_Break=Linker
is_indic_conjunct_break_linker :: (r: rune) -> bool {
	if r == {
	case 0x094D, 0x09CD, 0x0ACD, 0x0B4D, 0x0C4D, 0x0D4D; return true
	}
    return false
}

// Indic_Conjunct_Break=Consonant
is_indic_conjunct_break_consonant :: (r: rune) -> bool {
	c := s32(r)
	p := binary_search(c, indic_conjunct_break_consonant_ranges, indic_conjunct_break_consonant_ranges.count / 2, 2)
	if p >= 0 && indic_conjunct_break_consonant_ranges[p] <= c && c <= indic_conjunct_break_consonant_ranges[p + 1] {
		return true
	}
	return false
}

// Indic_Conjunct_Break=Extend
is_indic_conjunct_break_extend :: (r: rune) -> bool {
	c := s32(r)
	p := binary_search(c, indic_conjunct_break_extend_ranges, indic_conjunct_break_extend_ranges.count / 2, 2)
	if p >= 0 && indic_conjunct_break_extend_ranges[p] <= c && c <= indic_conjunct_break_extend_ranges[p + 1] {
		return true
	}
	return false
}


/*
For grapheme text segmentation, from Unicode TR 29 Rev 43:

```
Indic_Syllabic_Category = Consonant_Preceding_Repha, or
Indic_Syllabic_Category = Consonant_Prefixed, or
Prepended_Concatenation_Mark = Yes
```
*/
is_gcb_prepend_class :: (r: rune) -> bool {
	return is_indic_consonant_preceding_repha(r) || is_indic_consonant_prefixed(r) || is_prepended_concatenation_mark(r)
}

/*
For grapheme text segmentation, from Unicode TR 29 Rev 43:

```
Grapheme_Extend = Yes, or
Emoji_Modifier = Yes

This includes:
General_Category = Nonspacing_Mark
General_Category = Enclosing_Mark
U+200C ZERO WIDTH NON-JOINER

plus a few General_Category = Spacing_Mark needed for canonical equivalence.
```
*/
is_gcb_extend_class :: (r: rune) -> bool {
	return is_grapheme_extend(r) || is_emoji_modifier(r)
}

