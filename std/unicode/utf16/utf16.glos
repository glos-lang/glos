from_string :: (s: string, allocator := default_allocator) -> []u16, error {
    n := 0
    for _, c := range s {
        if c < 0 then C.Errno.EILSEQ?
        if u32(c) < 0x10000 {
            n += 1
        } else {
            n += 2
        }
    }

    result := mem.new_array(u16, n, allocator = allocator, zeroed = false)?
    iota   := 0
    for _, c := range s {
        cp := u32(c)
        if cp < 0x10000 {
            result[iota] = u16(cp); iota += 1
        } else {
            cp -= 0x10000
            result[iota] = u16(0xD800 + (cp >> 10));   iota += 1
            result[iota] = u16(0xDC00 + (cp & 0x3FF)); iota += 1
        }
    }

    return result, null
}

to_string :: (u: []u16, allocator := default_allocator) -> string, error {
    b: strings.Builder
    defer b.free()

    to_builder(u, &b)?
    return b.to_string(allocator = allocator)?, null
}

to_cstring :: (u: []u16, allocator := default_allocator) -> &C.char, error {
    b: strings.Builder
    defer b.free()

    to_builder(u, &b)?
    return b.to_cstring(allocator = allocator)?, null
}

to_builder :: (u: []u16, b: &strings.Builder) -> error {
    i := 0
    for i < u.count {
        cp := u32(u[i]); i += 1
        if cp >= 0xD800 && cp <= 0xDBFF && i < u.count && u[i] >= 0xDC00 && u[i] <= 0xDFFF {
            // Surrogate pair
            cp = 0x10000 + ((cp - 0xD800) << 10) + u32(u[i] - 0xDC00); i += 1
        }

        tmp: [4]u8
        n, _ := unicode.encode(rune(cp), tmp)
        b.write(tmp[..n])?
    }

    return null
}

C       :: #import "C"
mem     :: #import "memory"
strings :: #import "strings"
unicode :: #import "unicode"
