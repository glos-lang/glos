Reader :: trait {
    read: (bytes: []u8) -> s64, error
}

Writer :: trait {
    write: (bytes: []u8) -> s64, error
}

Seeker :: trait {
    seek: (offset: s64, whence: Seek) -> s64, error
}

Read_Writer :: trait {
    ...Reader
    ...Writer
}

Read_Seeker :: trait {
    ...Reader
    ...Seeker
}

Write_Seeker :: trait {
    ...Writer
    ...Seeker
}

Read_Write_Seeker :: trait {
    ...Reader
    ...Writer
    ...Seeker
}

Multi_Writer :: distinct [..]Writer

write :: (this: Multi_Writer, bytes: []u8) -> s64, error {
    for _, w := range this {
        w.write(bytes)?
    }
    return bytes.count, null
}

Discard_Writer :: struct {}

write :: (this: Discard_Writer, bytes: []u8) -> s64, error {
    return bytes.count, null
}

Seek :: enum {
    START   = 0
    CURRENT = 1
    END     = 2
}
