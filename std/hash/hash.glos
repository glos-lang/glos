Hasher :: struct {
    hash:  u64
    count: u64
}

bytes :: (this: &Hasher, bytes: []char) {
    HASHER_FNV_PRIME :: 0x100_0000_01B3

    hash := this.hash
    data := bytes.data
    left := bytes.count
    for left >= 8 {
        hash ^= *(&u64)(data)
        hash *= HASHER_FNV_PRIME
        data += &char(8)
        left -= 8
    }

    for left > 0 {
        hash ^= u64(*data)
        hash *= HASHER_FNV_PRIME
        data += &char(1)
        left -= 1
    }

    this.hash = hash
    this.count += u64(bytes.count)
}

float :: (this: &Hasher, f: f64) {
    if f == 0.0 then f = 0.0                   // +0.0 and -0.0 have different bit representations
    if f != f   then f = 0h7FF8_0000_0000_0000 // NaN
    this.bytes(&char(&f)[..sizeof(f)])
}

finish :: (this: Hasher) -> u64 {
    x := this.hash ^ this.count
    x ^= x >> 30
    x *= 0xBF58_476D_1CE4_E5B9
    x ^= x >> 27
    x *= 0x94D0_49BB_1331_11EB
    x ^= x >> 31
    return x
}
