add :: inline (v: Var, name: string, description: string, location := #caller_location) {
    flags.add(v, name, description, location)
}

parse :: inline (location := #caller_location) {
    flags.parse(os.args[1..], location)
    flags.defs.free()
}

usage :: inline (w: io.Writer, location := #caller_location) {
    flags.usage(w, location)
}

args :: inline (location := #caller_location) -> []string {
    return flags.args(location)
}

Flags :: struct {
    defs: map[string]Flag
    argn: s64
    read: bool
    left: []string
}

add :: (this: &Flags, v: Var, name: string, description: string, location := #caller_location) {
    if this.read {
        panic("Cannot call this function after parsing flags", location = location)
    }

    if name == "" {
        panic("Invalid flag name \{Quote {name}}: Cannot be empty", location = location)
    }

    if name == "" || strings.begins_with(name, "-") {
        panic("Invalid flag name \{Quote {name}}: Cannot start with '-'", location = location)
    }

    if this.defs.contains(name) {
        eprintln("\{location} Redefinition of flag \{Quote {name}}")
        panic("Here is the first definition", location = this.defs[name].location)
    }

    flag: Flag
    flag.var = v
    flag.desc = description
    flag.location = location

    if v == {
    case &bool;   flag.default = *v
    case &s64;    flag.default = *v
    case &u64;    flag.default = *v
    case &f64;    flag.default = *v
    case &string; flag.default = *v
    case
    }

    this.defs[name] = flag
}

parse :: (this: &Flags, args: []string, location := #caller_location) {
    if this.read {
        panic("Cannot call this function after parsing flags", location = location)
    }

    this.argn = 0
    this.read = true
    this.left = args
    for this.argn < args.count {
        arg := args[this.argn]
        if !strings.begins_with(arg, "-") then break
        this.argn += 1

        flag := arg[1..]
        if strings.begins_with(flag, "-") then flag = flag[1..]
        if flag == ""            then break

        if this.defs.contains(flag) {
            var := this.defs[flag].var
            if var == {
            case &bool;       *var = true
            case &s64;        *var = get_s64(this, args, arg)
            case &u64;        *var = get_u64(this, args, arg)
            case &f64;        *var = get_f64(this, args, arg)
            case &string;     *var = get_string(this, args, arg)
            case &[..]s64;    var.push(get_s64(this, args, arg))
            case &[..]u64;    var.push(get_u64(this, args, arg))
            case &[..]f64;    var.push(get_f64(this, args, arg))
            case &[..]string; var.push(get_string(this, args, arg))
            case null;        unreachable()
            }
            continue

            get_s64 :: (f: &Flags, args: []string, arg: string) -> s64 {
                value  := get_string(f, args, arg)
                n, err := strings.to_s64(value)
                if err != null {
                    eprintln("Error: Invalid int \{Quote {value}}")
                    eprintln()
                    f.usage(os.stderr)
                    os.exit(1)
                }
                return n
            }

            get_u64 :: (f: &Flags, args: []string, arg: string) -> u64 {
                value  := get_string(f, args, arg)
                n, err := strings.to_u64(value)
                if err != null {
                    eprintln("Error: Invalid uint \{Quote {value}}")
                    eprintln()
                    f.usage(os.stderr)
                    os.exit(1)
                }
                return n
            }

            get_f64 :: (f: &Flags, args: []string, arg: string) -> f64 {
                value  := get_string(f, args, arg)
                n, err := strings.to_f64(value)
                if err != null {
                    eprintln("Error: Invalid float \{Quote {value}}")
                    f.usage(os.stderr)
                    os.exit(1)
                }
                return n
            }

            get_string :: (f: &Flags, args: []string, arg: string) -> string {
                if f.argn >= args.count {
                    eprintln("Error: Value not provided for \{Quote {arg}}")
                    eprintln()
                    f.usage(os.stderr)
                    os.exit(1)
                }

                f.argn += 1
                return args[f.argn - 1]
            }
        }

        if flag == {
        case "h", "help"
            this.usage(os.stdout)
            os.exit(0)
        }

        eprintln("Error: Invalid flag \{Quote {arg}}")
        eprintln()
        this.usage(os.stderr)
        os.exit(1)
    }

    this.left = args[this.argn..]
}

usage :: (this: &Flags, w: io.Writer, location := #caller_location) {
    if !this.read {
        panic("Cannot call this function before parsing flags", location = location)
    }

    if this == &flags {
        wprintln(w, "Usage of \{os.args[0]}:")
    } else {
        wprintln(w, "Usage:")
    }

    if !this.defs.contains("help") {
        show(w, "help", "Show this message")
    }

    for name, flag := range this.defs {
        arg: string
        if flag.var == {
        case &bool
        case &s64,    &[..]s64;    arg = "int"
        case &u64,    &[..]u64;    arg = "uint"
        case &f64,    &[..]f64;    arg = "float"
        case &string, &[..]string; arg = "string"
        case null;                 unreachable()
        }
        show(w, name, flag.desc, arg, flag.default)
    }

    show :: (w: io.Writer, name: string, desc: string, arg := "", default := Default {}) {
        #thread first := true
        if first {
            first = false
        } else {
            wprintln(w)
        }

        wprint(w, "    -\{name}")
        if arg != "" {
            wprint(w, " \{arg}")
        }
        wprintln(w)

        for _, line := range (strings.Split {desc, '\n'}) {
            wprintln(w, "        \{line}")
        }

        if default == {
        case bool
        case s64
            if default != 0 {
                wprintln(w, "        Default is \{default}")
            }

        case u64
            if default != 0 {
                wprintln(w, "        Default is \{default}")
            }

        case f64
            if default != 0.0 {
                wprintln(w, "        Default is \{default}")
            }

        case string
            if default != "" {
                wprintln(w, "        Default is \{Quote {default, '"'}}")
            }

        case null
        }
    }
}

args :: (this: Flags, location := #caller_location) -> []string {
    if !this.read {
        panic("Cannot call this function before parsing flags", location = location)
    }
    return this.left
}

free :: inline (this: &Flags) {
    this.defs.free()
    mem.zero(this)
}

#private...
flags: Flags

Flag :: struct {
    var:      Var
    desc:     string
    location: Source_Code_Location
    default:  Default
}

Var :: union {
    &bool
    &s64
    &u64
    &f64
    &string
    &[..]s64
    &[..]u64
    &[..]f64
    &[..]string
}

Default :: union {
    bool
    s64
    u64
    f64
    string
}

Quote :: struct {
    s: string
    c: u8
}

@format :: (this: &Quote, w: io.Writer, nested: bool) -> s64, error {
    n := w.write([]u8(&this.c, 1))?
    for _, c := range this.s {
        n += fmt.quote(w, c, this.c)?
    }
    n += w.write([]u8(&this.c, 1))?
    return n, null
}

io      :: #import "io"
os      :: #import "os"
fmt     :: #import "fmt"
mem     :: #import "memory"
strings :: #import "strings"
