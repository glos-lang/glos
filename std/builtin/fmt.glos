#private ...

write_rune :: (w: io.Writer, r: rune) -> s64, error {
    cp := u32(r)

    // Treat anything invalid/out-of-range/surrogate as U+FFFD.
    if r < rune(0) || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
        cp = 0xFFFD
    }

    buffer: [4]u8
    count:  s64
    if (cp <= 0x7F) {
        buffer[0] = u8(cp)
        count = 1
    } else if (cp <= 0x7FF) {
        buffer[0] = u8(0xC0 | (cp >> 6))
        buffer[1] = u8(0x80 | (cp & 0x3F))
        count = 2
    } else if (cp <= 0xFFFF) {
        buffer[0] = u8(0xE0 | (cp >> 12))
        buffer[1] = u8(0x80 | ((cp >> 6) & 0x3F))
        buffer[2] = u8(0x80 | (cp & 0x3F))
        count = 3
    } else {
        buffer[0] = u8(0xF0 | (cp >> 18))
        buffer[1] = u8(0x80 | ((cp >> 12) & 0x3F))
        buffer[2] = u8(0x80 | ((cp >> 6) & 0x3F))
        buffer[3] = u8(0x80 | (cp & 0x3F))
        count = 4
    }

    return w.write(buffer[..count])
}

write_type :: (w: io.Writer, t: Type) -> s64, error {
    if t == null {
        return w.write([]u8("null"))
    }

    if t.name.count != 0 {
        return w.write([]u8(t.name))
    }

    n := 0
    v := t.variant
    if v == {
    case Type_Info_Boolean
        n += w.write([]u8("bool"))?

    case Type_Info_Rune
        n += w.write([]u8("rune"))?

    case Type_Info_Integer
        if v.signed {
            n += w.write([]u8("s"))?
        } else {
            n += w.write([]u8("u"))?
        }
        n += wprint(w, t.size * 8)?

    case Type_Info_Float
        n += w.write([]u8("f"))?
        n += wprint(w, t.size * 8)?

    case Type_Info_Pointer
        if v.underlying != null {
            n += w.write([]u8("&"))?
            n += write_type(w, v.underlying)?
        } else {
            n += w.write([]u8("rawptr"))?
        }

    case Type_Info_Function
        n += w.write([]u8("("))?
        for i, it := range v.args {
            if i > 0 {
                n += w.write([]u8(", "))?
            }

            if i == v.args.count - 1 && v.variadics == .TYPED {
                n += w.write([]u8("..."))?
                n += write_type(w, it.variant.(Type_Info_Slice).underlying)?
            } else {
                n += write_type(w, it)?
            }
        }

        if v.variadics == .UNTYPED {
            n += w.write([]u8(", ..."))?
        }
        n += w.write([]u8(")"))?

        if v.returns.count > 0 {
            n += w.write([]u8(" -> "))?
            if v.returns.count > 1 {
                n += w.write([]u8("("))?
            }

            for i, it := range v.returns {
                if i > 0 {
                    n += w.write([]u8(", "))?
                }
                n += write_type(w, it)?
            }

            if v.returns.count > 1 {
                n += w.write([]u8(")"))?
            }
        }

    case Type_Info_Enumeration
        n += w.write([]u8("enum "))?
        n += write_type(w, v.underlying)?

    case Type_Info_Trait
        n += w.write([]u8("trait {"))?
        if v.names.count != 0 {
            n += w.write([]u8(" "))?
            for i := 0; i < v.names.count; i += 1 {
                if i != 0 {
                    n += w.write([]u8("; "))?
                }

                n += wprint(w, "\{v.names[i]}: \{v.types[i]}")?
            }
            n += w.write([]u8(" "))?
        }
        n += w.write([]u8("}"))?

    case Type_Info_Union
        n += w.write([]u8("union {"))?
        if v.variants.count != 0 {
            n += w.write([]u8(" "))?
            for i := 0; i < v.variants.count; i += 1 {
                if i != 0 {
                    n += w.write([]u8("; "))?
                }

                n += write_type(w, v.variants[i])?
            }
            n += w.write([]u8(" "))?
        }
        n += w.write([]u8("}"))?

    case Type_Info_Structure
        n += w.write([]u8("struct {"))?
        if v.names.count != 0 {
            n += w.write([]u8(" "))?
            for i := 0; i < v.names.count; i += 1 {
                if i != 0 {
                    n += w.write([]u8("; "))?
                }

                n += wprint(w, "\{v.names[i]}: \{v.types[i]}")?
            }
            n += w.write([]u8(" "))?
        }
        n += w.write([]u8("}"))?

    case Type_Info_Array
        n += wprint(w, "[\{v.count}]\{v.underlying}")?

    case Type_Info_Dynamic_Array
        n += wprint(w, "[..]\{v.underlying}")?

    case Type_Info_Map
        n += wprint(w, "map[\{v.key}]\{v.value}")?

    case Type_Info_Slice
        n += wprint(w, "[]\{v.underlying}")?

    case Type_Info_Error
        n += w.write([]u8("error"))?

    case Type_Info_String
        n += w.write([]u8("string"))?

    case null
        n += w.write([]u8("null"))?
    }

    return n, null
}

write_quoted_rune :: (w: io.Writer, r: rune, quote: u8) -> s64, error {
    if r == {
    case '\e'; return w.write([]u8("\\e"))
    case '\n'; return w.write([]u8("\\n"))
    case '\r'; return w.write([]u8("\\r"))
    case '\t'; return w.write([]u8("\\t"))
    case '\0'; return w.write([]u8("\\0"))
    case '\\'; return w.write([]u8("\\\\"))

    case '\''
        if quote == '\'' {
            return w.write([]u8("\\'"))
        } else {
            return w.write([]u8("'"))
        }

    case '\"'
        if quote == '\"' {
            return w.write([]u8("\\\""))
        } else {
            return w.write([]u8("\""))
        }

    case; return write_rune(w, r)
    }
}

write_value :: (w: io.Writer, a: Any, nested: bool) -> s64, error {
    if a.type != null && a.type.format != null {
        return a.type.format(a.data, w, nested)
    }

    if a.type == Type {
        return write_type(w, *&Type(a.data))
    }

    n := 0
    if a.type == Interpolation && !nested {
        a := *&Interpolation(a.data)
        if a == {
        case []Any
            for i := 0; i < a.count; i += 1 {
                n += write_value(w, a[i], false)?
            }

        case string
            n += write_value(w, a, false)?

        case
            unreachable()
        }
        return n, null
    }

    if a.type == Source_Code_Location {
        l := *&Source_Code_Location(a.data)
        return wprint(w, "\{l.path}:\{l.row}:\{l.col}:")
    }

    v := a.type.variant
    if v == {
    case Type_Info_Boolean
        if *&bool(a.data) {
            n += w.write([]u8("true"))?
        } else {
            n += w.write([]u8("false"))?
        }

    case Type_Info_Rune
        n += write_rune(w, *(&rune)(a.data))?

    case Type_Info_Integer
        buffer: [32]u8
        count: s32
        if v.signed {
            if a.type.size == {
            case 1; count = C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "%d", *(&s8)(a.data))
            case 2; count = C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "%d", *(&s16)(a.data))
            case 4; count = C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "%d", *(&s32)(a.data))
            case 8; count = C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "%zd", *(&s64)(a.data))
            case;   unreachable()
            }
        } else {
            if a.type.size == {
            case 1; count = C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "%u", *(&u8)(a.data))
            case 2; count = C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "%u", *(&u16)(a.data))
            case 4; count = C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "%u", *(&u32)(a.data))
            case 8; count = C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "%zu", *(&u64)(a.data))
            case;   unreachable()
            }
        }
        n += w.write(buffer[..count])?

    case Type_Info_Float
        buffer: [32]u8
        count: s32
        if a.type.size == {
        case 4; count = C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "%.7g", *&f32(a.data))
        case 8; count = C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "%.14g", *&f64(a.data))
        case;   unreachable()
        }
        n += w.write(buffer[..count])?

    case Type_Info_Pointer, Type_Info_Function
        ptr := *&rawptr(a.data)
        if ptr == null {
            n += w.write([]u8("null"))?
        } else {
            buffer: [32]u8
            count := C.snprintf(&C.char(buffer.data), C.size_t(buffer.count), "0x%zx", ptr)
            n += w.write(buffer[..count])?
        }

    case Type_Info_Enumeration
        value: s64
        if v.underlying.size == {
        case 1; value = s64(*&s8(a.data))
        case 2; value = s64(*&s16(a.data))
        case 4; value = s64(*&s32(a.data))
        case 8; value = s64(*&s64(a.data))
        }

        for i := 0; i < v.values.count; i += 1 {
            if v.values[i] == value {
                n += w.write([]u8(v.names[i]))?
                return n, null
            }
        }

        if v.underlying == error {
            err := u64(value)
            if err == 0 {
                n += w.write([]u8("null"))?
            } else {
                n += wprint(w, "(Invalid error value: \{err})")?
            }
        } else {
            n += wprint(w, "(Invalid enum value: \{value})")?
        }

    case Type_Info_Trait
        t: Any
        t.type = *&Type(a.data)
        t.data = *&rawptr(a.data + rawptr(8))
        if t.type == null {
            n += w.write([]u8("null"))?
        } else {
            n += write_value(w, t, nested)?
        }

    case Type_Info_Union
        tag := *&s64(a.data)
        if tag == 0 {
            n += w.write([]u8("null"))?
        } else if tag - 1 >= v.variants.count {
            n += wprint(w, "(Invalid union tag: \{tag})")?
        } else {
            t: Any
            t.type = v.variants[tag - 1]
            t.data = a.data + rawptr(8)
            n += write_value(w, t, nested)?
        }

    case Type_Info_Structure
        n += w.write([]u8("{"))?
        for i := 0; i < v.types.count; i += 1 {
            field: Any
            field.type = v.types[i]
            field.data = a.data + rawptr(v.offsets[i])
            if i != 0 {
                n += w.write([]u8(", "))?
            }
            n += write_value(w, field, true)?
        }
        n += w.write([]u8("}"))?

    case Type_Info_Array
        n += w.write([]u8("{"))?
        for i := 0; i < v.count; i += 1 {
            if i != 0 {
                n += w.write([]u8(", "))?
            }

            item: Any
            item.type = v.underlying
            item.data = a.data + rawptr(i * v.underlying.size)
            n += write_value(w, item, true)?
        }
        n += w.write([]u8("}"))?

    case Type_Info_Dynamic_Array
        data  := *&rawptr(a.data)
        count := *&s64(a.data + rawptr(8))

        n += w.write([]u8("{"))?
        for i := 0; i < count; i += 1 {
            if i != 0 {
                n += w.write([]u8(", "))?
            }

            item: Any
            item.type = v.underlying
            item.data = data + rawptr(i * v.underlying.size)
            n += write_value(w, item, true)?
        }
        n += w.write([]u8("}"))?

    case Type_Info_Map
        data     := *&rawptr(a.data)
        count    := *&s64(a.data + rawptr(8))
        capacity := *&s64(a.data + rawptr(16))

        n += w.write([]u8("{"))?
        if count != 0 {
            first := true
            for i := range capacity {
                entry, key_ptr, value_ptr := map_entry_get_raw(data, v.key, v.value, i)
                if entry != .OCCUPIED {
                    continue
                }

                if first {
                    first = false
                } else {
                    n += w.write([]u8(", "))?
                }

                a: Any
                a.type = v.key
                a.data = key_ptr
                n += write_value(w, a, true)?

                n += w.write([]u8(" = "))?
                a.type = v.value
                a.data = value_ptr
                n += write_value(w, a, true)?
            }
        }
        n += w.write([]u8("}"))?

    case Type_Info_Slice
        count := *&s64(a.data + rawptr(8))
        data  := *&rawptr(a.data)

        n += w.write([]u8("{"))?
        for i := 0; i < count; i += 1 {
            if i != 0 {
                n += w.write([]u8(", "))?
            }

            item: Any
            item.type = v.underlying
            item.data = data + rawptr(i * v.underlying.size)
            n += write_value(w, item, true)?
        }
        n += w.write([]u8("}"))?

    case Type_Info_Error
        err := *(&u64)(a.data)
        if err == 0 {
            n += w.write([]u8("null"))?
            return n, null
        }

        index := u32(err >> 32)
        if index != 0 {
            index -= 1
            if s64(index) < error_enums.count {
                v := error_enums[index].variant.(Type_Info_Enumeration)
                for i := 0; i < v.values.count; i += 1 {
                    if v.values[i] == s64(err) {
                        n += w.write([]u8(v.names[i]))?
                        return n, null
                    }
                }
            }
        }

        n += wprint(w, "(Invalid error value: \{err})")?

    case Type_Info_String
        s := *&string(a.data)
        if nested {
            n += w.write([]u8("\""))?
            for _, c := range s {
                n += write_quoted_rune(w, c, '"')?
            }
            n += w.write([]u8("\""))?
        } else {
            n += w.write([]u8(s))?
        }

    case null
        n += w.write([]u8("null"))?
    }

    return n, null
}

error_enums: []Type
