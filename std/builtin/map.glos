free :: (this: &map[$K]$V) {
    C.free(this.data)
    C.memset(rawptr(this), 0, sizeof(*this))
}

clear :: (this: &map[$K]$V) {
    KV :: Map_Entry(K, V)
    if this.data != null {
        C.memset(this.data, 0, u64(this.capacity) * sizeof(KV))
        this.count = 0
    }
}

delete :: (this: &map[$K]$V, key: K, location := #caller_location) -> V {
    KV  :: Map_Entry(K, V)
    src := map_entry_find(&KV(this.data), this.capacity, this.info, key)
    if src != null && src.state == .OCCUPIED {
        value := src.value
        C.memset(rawptr(src), 0, sizeof(*src))
        this.count -= 1
        return value
    }
    map_entry_not_found(location, key)
}

contains :: (this: &map[$K]$V, key: K) -> bool {
    KV  :: Map_Entry(K, V)
    src := map_entry_find(&KV(this.data), this.capacity, this.info, key)
    return src != null && src.state == .OCCUPIED
}

operator [] :: (this: &map[$K]$V, key: K, assign: bool, location := #caller_location) -> &V {
    KV :: Map_Entry(K, V)
    if assign {
        LOAD_FACTOR   :: 0.75
        INIT_CAPACITY :: 128

        if this.count >= s64(f64(this.capacity) * LOAD_FACTOR) {
            capacity := this.capacity * 2
            if capacity == 0 then capacity = INIT_CAPACITY

            data := &KV(C.calloc(u64(capacity), sizeof(KV)))
            for i := 0; i < this.capacity; i += 1 {
                src := &KV(this.data) + &KV(i * sizeof(KV))
                if src.state == .OCCUPIED {
                    dst := map_entry_find(data, capacity, this.info, src.key)
                    *dst = *src
                }
            }

            C.free(this.data)
            this.data = rawptr(data)
            this.capacity = capacity
        }

        dst := map_entry_find(&KV(this.data), this.capacity, this.info, key)
        if dst.state != .OCCUPIED {
            dst.state = .OCCUPIED
            this.count += 1
        }

        dst.key = key
        return &dst.value
    } else {
        src := map_entry_find(&KV(this.data), this.capacity, this.info, key)
        if src != null && src.state == .OCCUPIED {
            return &src.value
        }
        map_entry_not_found(location, key)
    }
}

range :: (this: &map[$K]$V, index: &s64) -> K, #reference V, bool {
    if this.count != 0 {
        KV :: Map_Entry(K, V)
        entry: &KV
        for *index < this.capacity {
            entry = &KV(this.data) + &KV(*index * sizeof(KV))
            *index += 1

            if entry.state == .OCCUPIED {
                return entry.key, &entry.value, true
            }
        }
    }

    return K {}, null, false
}

#private ...
Map_Entry_State :: enum {
    EMPTY
    OCCUPIED
    TOMBSTONE
}

Map_Entry :: struct ($K: Type, $V: Type) {
    state: Map_Entry_State
    key:   K
    value: V
}

map_entry_find :: (data: &Map_Entry($K, $V), capacity: s64, info: []Hash_Info, key: K) -> &Map_Entry(K, V) {
    KV :: typeof(*data)

    start: u64
    {
        data := rawptr(&key)
        hasher: Hasher
        for i := 0; i < info.count; i += 1 {
            it := info[i]
            if it.kind == {
            case .RAW
                hasher.bytes(&char(data)[it.offset..it.offset + it.size])

            case .FLOAT
                if it.size == {
                case sizeof(f32); hasher.float(f64(*(&f32)(data + rawptr(it.offset))))
                case sizeof(f64); hasher.float(*(&f64)(data + rawptr(it.offset)))
                case;             unreachable()
                }

            case .STRING
                hasher.bytes(*(&[]char)(data + rawptr(it.offset)))
            }
        }
        start = hasher.finish()

        #import "hash"
    }

    tombstone: &KV
    for i := 0; i < capacity; i += 1 {
        index := (start + u64(i)) & u64(capacity - 1)
        entry := data + &KV(index * sizeof(KV))
        if entry.state == {
        case .EMPTY
            if tombstone != null {
                return tombstone
            } else {
                return entry
            }

        case .OCCUPIED
            if entry.key == key {
                return entry
            }

        case .TOMBSTONE
            if tombstone == null {
                tombstone = entry
            }
        }
    }

    return tombstone
}

map_entry_not_found :: noreturn (location: Source_Code_Location, key: $K) {
    wprint(os.stderr, "\{location} Entry not found: ")
    write_value(os.stderr, key, true)
    wprintln(os.stderr)

    C.fflush(os.stdout)
    C.fflush(os.stderr)
    C.abort()
}

map_entry_get_raw :: inline (data: rawptr, key: Type, value: Type, index: s64) -> Map_Entry_State, rawptr, rawptr {
    Key_Offset   :: sizeof(Map_Entry_State)
    Value_Offset := (Key_Offset + key.size + 7) & -8
    Entry_Size   := (Value_Offset + value.size + 7) & -8
    entry        := data + rawptr(Entry_Size * index)
    return *(&Map_Entry_State)(entry), entry + rawptr(Key_Offset), entry + rawptr(Value_Offset)
}
