Writer :: trait {
    write: (bytes: []u8) -> s64, error
}

wprint :: (w: Writer, vs: ...Any) -> s64, error {
    n := 0
    interpolating := 0
    for i := 0; i < vs.count; i += 1 {
        if interpolating != 0 {
            interpolating -= 1
        } else if i != 0 {
            n += w.write([]u8(" "))?
        }

        v := vs[i]
        if v.type == Interpolation_Marker {
            interpolating = s64(v.data)
            continue
        }

        if v == null {
            n += w.write([]u8("null"))?
        } else {
            n += write_value(w, v, false)?
        }
    }
    return n, null
}

wprintln :: (w: Writer, vs: ...Any) -> s64, error {
    wprint(w, ...vs)?
    return wprint(w, '\n')
}

print :: (vs: ...Any) -> s64, error {
    return wprint(os.stdout, ...vs)
}

println :: (vs: ...Any) -> s64, error {
    return wprintln(os.stdout, ...vs)
}

eprint :: (vs: ...Any) -> s64, error {
    return wprint(os.stderr, ...vs)
}

eprintln :: (vs: ...Any) -> s64, error {
    return wprintln(os.stderr, ...vs)
}

#private
Interpolation_Marker :: distinct s64
