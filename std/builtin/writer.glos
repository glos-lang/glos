wprint :: inline (w: io.Writer, vs: ...fmt.Format) -> s64, error {
    return fmt.values(w, vs)
}

wprintln :: inline (w: io.Writer, vs: ...fmt.Format) -> s64, error {
    wprint(w, ...vs)?
    return wprint(w, '\n')
}

print :: inline (vs: ...fmt.Format) -> s64, error {
    return wprint(os.stdout, ...vs)
}

println :: inline (vs: ...fmt.Format) -> s64, error {
    return wprintln(os.stdout, ...vs)
}

eprint :: inline (vs: ...fmt.Format) -> s64, error {
    return wprint(os.stderr, ...vs)
}

eprintln :: inline (vs: ...fmt.Format) -> s64, error {
    return wprintln(os.stderr, ...vs)
}

io :: #import "io"
