Allocator :: trait {
    alloc:  (size: s64, old := null, align := true, zeroed := true, location := #caller_location) -> rawptr, error
    rewind: (ptr: rawptr, align := true, location := #caller_location)
}

default_allocator   := Allocator(&c_allocator)
temporary_allocator := Allocator(&t_allocator)

#private...

C_Allocator :: struct {}

alloc :: (this: &C_Allocator, size: s64, old := null, align := true, zeroed := true, location := #caller_location) -> rawptr, error {
    new: rawptr
    if old != null {
        if size == 0 {
            C.free(old)
            return new, null
        }

        new = C.realloc(old, C.size_t(size))
    } else {
        if size == 0 {
            return new, null
        }

        if zeroed {
            new = C.calloc(1, C.size_t(size))
        } else {
            new = C.malloc(C.size_t(size))
        }
    }

    if new == null {
        return new, C.get_errno()
    }
    return new, null
}

rewind :: (this: &C_Allocator, ptr: rawptr, align := true, location := #caller_location) {}

c_allocator := C_Allocator {}
t_allocator := #import "arena".Arena { capacity = 16 * 1024 * 1024 }
