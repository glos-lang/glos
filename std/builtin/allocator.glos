Allocator :: trait {
    alloc:  (size: s64, old := null, align := true, zeroed := true, location := #caller_location) -> rawptr
    rewind: (ptr: rawptr, align := true, location := #caller_location)
}

default_allocator:   Allocator = &c_allocator
temporary_allocator: Allocator = &t_allocator

new :: ($T: Type, n := 1, allocator := default_allocator, zeroed := true) -> &T {
    return &T(allocator.alloc(n * sizeof(T), zeroed = zeroed))
}

free :: (p: &$T, allocator := default_allocator) {
    allocator.alloc(0, old = rawptr(p))
}

resize :: (p: &$T, size: s64, allocator := default_allocator) {
    allocator.alloc(size * sizeof(T), old = rawptr(p))
}

clone :: (v: $T, allocator := default_allocator) -> &T {
    return &T(C.memcpy(allocator.alloc(sizeof(T), zeroed = false), rawptr(&v), sizeof(v)))
}

#private...

C_Allocator :: struct {}

alloc :: (this: &C_Allocator, size: s64, old := null, align := true, zeroed := true, location := #caller_location) -> rawptr {
    if old != null {
        if size == 0 {
            free(old)
            return null
        }

        return realloc(old, u64(size))
    } else {
        if size == 0 {
            return null
        }

        if zeroed {
            return calloc(1, u64(size))
        }

        return malloc(u64(size))
    }

    extern {
        free    :: (ptr: rawptr)
        malloc  :: (size: u64) -> rawptr
        calloc  :: (n: u64, size: u64) -> rawptr
        realloc :: (ptr: rawptr, size: u64) -> rawptr
    }
}

rewind :: (this: &C_Allocator, ptr: rawptr, align := true, location := #caller_location) {}

c_allocator := C_Allocator {}
t_allocator := #import "arena".Arena { capacity = 16 * 1024 * 1024 }
