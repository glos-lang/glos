find :: (this: string, p: strings.Predicate, reverse := false) -> s64, bool {
    if p == {
    case rune
        if reverse {
            for i, c := range strings.Reverse(this) {
                if c == p {
                    return i, true
                }
            }
        } else {
            for i, c := range this {
                if c == p {
                    return i, true
                }
            }
        }

    case string
        if p == "" {
            return 0, true
        }

        if p.count > this.count {
            return 0, false
        }

        if reverse {
            for i := range this.count..>=p.count {
                if this[i..].begins_with(p) {
                    return i, true
                }
            }
        } else {
            for i := range this.count - p.count + 1 {
                if this[i..].begins_with(p) {
                    return i, true
                }
            }
        }

    case (c: rune) -> bool
        if p == null {
            return 0, false
        }

        if reverse {
            for i, c := range strings.Reverse(this) {
                if p(c) {
                    return i, true
                }
            }
        } else {
            for i, c := range this {
                if p(c) {
                    return i, true
                }
            }
        }

    case null; unreachable()
    }

    return 0, false
}

split :: (this: string, p: strings.Predicate, reverse := false) -> string, string, bool {
    n, found := this.find(p, reverse)
    if !found {
        return this, "", false
    }

    lhs := this[..n]
    if p == string {
        return lhs, this[n + p.count..], true
    } else {
        return lhs, this[n + 1..], true
    }
}

trim :: (this: string, p: strings.Predicate) -> string {
    return this.trim_left(p).trim_right(p)
}

trim_left :: (this: string, p: strings.Predicate) -> string {
    if p == {
    case rune
        for i, c := range this {
            if c != p {
                return this[i..]
            }
        }

    case string
        if p == "" {
            return this
        }

        for i := 0; i < this.count; i += p.count {
            s := this[i..]
            if !s.begins_with(p) {
                return s
            }
        }

    case (c: rune) -> bool
        if p == null {
            return this
        }

        for i, c := range this {
            if !p(c) {
                return this[i..]
            }
        }

    case null; unreachable()
    }

    return ""
}

trim_right :: (this: string, p: strings.Predicate) -> string {
    if p == {
    case rune
        for i, c := range strings.Reverse(this) {
            if c != p {
                return this[..i + 1]
            }
        }

    case string
        if p != "" {
            for this.ends_with(p) {
                this.count -= p.count
            }
        }
        return this

    case (c: rune) -> bool
        if p == null {
            return this
        }

        for i, c := range strings.Reverse(this) {
            if !p(c) {
                return this[..i + 1]
            }
        }

    case null; unreachable()
    }

    return ""
}

begins_with :: (this: string, p: string) -> bool {
    if p == "" {
        return true
    }
    return this.count >= p.count && C.memcmp(rawptr(this.data), rawptr(p.data), u64(p.count)) == 0
}

ends_with :: (this: string, p: string) -> bool {
    if p == "" {
        return true
    }
    return this.count >= p.count && C.memcmp(rawptr(&this[this.count - p.count]), rawptr(p.data), u64(p.count)) == 0
}

// Runtime support
operator <=> :: (this: string, that: string) -> Ordering {
    n := this.count
    if n > that.count {
        n = that.count
    }

    diff := C.memcmp(rawptr(this.data), rawptr(that.data), u64(n))
    if diff < 0 {
        return .LT
    }

    if diff > 0 {
        return .GT
    }

    if this.count < that.count {
        return .LT
    }

    if this.count > that.count {
        return .GT
    }

    return .EQ
}

range :: (this: string, state: &s64) -> s64, rune, bool {
    index := *state
    if index >= this.count {
        return index, 0, false
    }

    r, n, ok := unicode.decode([]u8(this)[index..])
    if !ok then n = 1
    *state += n
    return index, r, true
}

reverse :: inline (this: string) -> strings.Reverse {
    return strings.Reverse(this)
}

unicode :: #import "unicode"
