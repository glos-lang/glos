find :: (this: string, predicate: string) -> s64, bool {
    if predicate == "" {
        return 0, true
    }

    for i := 0; i < this.count; i += 1 {
        if this[i..].has_prefix(predicate) {
            return i, true
        }
    }

    return 0, false
}

split :: (this: string, by: char) -> string, string, bool {
    lhs := this
    rhs := this

    p := C.memchr(rawptr(this.data), s32(by), u64(this.count))
    if p == null {
        rhs.data += &char(this.count)
        rhs.count = 0
        return lhs, rhs, false
    }

    lhs = this[..(s64(p) - s64(this.data))]
    rhs.data = &char(p) + &char(1)
    rhs.count -= lhs.count + 1
    return lhs, rhs, true
}

has_prefix :: (this: string, prefix: string) -> bool {
    return this.count >= prefix.count && C.memcmp(rawptr(this.data), rawptr(prefix.data), u64(prefix.count)) == 0
}

// Runtime support
operator <=> :: (this: string, that: string) -> Ordering {
    n := this.count
    if n > that.count {
        n = that.count
    }

    diff := C.memcmp(rawptr(this.data), rawptr(that.data), u64(n))
    if diff < 0 {
        return .LT
    }

    if diff > 0 {
        return .GT
    }

    if this.count < that.count {
        return .LT
    }

    if this.count > that.count {
        return .GT
    }

    return .EQ
}

range :: (this: string, state: &s64) -> s64, rune, bool {
    utf8_sequence_count :: (b: u8) -> s64 {
        if b & 0x80 == 0x00 then return 1 // 0xxxxxxx
        if b & 0xE0 == 0xC0 then return 2 // 110xxxxx
        if b & 0xF0 == 0xE0 then return 3 // 1110xxxx
        if b & 0xF8 == 0xF0 then return 4 // 11110xxx
        return 0
    }

    index := *state
    if *state >= this.count {
        return index, 0, false
    }

    byte  := u8(this[*state])
    count := utf8_sequence_count(byte)
    if count == 0 {
        // Invalid leading byte (e.g. a stray continuation byte 10xxxxxx,
        // or 0xF8-0xFF which are never valid in UTF-8).
        *state += 1
        return index, -1, true
    }

    if *state + count > this.count {
        // Sequence would run past the end of the buffer.
        *state += 1
        return index, -1, true
    }

    cp:     rune
    min_cp: s64 // Smallest code point that legitimately needs 'count' bytes

    if count == {
    case 1
        cp = rune(byte)
        *state += 1
        return index, cp, true

    case 2
        cp = rune(byte) & 0x1F
        min_cp = 0x80

    case 3
        cp = rune(byte) & 0x0F
        min_cp = 0x800

    case 4
        cp = rune(byte) & 0x07
        min_cp = 0x10000
    }

    for i := range 1..count {
        b := u8(this[*state + i])
        if b & 0xC0 != 0x80 {
            // Expected a continuation byte (10xxxxxx) and didn't get one.
            *state += 1
            return index, -1, true
        }
        cp = (cp << 6) | rune(b & 0x3F)
    }

    // Reject overlong encodings, surrogate halves, and out-of-range code points.
    if s64(cp) < min_cp || (cp >= 0xD800 && cp <= 0xDFFF) || cp > 0x10FFFF {
        *state += 1
        return index, -1, true
    }

    *state += count
    return index, cp, true
}
