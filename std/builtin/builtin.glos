panic :: noreturn (message: ...Any, location := #caller_location, label := "") {
    eprint(location, label)
    wprint(&Prefix_With_Colon {label != ""}, ...message)
    eprintln()

    C.fflush(os.stdout)
    C.fflush(os.stderr)
    C.abort()

    Prefix_With_Colon :: struct {
        needed: bool
    }

    write :: (this: &Prefix_With_Colon, bytes: []char) {
        if this.needed && bytes.count != 0 {
            this.needed = false
            os.stderr.write([]char(": "))
        }
        os.stderr.write(bytes)
    }
}

assert :: (cond: bool, message: ...Any, location := #caller_location) {
    if !cond {
        panic(message = message, location = location, label = "Assertion Failed")
    }
}

todo :: noreturn (message: ...Any, location := #caller_location) {
    panic(message = message, location = location, label = "TODO")
}

unreachable :: noreturn (message: ...Any, location := #caller_location) {
    panic(message = message, location = location, label = "Unreachable")
}

operator <=> :: (this: string, that: string) -> Ordering {
    n := this.count
    if n > that.count {
        n = that.count
    }

    diff := C.memcmp(rawptr(this.data), rawptr(that.data), u64(n))
    if diff < 0 {
        return .LT
    }

    if diff > 0 {
        return .GT
    }

    if this.count < that.count {
        return .LT
    }

    if this.count > that.count {
        return .GT
    }

    return .EQ
}

New :: ($T: Type, n := 1, a := &arena.default) -> &T {
    return &T(a.alloc(n * sizeof(T)))
}

New_Array :: ($T: Type, n: s64, a := &arena.default) -> []T {
    return []T(&T(a.alloc(n * sizeof(T))), n)
}

Clone :: (v: $T, a := &arena.default) -> &T {
    return &T(C.memcpy(a.alloc(sizeof(T)), rawptr(&v), sizeof(v)))
}
