panic :: noreturn (message: ...fmt.Format, location := #caller_location, label := "") {
    eprint(location, label)
    wprint(&Prefix_With_Colon {label != ""}, ...message)
    eprintln()

    C.fflush(C.FILE(os.stdout))
    C.fflush(C.FILE(os.stderr))
    C.abort()

    Prefix_With_Colon :: struct {
        needed: bool
    }

    write :: (this: &Prefix_With_Colon, bytes: []u8) -> s64, error {
        if this.needed && bytes.count != 0 {
            this.needed = false
            os.stderr.write([]u8(": "))?
        }
        return os.stderr.write(bytes)
    }
}

assert :: (cond: bool, message: ...fmt.Format, location := #caller_location) {
    if !cond {
        panic(message = message, location = location, label = "Assertion Failed")
    }
}

todo :: noreturn (message: ...fmt.Format, location := #caller_location) {
    panic(message = message, location = location, label = "TODO")
}

unreachable :: noreturn (message: ...fmt.Format, location := #caller_location) {
    panic(message = message, location = location, label = "Unreachable")
}
