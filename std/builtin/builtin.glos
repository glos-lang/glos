@format :: (this: &Type, w: io.Writer, nested: bool) -> s64, error {
    return fmt.type(w, *this)
}

@format :: (this: &Source_Code_Location, w: io.Writer, nested: bool) -> s64, error {
    if nested {
        return wprint(w, "{\{this.path}, \{this.row}, \{this.col}}")
    }
    return wprint(w, "\{this.path}:\{this.row}:\{this.col}:")
}

panic :: (message: ...fmt.Format, location := #caller_location, label := "") -> ! {
    C.fflush(C.FILE(os.stdout))

    eprint(location, label)
    wprint(&Prefix_With_Colon {label != ""}, ...message)
    eprintln()

    C.fflush(C.FILE(os.stderr))
    C.abort()

    Prefix_With_Colon :: struct {
        needed: bool
    }

    write :: (this: &Prefix_With_Colon, bytes: []u8) -> s64, error {
        if this.needed && bytes.count != 0 {
            this.needed = false
            os.stderr.write([]u8(": "))?
        }
        return os.stderr.write(bytes)
    }
}

assert :: inline (cond: bool, message: ...fmt.Format, location := #caller_location) {
    if !cond {
        panic(message = message, location = location, label = "Assertion Failed")
    }
}

todo :: inline (message: ...fmt.Format, location := #caller_location) -> ! {
    panic(message = message, location = location, label = "TODO")
}

unreachable :: inline (message: ...fmt.Format, location := #caller_location) -> ! {
    panic(message = message, location = location, label = "Unreachable")
}
