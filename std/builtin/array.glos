push :: (this: &[..]$T, v: T) {
    if this.count >= this.capacity {
        if this.allocator == null then this.allocator = default_allocator
        this.capacity *= 2
        if this.capacity == 0 then this.capacity = 128

        this.data = &T(mem.resize(this.data, this.capacity, allocator = this.allocator))
        assert(this.data != null)
    }

    *(this.data + &T(this.count * sizeof(T))) = v
    this.count += 1
}

free :: (this: &[..]$T) {
    if this.allocator == null then this.allocator = default_allocator
    mem.free(this.data, allocator = this.allocator)
    mem.zero(this)
}

remove :: (this: &[..]$T, index: s64, location := #caller_location) -> T {
    if index >= this.count {
        panic("Bounds Check Failed: Index \{index} is invalid since length is \{this.count}", location = location)
    }

    value := (*this)[index]
    if index + 1 < this.count {
        mem.copy(&this[index], &this[index + 1], this.count - index - 1)
    }

    this.count -= 1
    return value
}
