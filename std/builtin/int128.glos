S128 :: distinct I128
U128 :: distinct I128

s128 :: (n: s64) -> S128 {
    result: S128
    result.low = u64(n)
    if n < 0 then result.high = math.U64_MAX
    return result
}

u128 :: (n: u64) -> U128 {
    result: U128
    result.low = n
    return result
}

operator + :: inline (this: S128, that: S128) -> S128 {
    return S128(add(I128(this), I128(that)))
}

operator - :: inline (this: S128, that: S128) -> S128 {
    return S128(sub(I128(this), I128(that)))
}

operator * :: inline (this: S128, that: S128) -> S128 {
    return S128(mul(I128(this), I128(that), true))
}

operator / :: inline (this: S128, that: S128) -> S128 {
    q, _ := divmod(I128(this), I128(that), true)
    return S128(q)
}

operator % :: inline (this: S128, that: S128) -> S128 {
    _, r := divmod(I128(this), I128(that), true)
    return S128(r)
}

operator <=> :: inline (this: S128, that: S128) -> Ordering {
    return cmp(I128(this), I128(that), true)
}

operator + :: inline (this: U128, that: U128) -> U128 {
    return U128(add(I128(this), I128(that)))
}

operator - :: inline (this: U128, that: U128) -> U128 {
    return U128(sub(I128(this), I128(that)))
}

operator * :: inline (this: U128, that: U128) -> U128 {
    return U128(mul(I128(this), I128(that), false))
}

operator / :: inline (this: U128, that: U128) -> U128 {
    q, _ := divmod(I128(this), I128(that), false)
    return U128(q)
}

operator % :: inline (this: U128, that: U128) -> U128 {
    _, r := divmod(I128(this), I128(that), false)
    return U128(r)
}

operator <=> :: inline (this: U128, that: U128) -> Ordering {
    return cmp(I128(this), I128(that), false)
}

@format :: (this: &S128, w: io.Writer, _: bool) -> s64, error {
    return format(I128(*this), w, true)
}

@format :: (this: &U128, w: io.Writer, _: bool) -> s64, error {
    return format(I128(*this), w, false)
}

#private...
I128 :: struct {
    low:  u64
    high: u64
}

add :: (a: I128, b: I128) -> I128 {
    result: I128
    result.low = a.low + b.low
    result.high = a.high + b.high + u64(result.low < a.low)
    return result
}

sub :: (a: I128, b: I128) -> I128 {
    result: I128
    result.low = a.low - b.low
    result.high = a.high - b.high - u64(a.low < b.low)
    return result
}

mul :: (a: I128, b: I128, signed: bool) -> I128 {
    negate := false
    if signed {
        if is_neg(a) {
            a = neg(a)
            negate = !negate
        }

        if is_neg(b) {
            b = neg(b)
            negate = !negate
        }
    }

    lo_lo_hi, lo_lo_lo: u64
    hi_lo_hi, hi_lo_lo: u64
    lo_hi_hi, lo_hi_lo: u64

    // al * bl
    mul64wide(a.low, b.low, &lo_lo_hi, &lo_lo_lo)

    // ah * bl
    mul64wide(a.high, b.low, &hi_lo_hi, &hi_lo_lo)

    // al * bh
    mul64wide(a.low, b.high, &lo_hi_hi, &lo_hi_lo)

    r: I128
    r.low = lo_lo_lo

    //
    //  Low 128 bits are:
    //
    //      lo_lo_lo
    //      lo_lo_hi + hi_lo_lo + lo_hi_lo   (mod 2^64)
    //
    //  Products involving hi_lo_hi, lo_hi_hi, and ah*bh land at
    //  bit 128 or above and are discarded.
    //
    r.high = lo_lo_hi
    r.high += hi_lo_lo
    r.high += lo_hi_lo

    if negate then r = neg(r)
    return r

    // 64x64 -> 128 multiplication
    mul64wide :: (a: u64, b: u64, hi: &u64, lo: &u64) {
        a0 := u64(u32(a))
        a1 := a >> 32
        b0 := u64(u32(b))
        b1 := b >> 32

        p00 := a0 * b0
        p01 := a0 * b1
        p10 := a1 * b0
        p11 := a1 * b1

        middle := (p00 >> 32) + u64(u32(p01) + u32(p10))
        *lo = (p00 & 0xFFFFFFFF) | (middle << 32)
        *hi = p11 + (p01 >> 32) + (p10 >> 32) + (middle >> 32)
    }
}

divmod :: (a: I128, b: I128, signed: bool) -> I128, I128 {
    quotient:  I128
    remainder: I128

    qneg := false
    rneg := false

    if signed {
        if is_neg(a) {
            a = neg(a)
            qneg = !qneg
            rneg = true
        }

        if is_neg(b) {
            b = neg(b)
            qneg = !qneg
        }
    }

    // Division by zero. Leave behavior to caller if desired
    if b.high == 0 && b.low == 0 {
        return quotient, remainder
    }

    for bit := range 127..>=0 {
        remainder = shl1(remainder)
        if getbit(a, u32(bit)) {
            remainder.low |= 1
        }

        if cmp_u(remainder, b) >= 0 {
            remainder = sub(remainder, b)
            setbit(&quotient, u32(bit))
        }
    }

    if signed {
        if qneg then quotient = neg(quotient)
        if rneg then remainder = neg(remainder)
    }

    return quotient, remainder

    // Shift left by one bit
    shl1 :: (x: I128) -> I128 {
        r: I128
        r.high = (x.high << 1) | (x.low >> 63)
        r.low = x.low << 1
        return r
    }

    // Unsigned comparison. Returns -1,0,+1
    cmp_u :: (a: I128, b: I128) -> s32 {
        if a.high < b.high then return -1
        if a.high > b.high then return 1
        if a.low < b.low   then return -1
        if a.low > b.low   then return 1
        return 0
    }

    // Get bit [0,127]
    getbit :: (x: I128, bit: u32) -> bool {
        if bit < 64 then return bool((x.low >> u64(bit)) & 1)
        return bool((x.high >> u64(bit - 64)) & 1)
    }

    // Set bit [0,127]
    setbit :: (x: &I128, bit: u32) {
        if bit < 64 then x.low |= 1 << u64(bit)
        else x.high |= 1 << u64(bit - 64)
    }

}

cmp :: (a: I128, b: I128, signed: bool) -> Ordering {
    if signed {
        a_neg := (a.high >> 63) != 0
        b_neg := (b.high >> 63) != 0

        // Different signs
        if a_neg != b_neg {
            if a_neg then return .LT else return .GT
        }
    }

    // Same sign (or unsigned): compare lexicographically
    if a.high < b.high then return .LT
    if a.high > b.high then return .GT
    if a.low < b.low   then return .LT
    if a.low > b.low   then return .GT
    return .EQ
}

neg :: (x: I128) -> I128 {
    r: I128
    r.low = ~x.low + 1
    r.high = ~x.high
    if r.low == 0 then r.high += 1
    return r
}

is_neg :: (x: I128) -> bool {
    return (x.high >> 63) != 0
}

format :: (n: I128, w: io.Writer, signed: bool) -> s64, error {
    buffer: [128]u8
    head := buffer.count

    zero := I128(u128(0))
    ten  := I128(u128(10))

    negative := false
    if signed && cmp(n, zero, signed) == .LT {
        negative = true
        n = neg(n)
    }

    if cmp(n, zero, signed) == .EQ {
        head -= 1
        buffer[head] = '0'
    } else {
        for cmp(n, zero, signed) != .EQ {
            q, r := divmod(n, ten, signed)
            head -= 1
            buffer[head] = u8('0') + u8(r.low)
            n = q
        }
    }

    if negative {
        head -= 1
        buffer[head] = '-'
    }
    return w.write(buffer[head..])
}

math :: #import "math"
