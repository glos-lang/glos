/**********************************************************************************************
*
*   raymath v2.0 - Math functions to work with Vector2, Vector3, Matrix and Quaternions
*
*   CONVENTIONS:
*     - Matrix structure is defined as row-major (memory layout) but parameters naming AND all
*       math operations performed by the library consider the structure as it was column-major
*       It is like transposed versions of the matrices are used for all the maths
*       It benefits some functions making them cache-friendly and also avoids matrix
*       transpositions sometimes required by OpenGL
*       Example: In memory order, row0 is [m0 m4 m8 m12] but in semantic math row0 is [m0 m1 m2 m3]
*     - Functions are always self-contained, no function use another raymath function inside,
*       required code is directly re-implemented inside
*     - Functions input parameters are always received by value (2 unavoidable exceptions)
*     - Functions use always a "result" variable for return (except C++ operators)
*     - Functions are always defined inline
*     - Angles are always in radians (DEG2RAD/RAD2DEG macros provided for convenience)
*     - No compound literals used to make sure the library is compatible with C++
*
*   CONFIGURATION:
*       #define RAYMATH_IMPLEMENTATION
*           Generates the implementation of the library into the included file
*           If not defined, the library is in header only mode and can be included in other headers
*           or source files without problems. But only ONE file should hold the implementation
*
*       #define RAYMATH_STATIC_INLINE
*           Define static inline functions code, so #include header suffices for use
*           This may use up lots of memory
*
*       #define RAYMATH_DISABLE_CPP_OPERATORS
*           Disables C++ operator overloads for raymath types.
*
*       #define RAYMATH_USE_SIMD_INTRINSICS   1
*           Try to enable SIMD intrinsics for MatrixMultiply()
*           Note that users enabling it must be aware of the target platform where application will
*           run to support the selected SIMD intrinsic, for now, only SSE is supported
*
*   LICENSE: zlib/libpng
*
*   Copyright (c) 2015-2026 Ramon Santamaria (@raysan5)
*
*   This software is provided "as-is", without any express or implied warranty. In no event
*   will the authors be held liable for any damages arising from the use of this software.
*
*   Permission is granted to anyone to use this software for any purpose, including commercial
*   applications, and to alter it and redistribute it freely, subject to the following restrictions:
*
*     1. The origin of this software must not be misrepresented; you must not claim that you
*     wrote the original software. If you use this software in a product, an acknowledgment
*     in the product documentation would be appreciated but is not required.
*
*     2. Altered source versions must be plainly marked as such, and must not be misrepresented
*     as being the original software.
*
*     3. This notice may not be removed or altered from any source distribution.
*
**********************************************************************************************/

extern {
    // Clamp float value
    Clamp :: (value: C.float, min: C.float, max: C.float) -> C.float

    // Calculate linear interpolation between two floats
    Lerp :: (start: C.float, end: C.float, amount: C.float) -> C.float

    // Normalize input value within input range
    Normalize :: (value: C.float, start: C.float, end: C.float) -> C.float

    // Remap input value within input range to output range
    Remap :: (value: C.float, inputStart: C.float, inputEnd: C.float, outputStart: C.float, outputEnd: C.float) -> C.float

    // Wrap input value from min to max
    Wrap :: (value: C.float, min: C.float, max: C.float) -> C.float

    // Check whether two given floats are almost equal
    FloatEquals :: (x: C.float, y: C.float) -> C.int

    // Vector with components value 0.0f
    Vector2Zero :: () -> Vector2

    // Vector with components value 1.0f
    Vector2One :: () -> Vector2

    // Add two vectors (v1 + v2)
    #link "Vector2Add"
    operator + :: (this: Vector2, v2: Vector2) -> Vector2

    // Add vector and float value
    #link "Vector2AddValue"
    AddValue :: (this: Vector2, add: C.float) -> Vector2

    // Subtract two vectors (v1 - v2)
    #link "Vector2Subtract"
    operator - :: (this: Vector2, v2: Vector2) -> Vector2

    // Subtract vector by float value
    #link "Vector2SubtractValue"
    SubtractValue :: (this: Vector2, sub: C.float) -> Vector2

    // Calculate vector length
    #link "Vector2Length"
    Length :: (this: Vector2) -> C.float

    // Calculate vector square length
    #link "Vector2LengthSqr"
    LengthSqr :: (this: Vector2) -> C.float

    // Calculate two vectors dot product
    #link "Vector2DotProduct"
    DotProduct :: (this: Vector2, v2: Vector2) -> C.float

    // Calculate two vectors cross product
    #link "Vector2CrossProduct"
    CrossProduct :: (this: Vector2, v2: Vector2) -> C.float

    // Calculate distance between two vectors
    #link "Vector2Distance"
    Distance :: (this: Vector2, v2: Vector2) -> C.float

    // Calculate square distance between two vectors
    #link "Vector2DistanceSqr"
    DistanceSqr :: (this: Vector2, v2: Vector2) -> C.float

    // Calculate the signed angle from v1 to v2, relative to the origin (0, 0)
    // NOTE: Coordinate system convention: positive X right, positive Y down
    // positive angles appear clockwise, and negative angles appear counterclockwise
    #link "Vector2Angle"
    Angle :: (this: Vector2, v2: Vector2) -> C.float

    // Calculate angle defined by a two vectors line
    // NOTE: Parameters need to be normalized
    // implementation: Current be: should with: aligned glm::angle
    #link "Vector2LineAngle"
    LineAngle :: (this: Vector2, end: Vector2) -> C.float

    // Scale vector (multiply by value)
    #link "Vector2Scale"
    Scale :: (this: Vector2, scale: C.float) -> Vector2

    // Multiply vector by vector
    #link "Vector2Multiply"
    operator * :: (this: Vector2, v2: Vector2) -> Vector2

    // Negate vector
    #link "Vector2Negate"
    Negate :: (this: Vector2) -> Vector2

    // Divide vector by vector
    #link "Vector2Divide"
    operator / :: (this: Vector2, v2: Vector2) -> Vector2

    // Normalize provided vector
    #link "Vector2Normalize"
    Normalize :: (this: Vector2) -> Vector2

    // Transforms a Vector2 by a given Matrix
    #link "Vector2Transform"
    Transform :: (this: Vector2, mat: Matrix) -> Vector2

    // Calculate linear interpolation between two vectors
    #link "Vector2Lerp"
    Lerp :: (this: Vector2, v2: Vector2, amount: C.float) -> Vector2

    // Calculate reflected vector to normal
    #link "Vector2Reflect"
    Reflect :: (this: Vector2, normal: Vector2) -> Vector2

    // Get min value for each pair of components
    #link "Vector2Min"
    Min :: (this: Vector2, v2: Vector2) -> Vector2

    // Get max value for each pair of components
    #link "Vector2Max"
    Max :: (this: Vector2, v2: Vector2) -> Vector2

    // Rotate vector by angle
    #link "Vector2Rotate"
    Rotate :: (this: Vector2, angle: C.float) -> Vector2

    // Move Vector towards target
    #link "Vector2MoveTowards"
    MoveTowards :: (this: Vector2, target: Vector2, maxDistance: C.float) -> Vector2

    // Invert the given vector
    #link "Vector2Invert"
    Invert :: (this: Vector2) -> Vector2

    // Clamp the components of the vector between
    // min and max values specified by the given vectors
    #link "Vector2Clamp"
    Clamp :: (this: Vector2, min: Vector2, max: Vector2) -> Vector2

    // Clamp the magnitude of the vector between two min and max values
    #link "Vector2ClampValue"
    ClampValue :: (this: Vector2, min: C.float, max: C.float) -> Vector2

    // Check whether two given vectors are almost equal
    #link "Vector2Equals"
    Equals :: (this: Vector2, q: Vector2) -> C.int

    // Compute the direction of a refracted ray
    // v: normalized direction of the incoming ray
    // n: normalized normal vector of the interface of two optical media
    // r: ratio of the refractive index of the medium from where the ray comes
    // to the refractive index of the medium on the other side of the surface
    #link "Vector2Refract"
    Refract :: (this: Vector2, n: Vector2, r: C.float) -> Vector2

    // Vector with components value 0.0f
    Vector3Zero :: () -> Vector3

    // Vector with components value 1.0f
    Vector3One :: () -> Vector3

    // Add two vectors
    #link "Vector3Add"
    operator + :: (this: Vector3, v2: Vector3) -> Vector3

    // Add vector and float value
    #link "Vector3AddValue"
    AddValue :: (this: Vector3, add: C.float) -> Vector3

    // Subtract two vectors
    #link "Vector3Subtract"
    operator - :: (this: Vector3, v2: Vector3) -> Vector3

    // Subtract vector by float value
    #link "Vector3SubtractValue"
    SubtractValue :: (this: Vector3, sub: C.float) -> Vector3

    // Multiply vector by scalar
    #link "Vector3Scale"
    Scale :: (this: Vector3, scalar: C.float) -> Vector3

    // Multiply vector by vector
    #link "Vector3Multiply"
    operator * :: (this: Vector3, v2: Vector3) -> Vector3

    // Calculate two vectors cross product
    #link "Vector3CrossProduct"
    CrossProduct :: (this: Vector3, v2: Vector3) -> Vector3

    // Calculate one vector perpendicular vector
    #link "Vector3Perpendicular"
    Perpendicular :: (this: Vector3) -> Vector3

    // Calculate vector length
    #link "Vector3Length"
    Length :: (this: Vector3) -> C.float

    // Calculate vector square length
    #link "Vector3LengthSqr"
    LengthSqr :: (this: Vector3) -> C.float

    // Calculate two vectors dot product
    #link "Vector3DotProduct"
    DotProduct :: (this: Vector3, v2: Vector3) -> C.float

    // Calculate distance between two vectors
    #link "Vector3Distance"
    Distance :: (this: Vector3, v2: Vector3) -> C.float

    // Calculate square distance between two vectors
    #link "Vector3DistanceSqr"
    DistanceSqr :: (this: Vector3, v2: Vector3) -> C.float

    // Calculate angle between two vectors
    #link "Vector3Angle"
    Angle :: (this: Vector3, v2: Vector3) -> C.float

    // Negate provided vector (invert direction)
    #link "Vector3Negate"
    Negate :: (this: Vector3) -> Vector3

    // Divide vector by vector
    #link "Vector3Divide"
    operator / :: (this: Vector3, v2: Vector3) -> Vector3

    // Normalize provided vector
    #link "Vector3Normalize"
    Normalize :: (this: Vector3) -> Vector3

    //Calculate the projection of the vector v1 on to v2
    #link "Vector3Project"
    Project :: (this: Vector3, v2: Vector3) -> Vector3

    //Calculate the rejection of the vector v1 on to v2
    #link "Vector3Reject"
    Reject :: (this: Vector3, v2: Vector3) -> Vector3

    // Orthonormalize provided vectors
    // Makes vectors normalized and orthogonal to each other
    // Gram-Schmidt function implementation
    Vector3OrthoNormalize :: (v1: &Vector3, v2: &Vector3)

    // Transforms a Vector3 by a given Matrix
    #link "Vector3Transform"
    Transform :: (this: Vector3, mat: Matrix) -> Vector3

    // Transform a vector by quaternion rotation
    #link "Vector3RotateByQuaternion"
    RotateByQuaternion :: (this: Vector3, q: Quaternion) -> Vector3

    // Rotates a vector around an axis
    #link "Vector3RotateByAxisAngle"
    RotateByAxisAngle :: (this: Vector3, axis: Vector3, angle: C.float) -> Vector3

    // Move Vector towards target
    #link "Vector3MoveTowards"
    MoveTowards :: (this: Vector3, target: Vector3, maxDistance: C.float) -> Vector3

    // Calculate linear interpolation between two vectors
    #link "Vector3Lerp"
    Lerp :: (this: Vector3, v2: Vector3, amount: C.float) -> Vector3

    // Calculate cubic hermite interpolation between two vectors and their tangents
    // as described in the GLTF 2.0 specification: https://registry.khronos.org/glTF/specs/2.0/glTF-2.0.html#interpolation-cubic
    #link "Vector3CubicHermite"
    CubicHermite :: (this: Vector3, tangent1: Vector3, v2: Vector3, tangent2: Vector3, amount: C.float) -> Vector3

    // Calculate reflected vector to normal
    #link "Vector3Reflect"
    Reflect :: (this: Vector3, normal: Vector3) -> Vector3

    // Get min value for each pair of components
    #link "Vector3Min"
    Min :: (this: Vector3, v2: Vector3) -> Vector3

    // Get max value for each pair of components
    #link "Vector3Max"
    Max :: (this: Vector3, v2: Vector3) -> Vector3

    // Compute barycenter coordinates (u, v, w) for point p with respect to triangle (a, b, c)
    // NOTE: Assumes P is on the plane of the triangle
    #link "Vector3Barycenter"
    Barycenter :: (this: Vector3, a: Vector3, b: Vector3, c: Vector3) -> Vector3

    // Projects a Vector3 from screen space into object space
    // NOTE: Self-contained function, no other raymath functions are called
    #link "Vector3Unproject"
    Unproject :: (this: Vector3, projection: Matrix, view: Matrix) -> Vector3

    // Get Vector3 as float array
    #link "Vector3ToFloatV"
    ToFloatV :: (this: Vector3) -> [3]C.float

    // Invert the given vector
    #link "Vector3Invert"
    Invert :: (this: Vector3) -> Vector3

    // Clamp the components of the vector between
    // min and max values specified by the given vectors
    #link "Vector3Clamp"
    Clamp :: (this: Vector3, min: Vector3, max: Vector3) -> Vector3

    // Clamp the magnitude of the vector between two values
    #link "Vector3ClampValue"
    ClampValue :: (this: Vector3, min: C.float, max: C.float) -> Vector3

    // Check whether two given vectors are almost equal
    #link "Vector3Equals"
    Equals :: (this: Vector3, q: Vector3) -> C.int

    // Compute the direction of a refracted ray
    // v: normalized direction of the incoming ray
    // n: normalized normal vector of the interface of two optical media
    // r: ratio of the refractive index of the medium from where the ray comes
    // to the refractive index of the medium on the other side of the surface
    #link "Vector3Refract"
    Refract :: (this: Vector3, n: Vector3, r: C.float) -> Vector3

    // Get  vector zero
    Vector4Zero :: () -> Vector4

    // Get vector one
    Vector4One :: () -> Vector4

    // Add two vectors
    #link "Vector4Add"
    operator + :: (this: Vector4, v2: Vector4) -> Vector4

    // Add value to vector components
    #link "Vector4AddValue"
    AddValue :: (this: Vector4, add: C.float) -> Vector4

    // Substract vectors
    #link "Vector4Subtract"
    operator - :: (this: Vector4, v2: Vector4) -> Vector4

    // Substract value from vector components
    #link "Vector4SubtractValue"
    SubtractValue :: (this: Vector4, add: C.float) -> Vector4

    // Vector length
    #link "Vector4Length"
    Length :: (this: Vector4) -> C.float

    // Vector square length
    #link "Vector4LengthSqr"
    LengthSqr :: (this: Vector4) -> C.float

    // Vectors dot product
    #link "Vector4DotProduct"
    DotProduct :: (this: Vector4, v2: Vector4) -> C.float

    // Calculate distance between two vectors
    #link "Vector4Distance"
    Distance :: (this: Vector4, v2: Vector4) -> C.float

    // Calculate square distance between two vectors
    #link "Vector4DistanceSqr"
    DistanceSqr :: (this: Vector4, v2: Vector4) -> C.float

    // Scale vector components by value (multiply)
    #link "Vector4Scale"
    Scale :: (this: Vector4, scale: C.float) -> Vector4

    // Multiply vector by vector
    #link "Vector4Multiply"
    operator * :: (this: Vector4, v2: Vector4) -> Vector4

    // Negate vector
    #link "Vector4Negate"
    Negate :: (this: Vector4) -> Vector4

    // Divide vector by vector
    #link "Vector4Divide"
    operator / :: (this: Vector4, v2: Vector4) -> Vector4

    // Normalize provided vector
    #link "Vector4Normalize"
    Normalize :: (this: Vector4) -> Vector4

    // Get min value for each pair of components
    #link "Vector4Min"
    Min :: (this: Vector4, v2: Vector4) -> Vector4

    // Get max value for each pair of components
    #link "Vector4Max"
    Max :: (this: Vector4, v2: Vector4) -> Vector4

    // Calculate linear interpolation between two vectors
    #link "Vector4Lerp"
    Lerp :: (this: Vector4, v2: Vector4, amount: C.float) -> Vector4

    // Move Vector towards target
    #link "Vector4MoveTowards"
    MoveTowards :: (this: Vector4, target: Vector4, maxDistance: C.float) -> Vector4

    // Invert the given vector
    #link "Vector4Invert"
    Invert :: (this: Vector4) -> Vector4

    // Check whether two given vectors are almost equal
    #link "Vector4Equals"
    Equals :: (this: Vector4, q: Vector4) -> C.int

    // Compute matrix determinant
    #link "MatrixDeterminant"
    Determinant :: (this: Matrix) -> C.float

    // Get the trace of the matrix (sum of the values along the diagonal)
    #link "MatrixTrace"
    Trace :: (this: Matrix) -> C.float

    // Transposes provided matrix
    #link "MatrixTranspose"
    Transpose :: (this: Matrix) -> Matrix

    // Invert provided matrix
    #link "MatrixInvert"
    Invert :: (this: Matrix) -> Matrix

    // Get identity matrix
    MatrixIdentity :: () -> Matrix

    // Add two matrices
    #link "MatrixAdd"
    operator + :: (this: Matrix, right: Matrix) -> Matrix

    // Subtract two matrices (left - right)
    #link "MatrixSubtract"
    operator - :: (this: Matrix, right: Matrix) -> Matrix

    // Get two matrix multiplication
    // NOTE: When multiplying matrices... the order matters!
    #link "MatrixMultiply"
    operator * :: (this: Matrix, right: Matrix) -> Matrix

    // Multiply matrix components by value
    #link "MatrixMultiplyValue"
    MultiplyValue :: (this: Matrix, value: C.float) -> Matrix

    // Get translation matrix
    MatrixTranslate :: (x: C.float, y: C.float, z: C.float) -> Matrix

    // Create rotation matrix from axis and angle
    // NOTE: Angle should be provided in radians
    MatrixRotate :: (axis: Vector3, angle: C.float) -> Matrix

    // Get x-rotation matrix
    // NOTE: Angle must be provided in radians
    MatrixRotateX :: (angle: C.float) -> Matrix

    // Get y-rotation matrix
    // NOTE: Angle must be provided in radians
    MatrixRotateY :: (angle: C.float) -> Matrix

    // Get z-rotation matrix
    // NOTE: Angle must be provided in radians
    MatrixRotateZ :: (angle: C.float) -> Matrix

    // Get xyz-rotation matrix
    // NOTE: Angle must be provided in radians
    MatrixRotateXYZ :: (angle: Vector3) -> Matrix

    // Get zyx-rotation matrix
    // NOTE: Angle must be provided in radians
    MatrixRotateZYX :: (angle: Vector3) -> Matrix

    // Get scaling matrix
    MatrixScale :: (x: C.float, y: C.float, z: C.float) -> Matrix

    // Get perspective projection matrix
    MatrixFrustum :: (left: C.double, right: C.double, bottom: C.double, top: C.double, nearPlane: C.double, farPlane: C.double) -> Matrix

    // Get perspective projection matrix
    // NOTE: Fovy angle must be provided in radians
    MatrixPerspective :: (fovY: C.double, aspect: C.double, nearPlane: C.double, farPlane: C.double) -> Matrix

    // Get orthographic projection matrix
    MatrixOrtho :: (left: C.double, right: C.double, bottom: C.double, top: C.double, nearPlane: C.double, farPlane: C.double) -> Matrix

    // Get camera look-at matrix (view matrix)
    MatrixLookAt :: (eye: Vector3, target: Vector3, up: Vector3) -> Matrix

    // Get float array of matrix data
    #link "MatrixToFloatV"
    ToFloatV :: (this: Matrix) -> [16]C.float

    // Add two quaternions
    #link "QuaternionAdd"
    operator + :: (this: Quaternion, q2: Quaternion) -> Quaternion

    // Add quaternion and float value
    #link "QuaternionAddValue"
    AddValue :: (this: Quaternion, add: C.float) -> Quaternion

    // Subtract two quaternions
    #link "QuaternionSubtract"
    operator - :: (this: Quaternion, q2: Quaternion) -> Quaternion

    // Subtract quaternion and float value
    #link "QuaternionSubtractValue"
    SubtractValue :: (this: Quaternion, sub: C.float) -> Quaternion

    // Get identity quaternion
    QuaternionIdentity :: () -> Quaternion

    // Computes the length of a quaternion
    #link "QuaternionLength"
    Length :: (this: Quaternion) -> C.float

    // Normalize provided quaternion
    #link "QuaternionNormalize"
    Normalize :: (this: Quaternion) -> Quaternion

    // Invert provided quaternion
    #link "QuaternionInvert"
    Invert :: (this: Quaternion) -> Quaternion

    // Calculate two quaternion multiplication
    #link "QuaternionMultiply"
    operator * :: (this: Quaternion, q2: Quaternion) -> Quaternion

    // Scale quaternion by float value
    #link "QuaternionScale"
    Scale :: (this: Quaternion, mul: C.float) -> Quaternion

    // Divide two quaternions
    #link "QuaternionDivide"
    operator / :: (this: Quaternion, q2: Quaternion) -> Quaternion

    // Calculate linear interpolation between two quaternions
    #link "QuaternionLerp"
    Lerp :: (this: Quaternion, q2: Quaternion, amount: C.float) -> Quaternion

    // Calculate slerp-optimized interpolation between two quaternions
    #link "QuaternionNlerp"
    Nlerp :: (this: Quaternion, q2: Quaternion, amount: C.float) -> Quaternion

    // Calculates spherical linear interpolation between two quaternions
    #link "QuaternionSlerp"
    Slerp :: (this: Quaternion, q2: Quaternion, amount: C.float) -> Quaternion

    // Calculate quaternion cubic spline interpolation using Cubic Hermite Spline algorithm
    // as described in the GLTF 2.0 specification: https://registry.khronos.org/glTF/specs/2.0/glTF-2.0.html#interpolation-cubic
    #link "QuaternionCubicHermiteSpline"
    CubicHermiteSpline :: (this: Quaternion, outTangent1: Quaternion, q2: Quaternion, inTangent2: Quaternion, t: C.float) -> Quaternion

    // Calculate quaternion based on the rotation from one vector to another
    QuaternionFromVector3ToVector3 :: (from: Vector3, to: Vector3) -> Quaternion

    // Get a quaternion for a given rotation matrix
    QuaternionFromMatrix :: (mat: Matrix) -> Quaternion

    // Get a matrix for a given quaternion
    #link "QuaternionToMatrix"
    ToMatrix :: (this: Quaternion) -> Matrix

    // Get rotation quaternion for an angle and axis
    // NOTE: Angle must be provided in radians
    QuaternionFromAxisAngle :: (axis: Vector3, angle: C.float) -> Quaternion

    // Get the rotation angle and axis for a given quaternion
    #link "QuaternionToAxisAngle"
    ToAxisAngle :: (this: Quaternion, outAxis: &Vector3, outAngle: &C.float)

    // Get the quaternion equivalent to Euler angles
    // NOTE: Rotation order is ZYX
    QuaternionFromEuler :: (pitch: C.float, yaw: C.float, roll: C.float) -> Quaternion

    // Get the Euler angles equivalent to quaternion (roll, pitch, yaw)
    // NOTE: Angles are returned in a Vector3 struct in radians
    #link "QuaternionToEuler"
    ToEuler :: (this: Quaternion) -> Vector3

    // Transform a quaternion given a transformation matrix
    #link "QuaternionTransform"
    Transform :: (this: Quaternion, mat: Matrix) -> Quaternion

    // Check whether two given quaternions are almost equal
    #link "QuaternionEquals"
    Equals :: (this: Quaternion, q: Quaternion) -> C.int

    // Compose a transformation matrix from rotational, translational and scaling components
    // TODO: This function is not following raymath conventions defined in header: NOT self-contained
    MatrixCompose :: (translation: Vector3, rotation: Quaternion, scale: Vector3) -> Matrix

    // Decompose a transformation matrix into its rotational, translational and scaling components and remove shear
    // TODO: This function is not following raymath conventions defined in header: NOT self-contained
    #link "MatrixDecompose"
    Decompose :: (this: Matrix, translation: &Vector3, rotation: &Quaternion, scale: &Vector3)
}
