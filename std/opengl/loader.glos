Loader_Proc :: (procname: &C.char) -> rawptr

load :: (major: s64, minor: s64, loader: Loader_Proc) {
    n := major * 10 + minor
    if n >= 10 then load_10(loader)
    if n >= 11 then load_11(loader)
    if n >= 12 then load_12(loader)
    if n >= 13 then load_13(loader)
    if n >= 14 then load_14(loader)
    if n >= 15 then load_15(loader)
    if n >= 20 then load_20(loader)
    if n >= 21 then load_21(loader)
    if n >= 30 then load_30(loader)
    if n >= 31 then load_31(loader)
    if n >= 32 then load_32(loader)
    if n >= 33 then load_33(loader)
    if n >= 40 then load_40(loader)
    if n >= 41 then load_41(loader)
    if n >= 42 then load_42(loader)
    if n >= 43 then load_43(loader)
    if n >= 44 then load_44(loader)
    if n >= 45 then load_45(loader)
    if n >= 46 then load_46(loader)
}

