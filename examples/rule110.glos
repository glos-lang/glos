main :: () {
    b: [30]s32

    b[b.count - 2] = 1
    for range b.count - 2 {
        for _, c := range b {
            if bool(c) {
                print('*')
            } else {
                print(' ')
            }
        }
        print('\n')

        pattern := (b[0] << 1) | b[1]
        for j := range 1..b.count - 1 {
            pattern = ((pattern << 1) & 7) | b[j + 1]
            b[j] = (110 >> pattern) & 1
        }
    }
}
