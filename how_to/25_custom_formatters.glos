io :: #import "io"

main :: () {
    // Define the hook method 'format' to register your custom formatter.
    //
    //     #hook
    //     format :: (this: &Your_Type, w: Writer, nested: bool) -> s64, error {}
    //
    {
        Vec2 :: struct {
            x, y: s32
        }

        #hook
        format :: (this: &Vec2, w: io.Writer, nested: bool) -> s64, error {
            return wprint(w, "Vec2(\{this.x}, \{this.y})")
        }

        println(Vec2 {69, 420})

        // As you can see, this custom formatter was used by the printing function.
    }

    // If you want to create a method named 'format' without making it a formatter, then don't
    // use the '#hook' directive.
    {
        Vec3 :: struct {
            x, y, z: s32
        }

        format :: (this: &Vec3, w: io.Writer, nested: bool) -> s64, error {
            return wprint(w, "Vec3(\{this.x}, \{this.y}, \{this.z})")
        }

        println(Vec3 {69, 420, 1337})

        // As you can see, the default formatter was used by the printing function.
    }
}
